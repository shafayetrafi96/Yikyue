/* Convert file to array of base64 data-URLs (one per page for PDFs) */
async function txFileToImages(file) {
  if (file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf')) {
    if (!window.pdfjsLib) throw new Error('PDF.js not loaded — please reload the page.');
    var arrayBuf = await file.arrayBuffer();
    var pdf = await pdfjsLib.getDocument({ data: arrayBuf }).promise;
    var images = [];
    for (var i = 1; i <= pdf.numPages; i++) {
      txSetProg(10 + Math.round((i / pdf.numPages) * 30), 'Rendering PDF page ' + i + ' of ' + pdf.numPages + '…');
      var page = await pdf.getPage(i);
      var vp = page.getViewport({ scale: 2.0 });
      var canvas = document.createElement('canvas');
      canvas.width = vp.width; canvas.height = vp.height;
      await page.render({ canvasContext: canvas.getContext('2d'), viewport: vp }).promise;
      images.push(canvas.toDataURL('image/jpeg', 0.92));
    }
    return images;
  } else {
    return await new Promise(function(res, rej) {
      var r = new FileReader();
      r.onload = function() { res([r.result]); };
      r.onerror = rej;
      r.readAsDataURL(file);
    });
  }
}

/* Build prompt based on mode */
function txPrompt() {
  if (TX.mode === 'receipt') {
    return 'You are reading a receipt or invoice image. Extract ONLY the purchased item names and their quantities. Output a single line of comma-separated entries in EXACTLY this format: Item Name Xp, Item Name Xp (where X is the numeric quantity and p is the literal letter p for pieces). Example: Bashundhara Toilet Tissue White (4pcs Saving Pack) 2p, Ispahani Mirzapore Tea Bag 100gm 3p. Include nothing else — no prices, no totals, no headers, no blank lines. Just the comma-separated item list.';
  }
  return 'Extract all text from this document exactly as it appears. Preserve all original formatting: tables (use plain text columns aligned with spaces), headers, bold labels, line breaks, indentation, numbers, and structure. Do not summarise, translate, or reformat anything. Output the raw text faithfully.';
}

async function _txCallOneKey(apiKey, imageUrl, prompt) {
  var resp = await fetch('https://openrouter.ai/api/v1/chat/completions', {
    method: 'POST',
    headers: {
      'Authorization': 'Bearer ' + apiKey,
      'Content-Type': 'application/json',
      'HTTP-Referer': window.location.href,
      'X-Title': 'YIK YUE Text Extractor'
    },
    body: JSON.stringify({
      model: 'google/gemini-2.5-flash',
      max_tokens: 8192,
      messages: [{ role: 'user', content: [
        { type: 'image_url', image_url: { url: imageUrl } },
        { type: 'text', text: prompt }
      ]}]
    })
  });
  if (!resp.ok) {
    var errBody = await resp.text();
    throw new Error('API error ' + resp.status + ': ' + errBody.slice(0, 200));
  }
  var json = await resp.json();
  return (json.choices && json.choices[0] && json.choices[0].message && json.choices[0].message.content) || '';
}

async function txProcess() {
  if (!TX.file) return;
  var keys = _txGetKeys();
  if (!keys.length) {
    txShowErr('No API key set — click \u201cAPI Keys\u201d in the header to add your OpenRouter key.');
    return;
  }

  var btn = document.getElementById('tx-process-btn');
  btn.disabled = true; btn.style.opacity = '.6';
  document.getElementById('tx-prog').style.display = 'block';
  document.getElementById('tx-err').style.display = 'none';
  document.getElementById('tx-output-wrap').style.display = 'none';

  try {
    txSetProg(5, 'Reading file…');
    await new Promise(function(r) { setTimeout(r, 20); });

    var images = await txFileToImages(TX.file);
    txSetProg(45, 'Sending to AI…');
    await new Promise(function(r) { setTimeout(r, 20); });

    var allText = [];
    for (var p = 0; p < images.length; p++) {
      if (images.length > 1) txSetProg(45 + Math.round((p / images.length) * 45), 'Processing page ' + (p + 1) + ' of ' + images.length + '…');
      var pageText = '';
      var lastErr = null;
      for (var ki = 0; ki < keys.length; ki++) {
        try {
          pageText = await _txCallOneKey(keys[ki], images[p], txPrompt());
          lastErr = null;
          break;
        } catch(e) {
          lastErr = e;
        }
      }
      if (lastErr) throw lastErr;
      allText.push(pageText.trim());
    }

    txSetProg(100, 'Done!');
    setTimeout(function() { document.getElementById('tx-prog').style.display = 'none'; }, 1000);

    var finalText = TX.mode === 'receipt'
      ? allText.join(', ').replace(/,\s*,/g, ',').trim()
      : allText.join('\n\n--- Page Break ---\n\n').trim();

    document.getElementById('tx-output').textContent = finalText;
    document.getElementById('tx-output-wrap').style.display = 'block';

  } catch (err) {
    txShowErr(err.message || 'Unknown error');
    document.getElementById('tx-prog').style.display = 'none';
  }

  btn.disabled = false; btn.style.opacity = '1';
}

function txShowErr(msg) {
  var el = document.getElementById('tx-err');
  el.textContent = '⚠ ' + msg;
  el.style.display = 'block';
}

function txCopyOutput(btn) {
  var text = document.getElementById('tx-output').textContent;
  function onSuccess() {
    btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
    btn.style.background = '#dcfce7';
    btn.style.color = '#16a34a';
    btn.style.borderColor = '#86efac';
    setTimeout(function() {
      btn.innerHTML = '<i class="fas fa-copy"></i> Copy';
      btn.style.background = '#eff6ff';
      btn.style.color = '#2563eb';
      btn.style.borderColor = '#93c5fd';
    }, 2000);
  }
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text).then(onSuccess).catch(fallback);
  } else {
    fallback();
  }
  function fallback() {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.cssText = 'position:fixed;top:-9999px;left:-9999px;opacity:0;';
    document.body.appendChild(ta);
    ta.focus(); ta.select();
    try { document.execCommand('copy'); onSuccess(); } catch(e) {}
    document.body.removeChild(ta);
  }
}

