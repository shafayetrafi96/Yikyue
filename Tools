/* ── Image compression ──────────────────────────────────── */
function compressImage(file){
  var quality={high:0.85, medium:0.65, low:0.30}[compQSel];
  var scale  ={high:1.00, medium:0.90, low:0.70}[compQSel];
  var toGray =compQSel==='low';
  return new Promise(function(resolve,reject){
    var img=new Image(),url=URL.createObjectURL(file);
    img.onload=function(){
      var c=document.createElement('canvas');
      c.width =Math.round(img.naturalWidth *scale);
      c.height=Math.round(img.naturalHeight*scale);
      var ctx=c.getContext('2d');
      ctx.drawImage(img,0,0,c.width,c.height);
      if(toGray){
        var id=ctx.getImageData(0,0,c.width,c.height);var d=id.data;
        for(var j=0;j<d.length;j+=4){var g=(d[j]*0.299+d[j+1]*0.587+d[j+2]*0.114)|0;d[j]=d[j+1]=d[j+2]=g;}
        ctx.putImageData(id,0,0);
      }
      URL.revokeObjectURL(url);
      c.toBlob(function(blob){resolve(blob);},'image/jpeg',quality);
    };
    img.onerror=function(){URL.revokeObjectURL(url);reject(new Error('image load failed'));};
    img.src=url;
  });
}

/* Re-compress one embedded image inside an Office ZIP */
function recompressEmbedImg(bytes,origMime,quality,scale,toGray){
  return new Promise(function(resolve,reject){
    var b=new Blob([bytes],{type:origMime});var url=URL.createObjectURL(b);var img=new Image();
    img.onload=function(){
      var c=document.createElement('canvas');
      c.width =Math.round(img.naturalWidth *scale);
      c.height=Math.round(img.naturalHeight*scale);
      var ctx=c.getContext('2d');ctx.drawImage(img,0,0,c.width,c.height);
      if(toGray){
        var id=ctx.getImageData(0,0,c.width,c.height);var d=id.data;
        for(var j=0;j<d.length;j+=4){var g=(d[j]*0.299+d[j+1]*0.587+d[j+2]*0.114)|0;d[j]=d[j+1]=d[j+2]=g;}
        ctx.putImageData(id,0,0);
      }
      URL.revokeObjectURL(url);
      c.toBlob(function(out){
        if(!out){reject(new Error('toBlob null'));return;}
        out.arrayBuffer().then(function(ab){resolve(new Uint8Array(ab));}).catch(reject);
      },'image/jpeg',quality);
    };
    img.onerror=function(){URL.revokeObjectURL(url);reject(new Error('img load'));};
    img.src=url;
  });
}

/* ── Office compression (DOCX / XLSX / PPTX) ────────────── */
async function compressOffice(file){
  var level   ={high:7,   medium:9,   low:9   }[compQSel];
  var imgQ    ={high:0.82, medium:0.55, low:0.28}[compQSel];
  var imgScale={high:0.95, medium:0.78, low:0.55}[compQSel];
  var toGray  =compQSel==='low';
  var STRIP=/^(docProps\/thumbnail\.(jpeg|jpg|png|emf|wmf)|docProps\/app\.xml)$/i;

  var data=await file.arrayBuffer();
  var zip=await JSZip.loadAsync(data);
  var out=new JSZip();

  var names=Object.keys(zip.files);
  for(var ni=0;ni<names.length;ni++){
    var name=names[ni];var entry=zip.files[name];
    if(entry.dir){out.folder(name);continue;}
    if(STRIP.test(name))continue;

    var content=await entry.async('uint8array');
    var isJpeg=/\.(jpg|jpeg)$/i.test(name);
    var isPng=/\.png$/i.test(name);
    var isEmbedImg=(isJpeg||isPng)&&/\/media\//i.test(name);

    if(isEmbedImg){
      try{
        var origMime=isJpeg?'image/jpeg':'image/png';
        var recomp=await recompressEmbedImg(content,origMime,imgQ,imgScale,toGray);
        content=recomp.length<content.length?recomp:content;
      }catch(e){}
      out.file(name,content,{compression:'STORE'});
    } else if(/\.(gif|webp|mp3|mp4|wav|ogg|bin|wmf|emf)$/i.test(name)){
      out.file(name,content,{compression:'STORE'});
    } else {
      out.file(name,content,{compression:'DEFLATE',compressionOptions:{level:level}});
    }
  }

  var blob=await out.generateAsync({type:'blob',compression:'DEFLATE',compressionOptions:{level:level}});
  return new Blob([await blob.arrayBuffer()],{type:file.type||'application/octet-stream'});
}

/* ── PDF compression ───────────────────────────────────────
   High   = "Less compression"    — 2.0× DPI, JPEG 0.88
   Medium = "Recommended"         — 1.5× DPI, JPEG 0.65
   Low    = "Extreme compression" — 0.9× DPI, JPEG 0.30 + grayscale */
async function compressPDF(file){
  var imgQ       ={high:0.88, medium:0.65, low:0.30}[compQSel];
  var renderScale={high:2.0,  medium:1.5,  low:0.90}[compQSel];
  var toGray     =compQSel==='low';

  var data=new Uint8Array(await file.arrayBuffer());
  var pdfSrc=await pdfjsLib.getDocument({data:data}).promise;
  var jsPDF=window.jspdf.jsPDF;
  var doc=null;

  for(var p=1;p<=pdfSrc.numPages;p++){
    var page=await pdfSrc.getPage(p);
    var vp=page.getViewport({scale:renderScale});
    var canvas=document.createElement('canvas');
    canvas.width =Math.round(vp.width);
    canvas.height=Math.round(vp.height);
    var ctx=canvas.getContext('2d');
    await page.render({canvasContext:ctx,viewport:vp}).promise;

    if(toGray){
      var id=ctx.getImageData(0,0,canvas.width,canvas.height);var d=id.data;
      for(var j=0;j<d.length;j+=4){var g=(d[j]*0.299+d[j+1]*0.587+d[j+2]*0.114)|0;d[j]=d[j+1]=d[j+2]=g;}
      ctx.putImageData(id,0,0);
    }

    var imgData=canvas.toDataURL('image/jpeg',imgQ);
    var wPt=canvas.width *72/96;
    var hPt=canvas.height*72/96;

    if(p===1){
      doc=new jsPDF({orientation:wPt>=hPt?'landscape':'portrait',unit:'pt',format:[wPt,hPt]});
    } else {
      doc.addPage([wPt,hPt],wPt>=hPt?'landscape':'portrait');
    }
    doc.addImage(imgData,'JPEG',0,0,wPt,hPt,undefined,'FAST');
  }
  if(!doc)return new Blob([data],{type:'application/pdf'});
  return doc.output('blob');
}

/* ── ZIP compression ───────────────────────────────────────
   Re-packs all entries with maximum DEFLATE.
   Embedded images are re-compressed at quality-appropriate JPEG.
   Already-compressed entries (mp3, mp4, inner-zip, etc.) are stored as-is. */
async function compressZip(file){
  var level   ={high:7, medium:9, low:9}[compQSel];
  var imgQ    ={high:0.82, medium:0.65, low:0.35}[compQSel];
  var imgScale={high:0.95, medium:0.85, low:0.65}[compQSel];
  var toGray  =compQSel==='low';

  var data=await file.arrayBuffer();
  var zip=await JSZip.loadAsync(data);
  var out=new JSZip();

  var names=Object.keys(zip.files);
  for(var ni=0;ni<names.length;ni++){
    var name=names[ni];var entry=zip.files[name];
    if(entry.dir){out.folder(name);continue;}

    var content=await entry.async('uint8array');
    var isImg=/\.(jpg|jpeg|png|webp|bmp)$/i.test(name);
    var isAlreadyCompressed=/\.(mp3|mp4|mov|avi|mkv|ogg|flac|wav|zip|gz|7z|rar|br|xz|lz4|zst)$/i.test(name);

    if(isImg){
      try{
        var origMime=/\.png$/i.test(name)?'image/png':/\.webp$/i.test(name)?'image/webp':'image/jpeg';
        var recomp=await recompressEmbedImg(content,origMime,imgQ,imgScale,toGray);
        content=recomp.length<content.length?recomp:content;
      }catch(e){}
      out.file(name,content,{compression:'STORE'});
    } else if(isAlreadyCompressed){
      out.file(name,content,{compression:'STORE'});
    } else {
      out.file(name,content,{compression:'DEFLATE',compressionOptions:{level:level}});
    }
  }

  var blob=await out.generateAsync({type:'blob',compression:'DEFLATE',compressionOptions:{level:level}});
  return new Blob([await blob.arrayBuffer()],{type:'application/zip'});
}

async function compDownloadAllZip(entries){
  var zip=new JSZip();
  var seen={};
  entries.forEach(function(e){
    var origName=e.name;
    var name=origName;
    if(seen[origName]===undefined){seen[origName]=0;}
    else{seen[origName]++;var dot=name.lastIndexOf('.');name=dot>-1?name.slice(0,dot)+'_('+seen[origName]+')'+name.slice(dot):name+'_('+seen[origName]+')';}
    zip.file(name,e.blob);
  });
  var blob=await zip.generateAsync({type:'blob',compression:'DEFLATE',compressionOptions:{level:6}});
  var url=URL.createObjectURL(blob);var a=document.createElement('a');a.href=url;a.download='compressed_files.zip';a.click();
  setTimeout(function(){URL.revokeObjectURL(url);},5000);
}

function _compSetProgress(done,total,filename){
  var pct=total>0?Math.round((done/total)*100):0;
  document.getElementById('comp-prog-bar').style.width=pct+'%';
  document.getElementById('comp-prog-pct').textContent=pct+'%';
  document.getElementById('comp-prog-label').innerHTML=
    '<i class="fas fa-spinner spin"></i> Processing file '+(done+1)+' of '+total+'…';
