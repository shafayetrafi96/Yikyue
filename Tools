var _compOut=[];
async function compProcess(){
  if(!compQueue.length)return;
  var btn=document.getElementById('comp-process-btn');
  var progWrap=document.getElementById('comp-progress-bar-wrap');

  btn.disabled=true;
  btn.style.background='#9ca3af';
  btn.innerHTML='<i class="fas fa-spinner spin"></i> Processing…';
  progWrap.style.display='block';
  document.getElementById('comp-prog-bar').style.width='0%';
  document.getElementById('comp-prog-pct').textContent='0%';
  document.getElementById('comp-results').style.display='none';

  _compOut=[];var origTotal=0,newTotal=0;
  var total=compQueue.length;

  for(var i=0;i<total;i++){
    var f=compQueue[i];
    _compSetProgress(i,total,f.name);
    var isPDF   =/\.pdf$/i.test(f.name);
    var isImg   =/\.(jpg|jpeg|png|webp)$/i.test(f.name)||f.type.startsWith('image/');
    var isOffice=/\.(docx|xlsx|pptx)$/i.test(f.name);
    var isZip   =/\.zip$/i.test(f.name);
    try{
      var blob;
      if(isImg)blob=await compressImage(f);
      else if(isPDF)blob=await compressPDF(f);
      else if(isOffice)blob=await compressOffice(f);
      else if(isZip)blob=await compressZip(f);
      else blob=null;
      if(!blob)throw new Error('Unsupported format');
      origTotal+=f.size;newTotal+=blob.size;
      _compOut.push({name:f.name,blob:blob,origSize:f.size,newSize:blob.size});
      blobToVault(f.name,blob);
    }catch(e){
      _compOut.push({name:f.name,blob:null,origSize:f.size,newSize:0,err:e.message||'error'});
    }
  }

  document.getElementById('comp-prog-bar').style.width='100%';
  document.getElementById('comp-prog-pct').textContent='100%';
  document.getElementById('comp-prog-label').innerHTML='<i class="fas fa-check-circle"></i> Done!';
  document.getElementById('comp-prog-file').textContent='';
  setTimeout(function(){progWrap.style.display='none';},1800);

  btn.disabled=false;
  btn.style.background='#d97706';
  btn.innerHTML='<i class="fas fa-compress-alt"></i> Process Files';

  var ok=_compOut.filter(function(o){return o.blob;});
  var savings=origTotal>0?((1-newTotal/origTotal)*100).toFixed(1):0;

  var resultsDiv=document.getElementById('comp-results');
  resultsDiv.style.display='block';
  document.getElementById('comp-results-title').textContent='✅ Compressed Files ('+ok.length+' / '+_compOut.length+')';
  document.getElementById('comp-savings-badge').textContent=savings+'% reduction · '+fmtBytes(origTotal)+' → '+fmtBytes(newTotal);

  var list=document.getElementById('comp-results-list');list.innerHTML='';
  _compOut.forEach(function(o){
    var row=document.createElement('div');row.className='result-file';
    var sizeTag='';
    if(o.origSize){
      var pct=o.newSize<o.origSize?' <span style="color:#16a34a;font-weight:700;">(-'+((1-o.newSize/o.origSize)*100).toFixed(0)+'%)</span>':'';
      sizeTag='<span style="font-size:.74rem;color:#6b7280;white-space:nowrap;">'+fmtBytes(o.origSize)+' → '+fmtBytes(o.newSize)+pct+'</span>';
    }
    if(o.blob){
      var dlUrl=URL.createObjectURL(o.blob);
      row.innerHTML=
        '<span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;color:#166534;">'+o.name+'</span>'+
        sizeTag+
        '<a href="'+dlUrl+'" download="'+o.name+'" style="padding:.28rem .75rem;background:#16a34a;color:#fff;border-radius:.3rem;font-size:.78rem;font-weight:600;text-decoration:none;white-space:nowrap;flex-shrink:0;">⬇ Download</a>';
    } else {
      row.innerHTML=
        '<span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;color:#374151;">'+o.name+'</span>'+
        '<span style="color:#dc2626;font-size:.8rem;">'+(o.err||'Error')+'</span>';
    }
    list.appendChild(row);
  });

  if(ok.length>1){
    var zipBtn=document.createElement('button');zipBtn.className='btn-primary';
    zipBtn.style.cssText='margin-top:.85rem;padding:.5rem 1.3rem;font-size:.9rem;font-weight:700;';
    zipBtn.innerHTML='<i class="fas fa-file-archive"></i> Download All as ZIP';
    zipBtn.onclick=async function(){
      zipBtn.disabled=true;zipBtn.innerHTML='<i class="fas fa-spinner spin"></i> Building ZIP…';
      await compDownloadAllZip(ok);
      zipBtn.disabled=false;zipBtn.innerHTML='<i class="fas fa-file-archive"></i> Download All as ZIP';
    };
    list.appendChild(zipBtn);
  }
}

/* ═══════════════════════ OBJECT ERASER ═══════════════════════
   Paint a red mask over any object, then content-aware fill removes it.
   Uses two overlaid canvases: oe-base (image) + oe-mask (red overlay).
   A hidden full-resolution mask tracks painted pixels for inpainting.
═══════════════════════════════════════════════════════════════════════ */
var OE = {
  imgW: 0, imgH: 0,          // original image dimensions
  hasMask: false,
  painting: false,
  tool: 'brush',
  lastX: 0, lastY: 0,
  resultBlob: null,
  // offscreen full-res mask (1-channel, painted=255 unpainted=0)
  maskOffscreen: null,
  maskOffCtx: null,
  // pan state (hand tool)
  panX: 0, panY: 0,
  panStartX: 0, panStartY: 0,
  panOriginX: 0, panOriginY: 0,
  panning: false,
  // undo / redo stacks (each entry: {mask: ImageData, off: ImageData})
  undoStack: [],
  redoStack: []
};

function oeInit() {
  var maskC = document.getElementById('oe-mask');
  // Use Pointer Events so mouse, touch, and stylus all work via one path.
  // setPointerCapture keeps events on the canvas even when the pointer
  // moves outside its bounds mid-stroke (no lost strokes).
  maskC.addEventListener('pointerdown', function(e) {
    e.preventDefault();
    maskC.setPointerCapture(e.pointerId);
    oePointerDown(e);
  });
  maskC.addEventListener('pointermove', function(e) {
    e.preventDefault();
    oePointerMove(e);
  });
  maskC.addEventListener('pointerup',     function(e) { oePointerUp(); });
  maskC.addEventListener('pointercancel', function(e) { oePointerUp(); });
  maskC.addEventListener('pointerleave',  function(e) {
    document.getElementById('oe-cursor').style.display = 'none';
  });
}
window.addEventListener('load', oeInit);

function oeDrop(e){
  e.preventDefault();
  document.getElementById('oe-drop').classList.remove('oe-drag');
  var f = e.dataTransfer.files[0];
  if(f && f.type.startsWith('image/')) oeLoadFile(f);
}

function oeLoadFile(file) {
  if(!file) return;
  var url = URL.createObjectURL(file);
  var img = new Image();
  img.onload = function() {
    OE.imgW = img.naturalWidth;
    OE.imgH = img.naturalHeight;
    OE.zoom = 1.0;

    // ── Set canvas PIXEL dimensions = full image resolution ──
    var baseC = document.getElementById('oe-base');
    baseC.width  = OE.imgW;
    baseC.height = OE.imgH;
    baseC.getContext('2d').drawImage(img, 0, 0);

    var maskC = document.getElementById('oe-mask');
    maskC.width  = OE.imgW;
    maskC.height = OE.imgH;
    maskC.getContext('2d').clearRect(0, 0, OE.imgW, OE.imgH);

    // Offscreen full-res mask
    OE.maskOffscreen = document.createElement('canvas');
    OE.maskOffscreen.width  = OE.imgW;
    OE.maskOffscreen.height = OE.imgH;
    OE.maskOffCtx = OE.maskOffscreen.getContext('2d');

    // ── Fit canvases to display container (maintaining aspect ratio) ──
    oeFitCanvas();

    // Hide placeholder, show inner wrapper + zoom bar + toolbar
    document.getElementById('oe-placeholder').style.display = 'none';
    document.getElementById('oe-canvas-inner').style.display = 'block';
    document.getElementById('oe-zoom-bar').style.display = 'flex';
    document.getElementById('oe-toolbar').style.display = 'flex';
    var tabBtn = document.getElementById('oe-toolbar-action-btn');
    if (tabBtn) { tabBtn.style.display = 'inline-flex'; tabBtn.innerHTML = '<i class="fas fa-eraser"></i> Erase it'; tabBtn.onclick = oeErase; tabBtn.style.background='#ef4444'; tabBtn.style.borderColor='#ef4444'; }
    // Ensure the wrap shrinks to image height (not min-height when image is short)
    document.getElementById('oe-canvas-wrap').style.minHeight = '0';
    document.getElementById('oe-canvas-wrap').style.padding = '16px 16px 16px 54px';

    OE.hasMask = false;
    OE.resultBlob = null;
    OE.panX = 0; OE.panY = 0;
    OE.undoStack = []; OE.redoStack = [];
    oeUpdateUndoRedo();
    document.getElementById('oe-result-card').style.display = 'none';
    document.getElementById('oe-result-thumb').width = 0;
    oeUpdateEraseBtn();

    document.getElementById('oe-card1').classList.remove('oe-active');
    document.getElementById('oe-card2').classList.add('oe-active');
    document.getElementById('oe-file-badge').style.display = 'block';
    document.getElementById('oe-file-name').textContent = file.name;

    URL.revokeObjectURL(url);
  };
  img.src = url;
}

/* Compute fitted display size and apply as CSS width/height to the canvases */
function oeFitCanvas() {
  var wrap  = document.getElementById('oe-canvas-wrap');
  var inner = document.getElementById('oe-canvas-inner');
  // Available space: container minus padding for zoom bar + breathing room
  var availW = Math.max(100, wrap.clientWidth - 70);
  var availH = Math.max(200, Math.min(560, window.innerHeight * 0.65));

  var scale  = Math.min(availW / OE.imgW, availH / OE.imgH, 1);
  OE.dispW   = Math.round(OE.imgW * scale);
  OE.dispH   = Math.round(OE.imgH * scale);

  var baseC = document.getElementById('oe-base');
  var maskC = document.getElementById('oe-mask');
  baseC.style.width  = OE.dispW + 'px';
  baseC.style.height = OE.dispH + 'px';
  maskC.style.width     = OE.dispW + 'px';
  maskC.style.height    = OE.dispH + 'px';
  // Pull mask up in normal flow so it overlaps base exactly.
  // DOM order (mask comes after base) guarantees mask renders on top
  // without any z-index / stacking-context fights.
  maskC.style.marginTop = '-' + OE.dispH + 'px';

  // Apply current zoom level
  inner.style.transform       = 'translate(' + OE.panX + 'px,' + OE.panY + 'px) scale(' + OE.zoom + ')';
  inner.style.transformOrigin = 'center center';
  document.getElementById('oe-zoom-pct').textContent = Math.round(OE.zoom * 100) + '%';
}

function oeZoomIn() {
  OE.zoom = Math.min(4.0, parseFloat((OE.zoom + 0.25).toFixed(2)));
  oeFitCanvas();
}
function oeZoomOut() {
  OE.zoom = Math.max(0.25, parseFloat((OE.zoom - 0.25).toFixed(2)));
  oeFitCanvas();
}
function oeZoomReset() {
  OE.zoom = 1.0;
  oeFitCanvas();
}

function oeSetTool(t) {
  OE.tool = t;
  document.getElementById('oe-btn-brush').classList.toggle('oe-active-tool', t==='brush');
  document.getElementById('oe-btn-restore').classList.toggle('oe-active-tool', t==='restore');
  document.getElementById('oe-btn-hand').classList.toggle('oe-active-hand', t==='hand');
  var wrap = document.getElementById('oe-canvas-wrap');
  wrap.classList.toggle('oe-hand-mode', t==='hand');
  // Hide brush cursor when in hand mode
  if (t === 'hand') document.getElementById('oe-cursor').style.display = 'none';
}

function oeShowCursor(e) {
  var cur = document.getElementById('oe-cursor');
  if (!OE.imgW || OE.tool === 'hand') { cur.style.display = 'none'; return; }
  var sz    = parseInt(document.getElementById('oe-size').value) || 28;
  var maskC = document.getElementById('oe-mask');
  var rect  = maskC.getBoundingClientRect(); // accounts for CSS + transform
  if (!rect.width) { cur.style.display = 'none'; return; }
  var cssR  = sz * (rect.width / OE.imgW);  // brush radius in screen px
  cur.style.display     = 'block';
  cur.style.left        = e.clientX + 'px';
  cur.style.top         = e.clientY + 'px';
  cur.style.width       = (cssR * 2) + 'px';
  cur.style.height      = (cssR * 2) + 'px';
  cur.style.borderColor = OE.tool === 'restore' ? 'rgba(59,130,246,.9)' : 'rgba(239,68,68,.9)';
}

function oeGetPos(e) {
  var maskC = document.getElementById('oe-mask');
  var rect  = maskC.getBoundingClientRect();
  return {
    x: (e.clientX - rect.left) * (OE.imgW / rect.width),
    y: (e.clientY - rect.top)  * (OE.imgH / rect.height)
  };
}

function oeSnapshotMask() {
  var maskC = document.getElementById('oe-mask');
  var mCtx  = maskC.getContext('2d');
  var snapMask = mCtx.getImageData(0, 0, OE.imgW, OE.imgH);
  var snapOff  = OE.maskOffCtx.getImageData(0, 0, OE.imgW, OE.imgH);
  OE.undoStack.push({ mask: snapMask, off: snapOff });
  OE.redoStack = [];
  oeUpdateUndoRedo();
}

function oePointerDown(e) {
  if (!OE.imgW) return;
  if (OE.tool === 'hand') {
    OE.panning = true;
    OE.panStartX = e.clientX;
    OE.panStartY = e.clientY;
    OE.panOriginX = OE.panX;
    OE.panOriginY = OE.panY;
    document.getElementById('oe-canvas-wrap').style.cursor = 'grabbing';
    return;
  }
  oeSnapshotMask();
  OE.painting = true;
  var p = oeGetPos(e);
  OE.lastX = p.x; OE.lastY = p.y;
  oePaintAt(p.x, p.y);
}

function oePointerMove(e) {
  oeShowCursor(e);
  if (OE.tool === 'hand' && OE.panning) {
    OE.panX = OE.panOriginX + (e.clientX - OE.panStartX);
    OE.panY = OE.panOriginY + (e.clientY - OE.panStartY);
    var inner = document.getElementById('oe-canvas-inner');
    inner.style.transform = 'translate(' + OE.panX + 'px,' + OE.panY + 'px) scale(' + OE.zoom + ')';
    return;
  }
  if (!OE.painting) return;
  var p = oeGetPos(e);
  oeStrokeTo(OE.lastX, OE.lastY, p.x, p.y);
  OE.lastX = p.x; OE.lastY = p.y;
}

function oePointerUp() {
  if (OE.panning) {
    OE.panning = false;
    document.getElementById('oe-canvas-wrap').style.cursor = '';
  }
  OE.painting = false;
}

function oePaintAt(x, y) {
  var sz = parseInt(document.getElementById('oe-size').value) || 28;
  var maskC = document.getElementById('oe-mask');
  var mCtx  = maskC.getContext('2d');
  var isRestore = OE.tool === 'restore';

  mCtx.globalCompositeOperation = isRestore ? 'destination-out' : 'source-over';
  mCtx.beginPath();
  mCtx.arc(x, y, sz, 0, Math.PI * 2);
  if (!isRestore) {
    mCtx.fillStyle = 'rgba(239,68,68,0.55)';
  }
  mCtx.fill();
  mCtx.globalCompositeOperation = 'source-over';

  // Also paint offscreen hard mask (full opacity)
  OE.maskOffCtx.globalCompositeOperation = isRestore ? 'destination-out' : 'source-over';
  OE.maskOffCtx.beginPath();
  OE.maskOffCtx.arc(x, y, sz, 0, Math.PI * 2);
  OE.maskOffCtx.fillStyle = 'rgb(255,255,255)';
  OE.maskOffCtx.fill();
  OE.maskOffCtx.globalCompositeOperation = 'source-over';

  if (!isRestore) { OE.hasMask = true; oeUpdateEraseBtn(); }
}

function oeStrokeTo(x1, y1, x2, y2) {
  var sz = parseInt(document.getElementById('oe-size').value) || 28;
  var maskC = document.getElementById('oe-mask');
  var mCtx  = maskC.getContext('2d');
  var isRestore = OE.tool === 'restore';

  mCtx.globalCompositeOperation = isRestore ? 'destination-out' : 'source-over';
  mCtx.beginPath();
  mCtx.moveTo(x1, y1);
  mCtx.lineTo(x2, y2);
  mCtx.lineWidth = sz * 2;
  mCtx.lineCap = 'round';
  mCtx.lineJoin = 'round';
  if (!isRestore) mCtx.strokeStyle = 'rgba(239,68,68,0.55)';
  mCtx.stroke();
  mCtx.globalCompositeOperation = 'source-over';

  OE.maskOffCtx.globalCompositeOperation = isRestore ? 'destination-out' : 'source-over';
  OE.maskOffCtx.beginPath();
  OE.maskOffCtx.moveTo(x1, y1);
  OE.maskOffCtx.lineTo(x2, y2);
  OE.maskOffCtx.lineWidth = sz * 2;
  OE.maskOffCtx.lineCap = 'round';
  OE.maskOffCtx.lineJoin = 'round';
  OE.maskOffCtx.strokeStyle = 'rgb(255,255,255)';
  OE.maskOffCtx.stroke();
  OE.maskOffCtx.globalCompositeOperation = 'source-over';

  if (!isRestore) { OE.hasMask = true; oeUpdateEraseBtn(); }
}

function oeResetMask() {
  if (!OE.imgW) return;
  var maskC = document.getElementById('oe-mask');
  maskC.getContext('2d').clearRect(0, 0, OE.imgW, OE.imgH);
  OE.maskOffCtx.clearRect(0, 0, OE.imgW, OE.imgH);
  OE.hasMask = false;
  OE.undoStack = []; OE.redoStack = [];
  oeUpdateUndoRedo();
  oeUpdateEraseBtn();
}

function oeUpdateUndoRedo() {
  var undoBtn = document.getElementById('oe-btn-undo');
  var redoBtn = document.getElementById('oe-btn-redo');
  if (undoBtn) undoBtn.disabled = OE.undoStack.length === 0;
  if (redoBtn) redoBtn.disabled = OE.redoStack.length === 0;
}

function oeUndo() {
  if (!OE.undoStack.length) return;
  var maskC = document.getElementById('oe-mask');
  var mCtx  = maskC.getContext('2d');
  // Save current state to redo
  OE.redoStack.push({
    mask: mCtx.getImageData(0, 0, OE.imgW, OE.imgH),
    off:  OE.maskOffCtx.getImageData(0, 0, OE.imgW, OE.imgH)
  });
  var snap = OE.undoStack.pop();
  mCtx.putImageData(snap.mask, 0, 0);
  OE.maskOffCtx.putImageData(snap.off, 0, 0);
  // Re-evaluate hasMask from offscreen canvas
  var d = snap.off.data;
  OE.hasMask = false;
  for (var i = 3; i < d.length; i += 4) { if (d[i] > 30) { OE.hasMask = true; break; } }
  oeUpdateUndoRedo();
  oeUpdateEraseBtn();
}

function oeRedo() {
  if (!OE.redoStack.length) return;
  var maskC = document.getElementById('oe-mask');
  var mCtx  = maskC.getContext('2d');
  // Save current state to undo
  OE.undoStack.push({
    mask: mCtx.getImageData(0, 0, OE.imgW, OE.imgH),
    off:  OE.maskOffCtx.getImageData(0, 0, OE.imgW, OE.imgH)
  });
  var snap = OE.redoStack.pop();
  mCtx.putImageData(snap.mask, 0, 0);
  OE.maskOffCtx.putImageData(snap.off, 0, 0);
  var d = snap.off.data;
  OE.hasMask = false;
  for (var i = 3; i < d.length; i += 4) { if (d[i] > 30) { OE.hasMask = true; break; } }
  oeUpdateUndoRedo();
  oeUpdateEraseBtn();
}

function oeUpdateEraseBtn() {
  var btn = document.getElementById('oe-erase-btn');
  var hint = document.getElementById('oe-erase-hint');
  if (OE.hasMask) {
    btn.disabled = false;
    hint.textContent = 'Click to remove the painted object';
    document.getElementById('oe-card2').classList.remove('oe-active');
