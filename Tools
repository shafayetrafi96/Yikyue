/* ── Server modal (Firebase config) ── */
function openServerModal(){
  var hasPrev = !!sessionStorage.getItem('prevServerConfig_yyk_tools');
  var prevInfoEl = document.getElementById('srvPrevInfo');
  var restoreBtn = document.getElementById('srvRestoreBtn');
  if(prevInfoEl) prevInfoEl.classList.toggle('hidden', !hasPrev);
  if(restoreBtn) restoreBtn.disabled = !hasPrev;
  document.getElementById('srvConfigJson').value = DEFAULT_SERVER_CONFIG ? 'const firebaseConfig = ' + JSON.stringify(DEFAULT_SERVER_CONFIG, null, 2) + ';' : '';
  document.getElementById('serverModal').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}
function closeServerModal(){
  document.getElementById('serverModal').classList.add('hidden');
  document.body.style.overflow = '';
}
function parseServerConfigInput(raw){
  var s = raw.trim()
    .replace(/^\s*(?:const|var|let)\s+\w+\s*=\s*/, '')
    .replace(/;\s*$/, '')
    .trim();
  s = s.replace(/([{,]\s*)([a-zA-Z_$][a-zA-Z0-9_$]*)\s*:/g, '$1"$2":');
  return JSON.parse(s);
}
function saveServerConfig(){
  var raw = document.getElementById('srvConfigJson').value.trim();
  var cfg = null;
  if(raw){
    try { cfg = parseServerConfigInput(raw); }
    catch(e){ alert('Invalid config — please check the format.\n\nYou can paste either:\n  • Plain JSON: { "apiKey": "...", ... }\n  • Or the full JS snippet: const firebaseConfig = { ... };'); return; }
    if(typeof cfg!=='object'||Array.isArray(cfg)){ alert('Config must be a Firebase config object.'); return; }
    if(!cfg.apiKey||!cfg.databaseURL){ alert('Config must include at least apiKey and databaseURL.'); return; }
  }
  /* Save previous to sessionStorage for restore (same as Product Register) */
  if(DEFAULT_SERVER_CONFIG) sessionStorage.setItem('prevServerConfig_yyk_tools', JSON.stringify(DEFAULT_SERVER_CONFIG));
  /* Also update localStorage for non-iframe contexts */
  try {
    if(cfg) localStorage.setItem('serverConfig_yyk_tools', JSON.stringify(cfg));
    else localStorage.removeItem('serverConfig_yyk_tools');
  } catch(e){}
  closeServerModal();
  /* POST to Replit server — persists across all reloads including Google Sites iframes */
  fetch('/api/app-config/tools-firebase-config', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({config: cfg || null})
  }).finally(function(){ window.location.reload(); });
}
function restoreServerConfig(){
  var prev = sessionStorage.getItem('prevServerConfig_yyk_tools');
  if(!prev){ alert('No previous config to restore.'); return; }
  var prevCfg;
  try { prevCfg = JSON.parse(prev); } catch(e){ alert('Previous config is corrupted.'); return; }
  try { localStorage.setItem('serverConfig_yyk_tools', prev); } catch(e){}
  closeServerModal();
  fetch('/api/app-config/tools-firebase-config', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({config: prevCfg})
  }).finally(function(){
    sessionStorage.removeItem('prevServerConfig_yyk_tools');
    window.location.reload();
  });
}

