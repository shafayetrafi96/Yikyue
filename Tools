}

/* Browser-based inpainting: returns a blob URL of the result image.
   imageB64 = JPEG data-URL of source image
   maskB64  = PNG data-URL where white = area to erase, black = keep
   onProgress(pct, msg) called during processing */
async function hfInpaint(imageB64, maskB64, onProgress) {

  /* 1 — Load image and mask onto canvases */
  function loadImage(src) {
    return new Promise(function(res, rej) {
      var img = new Image();
      img.onload = function() { res(img); };
      img.onerror = rej;
      img.src = src;
    });
  }

  onProgress(15, 'Loading image data…');
  await new Promise(function(r){ setTimeout(r, 20); });

  var srcImg  = await loadImage(imageB64);
  var maskImg = await loadImage(maskB64);

  var w = srcImg.naturalWidth;
  var h = srcImg.naturalHeight;

  /* Source pixel data */
  var srcC = document.createElement('canvas');
  srcC.width = w; srcC.height = h;
  var srcCtx = srcC.getContext('2d');
  srcCtx.drawImage(srcImg, 0, 0);
  var imgData = srcCtx.getImageData(0, 0, w, h);
  var pix = imgData.data; /* RGBA flat array */

  /* Mask data (white = needs fill) */
  var mskC = document.createElement('canvas');
  mskC.width = w; mskC.height = h;
  mskC.getContext('2d').drawImage(maskImg, 0, 0);
  var mskData = mskC.getContext('2d').getImageData(0, 0, w, h);

  /* Boolean mask: true = needs to be filled */
  var needsFill = new Uint8Array(w * h);
  for (var i = 0; i < w * h; i++) {
    needsFill[i] = mskData.data[i * 4] > 128 ? 1 : 0;
  }

  onProgress(20, 'Analysing region…');
  await new Promise(function(r){ setTimeout(r, 20); });

  /* 2 — Iterative diffusion fill
     Each pass: for every masked pixel, average its already-filled (or original)
     neighbours. Pixels filled this pass are no longer masked.
     Repeat until no masked pixels remain. Converges in 80–150 passes. */
  var MAX_PASSES = 150;
  var totalMasked = 0;
  for (var k = 0; k < w * h; k++) if (needsFill[k]) totalMasked++;

  var remaining = totalMasked;
  var dx = [-1,1,0,0,-1,-1,1,1];
  var dy = [0,0,-1,1,-1,1,-1,1];

  for (var pass = 0; pass < MAX_PASSES && remaining > 0; pass++) {
    var filledThisPass = 0;
    /* Alternate scan direction each pass for more even propagation */
    var forward = (pass % 2 === 0);

    for (var pi = 0; pi < w * h; pi++) {
      var idx = forward ? pi : (w * h - 1 - pi);
      if (!needsFill[idx]) continue;

      var px = idx % w;
      var py = (idx / w) | 0;
      var rSum = 0, gSum = 0, bSum = 0, wSum = 0;

      for (var d = 0; d < 8; d++) {
        var nx = px + dx[d];
        var ny = py + dy[d];
        if (nx < 0 || nx >= w || ny < 0 || ny >= h) continue;
        var nIdx = ny * w + nx;
        if (needsFill[nIdx]) continue; /* neighbour not yet filled */
        /* cardinal neighbours get double weight */
        var w8 = (d < 4) ? 2 : 1;
        var np = nIdx * 4;
        rSum += pix[np]   * w8;
        gSum += pix[np+1] * w8;
        bSum += pix[np+2] * w8;
        wSum += w8;
      }

      if (wSum > 0) {
        var op = idx * 4;
        pix[op]   = Math.round(rSum / wSum);
        pix[op+1] = Math.round(gSum / wSum);
        pix[op+2] = Math.round(bSum / wSum);
        pix[op+3] = 255;
        needsFill[idx] = 0;
        filledThisPass++;
      }
    }

    remaining -= filledThisPass;
    if (filledThisPass === 0) break; /* isolated island — stop */

    /* Progress update every 10 passes (yield to keep UI alive) */
    if (pass % 10 === 0) {
      var pct = 20 + Math.round(((totalMasked - remaining) / Math.max(totalMasked, 1)) * 65);
      onProgress(pct, 'Filling region… pass ' + (pass + 1));
      await new Promise(function(r){ setTimeout(r, 0); });
    }
  }

  onProgress(88, 'Rendering result…');
  await new Promise(function(r){ setTimeout(r, 20); });

  /* 3 — Write result and return blob URL */
  srcCtx.putImageData(imgData, 0, 0);
  return new Promise(function(resolve, reject) {
    srcC.toBlob(function(blob) {
      if (!blob) { reject(new Error('Failed to encode result image')); return; }
      resolve(URL.createObjectURL(blob));
    }, 'image/jpeg', 0.92);
  });
}

/* Build a properly-sized image + mask for the API (max 1024px, multiples of 8) */
function oePrepareCanvases() {
  var MAX = 1024;
  var scale = Math.min(MAX / OE.imgW, MAX / OE.imgH, 1);
  var outW  = Math.max(8, Math.round(OE.imgW * scale / 8) * 8);
  var outH  = Math.max(8, Math.round(OE.imgH * scale / 8) * 8);

  /* Image canvas → JPEG base64 */
  var imgC = document.createElement('canvas');
  imgC.width = outW; imgC.height = outH;
  imgC.getContext('2d').drawImage(document.getElementById('oe-base'), 0, 0, outW, outH);
  var imageB64 = imgC.toDataURL('image/jpeg', 0.92);

  /* Mask canvas: white=erase area, black=keep */
  var mskC = document.createElement('canvas');
  mskC.width = outW; mskC.height = outH;
  var mCtx = mskC.getContext('2d');
  mCtx.fillStyle = '#000';
  mCtx.fillRect(0, 0, outW, outH);

  /* Scale the offscreen painted mask, then binarise */
  var scaleTmp = document.createElement('canvas');
  scaleTmp.width = outW; scaleTmp.height = outH;
  scaleTmp.getContext('2d').drawImage(OE.maskOffscreen, 0, 0, outW, outH);
  var mData = scaleTmp.getContext('2d').getImageData(0, 0, outW, outH);
  for (var i = 0; i < mData.data.length; i += 4) {
    var v = mData.data[i + 3] > 30 ? 255 : 0;
    mData.data[i] = mData.data[i+1] = mData.data[i+2] = v;
    mData.data[i+3] = 255;
  }
  mCtx.putImageData(mData, 0, 0);
  var maskB64 = mskC.toDataURL('image/png');

  return { imageB64: imageB64, maskB64: maskB64, outW: outW, outH: outH };
}

async function oeErase() {
  if (!OE.hasMask || !OE.imgW) return;

  var btn      = document.getElementById('oe-erase-btn');
  var progWrap = document.getElementById('oe-prog-wrap');
  var errBox   = document.getElementById('oe-err-box');
  if (errBox) errBox.style.display = 'none';

  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner spin"></i> Sending to AI…';
  progWrap.style.display = 'block';

  function setProgress(pct, msg) {
    document.getElementById('oe-prog-bar').style.width  = pct + '%';
    document.getElementById('oe-prog-pct').textContent  = pct + '%';
    document.getElementById('oe-prog-msg').textContent  = msg || 'Processing…';
  }

  setProgress(5, 'Preparing image…');
  await new Promise(function(r){ setTimeout(r, 30); });

  try {
    /* 1 — Prepare scaled image + mask */
    var prep = oePrepareCanvases();
    setProgress(10, 'Preparing fill region…');

    /* 2 — Call HF inpainting API (handles cold-start retries internally) */
    var resultUrl = await hfInpaint(prep.imageB64, prep.maskB64, setProgress);
    setProgress(88, 'Rendering result…');

    /* 3 — Load result image */
    var img = new Image();
    await new Promise(function(res, rej) { img.onload = res; img.onerror = rej; img.src = resultUrl; });

    /* 6 — Paint result onto result thumb */
    var resC = document.getElementById('oe-result-thumb');
    resC.width  = img.naturalWidth;
    resC.height = img.naturalHeight;
    resC.getContext('2d').drawImage(img, 0, 0);

    /* 7 — Update base canvas so user can erase another object */
    var baseC = document.getElementById('oe-base');
    baseC.width  = img.naturalWidth;
    baseC.height = img.naturalHeight;
    OE.imgW = img.naturalWidth;
    OE.imgH = img.naturalHeight;
    baseC.getContext('2d').drawImage(img, 0, 0);

    /* 8 — Resize mask canvases to match new dimensions + re-fit display */
    var maskC = document.getElementById('oe-mask');
    maskC.width  = OE.imgW;
    maskC.height = OE.imgH;
    maskC.getContext('2d').clearRect(0, 0, OE.imgW, OE.imgH);
    OE.maskOffscreen.width  = OE.imgW;
    OE.maskOffscreen.height = OE.imgH;
    OE.maskOffCtx.clearRect(0, 0, OE.imgW, OE.imgH);
    OE.hasMask = false;
    oeFitCanvas();   // refit display to new result dimensions

    setProgress(100, 'Done!');
    setTimeout(function(){ progWrap.style.display = 'none'; }, 1200);

    /* Show result card */
    document.getElementById('oe-result-card').style.display = 'block';
    OE.eraseSuccess = true;

    /* Store result for download */
    fetch(resultUrl)
      .then(function(r){ return r.blob(); })
      .then(function(b){ OE.resultBlob = b; })
      .catch(function(){});   // non-fatal

  } catch (err) {
    /* Show error to user */
    OE.eraseSuccess = false;
    setProgress(0, '');
    progWrap.style.display = 'none';
    var eb = document.getElementById('oe-err-box');
    if (eb) { eb.textContent = '⚠ ' + (err.message || 'Unknown error'); eb.style.display = 'block'; }
    else { alert('Object Eraser error:\n' + (err.message || err)); }
  }

  btn.disabled = false;
  btn.innerHTML = '<i class="fas fa-eraser"></i> Erase Object';
  oeUpdateEraseBtn();
  var tabBtnE = document.getElementById('oe-toolbar-action-btn');
  if (tabBtnE) {
    if (OE.eraseSuccess) {
      /* Success: show Download in the same spot */
      tabBtnE.innerHTML = '<i class="fas fa-download"></i> Download';
      tabBtnE.onclick = oeDownload;
      tabBtnE.style.background = '#16a34a';
      tabBtnE.style.borderColor = '#16a34a';
    } else {
      /* Error: keep Erase it */
      tabBtnE.innerHTML = '<i class="fas fa-eraser"></i> Erase it';
      tabBtnE.onclick = oeErase;
      tabBtnE.style.background = '#ef4444';
      tabBtnE.style.borderColor = '#ef4444';
    }
  }
  document.getElementById('oe-card3').classList.remove('oe-active');
}

function oeToolbarAction() {
  if (OE.resultBlob || document.getElementById('oe-result-card').style.display !== 'none') {
    oeDownload();
  } else {
    oeErase();
  }
}

function oeDownload() {
  if (!OE.resultBlob && !OE.imgW) return;
  var resC = document.getElementById('oe-result-thumb');
  resC.toBlob(function(blob){
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a'); a.href = url; a.download = 'erased_object.png'; a.click();
    setTimeout(function(){URL.revokeObjectURL(url);}, 5000);
  }, 'image/png');
}

function oeEraseAnother() {
  // Reset mask so user can paint again on the already-erased image
  oeResetMask();
  OE.resultBlob = null;
  document.getElementById('oe-result-card').style.display = 'none';
  document.getElementById('oe-card2').classList.add('oe-active');
  var tabBtn = document.getElementById('oe-toolbar-action-btn');
  if (tabBtn) { tabBtn.innerHTML = '<i class="fas fa-eraser"></i> Erase it'; tabBtn.onclick = oeErase; tabBtn.style.background='#ef4444'; tabBtn.style.borderColor='#ef4444'; }
}


