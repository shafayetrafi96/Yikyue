<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yik Yue Portal</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect x='18' y='3' width='64' height='94' rx='6' fill='%230A4038'/%3E%3Crect x='24' y='9' width='52' height='82' rx='3' fill='white'/%3E%3Cline x1='32' y1='30' x2='68' y2='30' stroke='%230A4038' stroke-width='3'/%3E%3Cline x1='32' y1='44' x2='68' y2='44' stroke='%230A4038' stroke-width='3'/%3E%3Cline x1='32' y1='58' x2='54' y2='58' stroke='%230A4038' stroke-width='3'/%3E%3C/svg%3E">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>
    <script>tailwind.config={theme:{extend:{colors:{brand:'#0A4038','brand-dark':'#072e27','brand-light':'#e0efed'}}}}</script>
    <style>
        body{min-height:100vh;background-color:#f4f6f9;transition:background .3s}
        ::selection{background:#0A4038;color:#fff}
        .toast{position:fixed;bottom:30px;left:50%;transform:translateX(-50%);padding:14px 28px;border-radius:12px;color:#fff;font-weight:600;font-size:14px;z-index:9999;opacity:0;transition:opacity .3s;box-shadow:0 8px 30px rgba(0,0,0,.2);pointer-events:none}
        .toast.show{opacity:1}.toast-success{background:#059669}.toast-error{background:#dc2626}
        .portal-card{background:#fff;border-radius:16px;box-shadow:0 4px 24px rgba(0,0,0,.10);transition:transform .18s,box-shadow .18s;cursor:pointer;text-decoration:none!important;color:inherit;display:flex;align-items:center;padding:22px 28px;gap:22px;border:2px solid transparent;width:100%;font-family:inherit;text-align:left;outline:none}
        .portal-card:hover{transform:translateY(-4px);box-shadow:0 12px 36px rgba(10,64,56,.18);border-color:#0A4038}
        .portal-icon-circle{width:58px;height:58px;border-radius:50%;background:#0A4038;display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden}
        .portal-icon-circle i{font-size:24px;color:#fff}
        .portal-icon-circle img{width:100%;height:100%;object-fit:cover;border-radius:50%}
        .portal-card-name{font-size:1.13rem;font-weight:700;color:#1a2e2a;line-height:1.3}
        .portal-card-arrow{margin-left:auto;color:#0A4038;opacity:.5;font-size:18px;flex-shrink:0}
        .modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.52);z-index:100;display:flex;justify-content:center;align-items:center;padding:16px}
        .icon-opt{width:44px;height:44px;border-radius:10px;border:2px solid #e5e7eb;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:.15s;font-size:18px;color:#4a5568}
        .icon-opt:hover,.icon-opt.selected{border-color:#0A4038;background:#e0efed;color:#0A4038}
        .link-row{display:flex;align-items:center;gap:8px;padding:10px 14px;background:#f9fafb;border-radius:10px;border:1px solid #e5e7eb}
        .bg-overlay{position:absolute;inset:0;z-index:-1;pointer-events:none;background-size:cover;background-position:center;transition:opacity .3s}
        input[type=range]{accent-color:#0A4038}

        /* ── Guide ──────────────────────────────────────────── */
        .guide-wrap{background:#fff;border-radius:20px;box-shadow:0 6px 32px rgba(10,64,56,.10);border:1px solid #d1ede8;overflow:hidden;margin-bottom:32px}
        .guide-header{background:linear-gradient(135deg,#0A4038,#125748);padding:14px 22px;display:flex;align-items:center;gap:14px}
        .guide-header-icon{width:38px;height:38px;border-radius:10px;background:rgba(255,255,255,.14);display:flex;align-items:center;justify-content:center;flex-shrink:0}
        .guide-header-icon i{color:#fff;font-size:17px}
        .guide-header-text h3{font-size:.96rem;font-weight:800;color:#fff;margin:0}
        .guide-header-text p{font-size:.72rem;color:rgba(255,255,255,.6);margin:0}
        #guidePlayer{background:#0b1a16;min-height:390px;position:relative;overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
        @media(max-width:520px){#guidePlayer{min-height:460px}}
        .guide-controls{background:#0a1512;padding:10px 16px;display:flex;align-items:center;gap:9px}
        .gctrl{width:30px;height:30px;border-radius:8px;background:rgba(255,255,255,.07);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.6);font-size:11px;transition:background .15s;flex-shrink:0}
        .gctrl:hover{background:rgba(255,255,255,.14);color:#fff}
        .gctrl.pp{background:#0A4038;color:#fff;width:34px;height:34px;font-size:12px}
        .gctrl.pp:hover{background:#125748}
        .g-progress{flex:1;height:4px;background:rgba(255,255,255,.09);border-radius:4px;cursor:pointer;overflow:hidden}
        .g-fill{height:100%;background:linear-gradient(90deg,#0A4038,#1ecc8f);border-radius:4px;transition:width .4s linear}
        .g-counter{font-size:.66rem;color:rgba(255,255,255,.35);font-weight:600;min-width:34px;text-align:center}
        .g-appname{font-size:.7rem;color:rgba(255,255,255,.4);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:130px}
        .guide-tabs{border-top:1px solid #e0efed;display:flex;overflow-x:auto;scrollbar-width:none}
        .guide-tabs::-webkit-scrollbar{display:none}
        .gtab{flex-shrink:0;padding:11px 16px;font-size:.78rem;font-weight:700;color:#6b7280;cursor:pointer;border:none;background:none;font-family:inherit;border-bottom:3px solid transparent;transition:color .16s,border-color .16s,background .16s;display:flex;align-items:center;gap:6px;white-space:nowrap;outline:none}
        .gtab:hover{color:#0A4038;background:#f8fffe}
        .gtab.active{color:#0A4038;border-bottom-color:#0A4038;background:#f0faf7}
        .gtab i{font-size:.8rem;opacity:.8}

        /* ══ MOCK APP UI ══════════════════════════════════════ */
        .vscene{position:absolute;inset:0;animation:vFadeIn .4s ease forwards}
        @keyframes vFadeIn{from{opacity:0;transform:translateX(24px)}to{opacity:1;transform:translateX(0)}}
        .vbadge{position:absolute;top:10px;left:12px;z-index:30;background:rgba(10,64,56,.9);color:#4dd8a0;font-size:.56rem;font-weight:800;text-transform:uppercase;letter-spacing:1px;padding:3px 10px;border-radius:20px}

        /* Dark intro scenes */
        .vdark{position:absolute;inset:0;background:linear-gradient(135deg,#071510,#0b1f19);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:26px 22px;text-align:center;overflow:hidden}
        .vdark::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 15% 50%,rgba(10,64,56,.4),transparent 55%);pointer-events:none}
        .vdark-icon{width:60px;height:60px;border-radius:18px;background:rgba(10,64,56,.5);border:2px solid rgba(30,200,140,.25);display:flex;align-items:center;justify-content:center;font-size:25px;margin-bottom:12px;color:#4dd8a0;animation:vIconPop .5s cubic-bezier(.34,1.56,.64,1) .15s backwards}
        @keyframes vIconPop{from{opacity:0;transform:scale(.5)}to{opacity:1;transform:scale(1)}}
        .vdark-title{font-size:1.05rem;font-weight:800;color:#fff;margin-bottom:4px;animation:vSlideUp .4s ease .35s backwards}
        .vdark-sub{font-size:.74rem;color:rgba(255,255,255,.46);margin-bottom:16px;animation:vSlideUp .4s ease .5s backwards}
        @keyframes vSlideUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
        .vfeature{display:flex;align-items:flex-start;gap:9px;color:rgba(255,255,255,.68);font-size:.75rem;margin-bottom:7px;text-align:left;width:100%;max-width:360px}
        .vfeature-dot{width:18px;height:18px;border-radius:50%;flex-shrink:0;background:rgba(30,200,140,.14);border:1.5px solid rgba(30,200,140,.3);display:flex;align-items:center;justify-content:center;font-size:8px;color:#4dd8a0;margin-top:1px}

        /* Light app scenes */
        .vapp{position:absolute;inset:0;display:flex;flex-direction:column;overflow:hidden}
        .vnav{background:linear-gradient(135deg,#0A4038,#125748);color:#fff;padding:8px 14px;display:flex;align-items:center;gap:9px;flex-shrink:0}
        .vnav-icon{width:25px;height:25px;border-radius:6px;background:rgba(255,255,255,.14);display:flex;align-items:center;justify-content:center;font-size:11px;color:#fff;flex-shrink:0}
        .vnav-title{font-weight:800;font-size:.8rem;color:#fff}
        .vnav-sub{font-size:.6rem;color:rgba(255,255,255,.55)}
        .vbody{flex:1;padding:10px 12px;background:#f4f6f9;overflow:hidden;display:flex;flex-direction:column;gap:8px}
        .vcard{background:#fff;border-radius:8px;padding:10px 12px;box-shadow:0 2px 8px rgba(0,0,0,.07);animation:vCardIn .35s ease backwards;flex-shrink:0}
        @keyframes vCardIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
        .vcard-title{font-size:.74rem;font-weight:800;color:#0A4038;margin-bottom:8px;display:flex;align-items:center;justify-content:space-between;gap:6px}
        .vrow{display:flex;gap:7px}
        .vcol{flex:1;min-width:0}
        .vfield{margin-bottom:6px}
        .vlabel{font-size:.56rem;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:.4px;margin-bottom:2px}
        .vinput{border:1.5px solid #e5e7eb;border-radius:5px;padding:5px 8px;font-size:.71rem;color:#1f2937;background:#fff;min-height:24px;display:flex;align-items:center;position:relative;transition:border-color .15s,box-shadow .15s;overflow:hidden}
        .vinput.vfocus{border-color:#0A4038;box-shadow:0 0 0 2px rgba(10,64,56,.1)}
        .vinput.vsel-arrow::after{content:'▾';position:absolute;right:6px;color:#9ca3af;font-size:.6rem;pointer-events:none}
        .vcursor{display:inline-block;width:1.5px;height:.82em;background:#0A4038;margin-left:1px;vertical-align:middle;animation:vcBlink .8s step-end infinite}
        @keyframes vcBlink{50%{opacity:0}}
        .vdropdown{background:#fff;border:1.5px solid #0A4038;border-top:none;border-radius:0 0 5px 5px;overflow:hidden;position:absolute;top:100%;left:-1.5px;right:-1.5px;z-index:20;animation:vDropIn .2s ease;box-shadow:0 4px 12px rgba(0,0,0,.1)}
        @keyframes vDropIn{from{opacity:0;transform:scaleY(.75);transform-origin:top}to{opacity:1;transform:scaleY(1)}}
        .vopt{padding:5px 9px;font-size:.69rem;color:#374151}
        .vopt.vsel{background:#f0faf7;color:#0A4038;font-weight:700}
        .vbtn{background:#0A4038;color:#fff;border:none;border-radius:5px;padding:6px 13px;font-size:.71rem;font-weight:700;cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;gap:5px;transition:transform .1s,filter .1s;flex-shrink:0}
        .vbtn.vclicking{transform:scale(.91);filter:brightness(1.2)}
        .vbtn-sm{padding:4px 9px;font-size:.65rem}
        .vbtn-outline{background:#fff;color:#0A4038;border:1.5px solid #0A4038}
        .vbtn-blue{background:#2563eb}
        .vbtn-red{background:#dc2626}
        .vbtn-green{background:#059669}
        .vbtn-orange{background:#d97706}
        .vbtn-purple{background:#7c3aed}
        .vtable{width:100%;border-collapse:collapse;font-size:.64rem}
        .vth{padding:5px 6px;text-align:left;font-weight:700;font-size:.58rem;color:#fff;background:#0A4038}
        .vthead tr:first-child .vth:first-child{border-radius:5px 0 0 0}
        .vthead tr:first-child .vth:last-child{border-radius:0 5px 0 0}
        .vtd{padding:5px 6px;color:#374151;border-bottom:1px solid #f3f4f6;font-size:.65rem}
        .vtr:nth-child(even) .vtd{background:#f9fafb}
        .vtr{animation:vRowIn .28s ease backwards}
        @keyframes vRowIn{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:translateX(0)}}
        .vtag{display:inline-block;padding:1px 6px;border-radius:12px;font-size:.57rem;font-weight:700;white-space:nowrap}
        .tg{background:#dcfce7;color:#166534}
        .tb{background:#dbeafe;color:#1d4ed8}
        .ta{background:#fef3c7;color:#92400e}
        .tr{background:#fee2e2;color:#991b1b}
        .tp{background:#f3e8ff;color:#6b21a8}
        .vtoast{position:absolute;bottom:12px;right:12px;background:#059669;color:#fff;padding:7px 12px;border-radius:7px;font-size:.68rem;font-weight:700;display:flex;align-items:center;gap:5px;animation:vToastIn .3s ease;box-shadow:0 4px 14px rgba(0,0,0,.22);z-index:25}
        @keyframes vToastIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
        .vprog-track{width:100%;height:6px;background:#e5e7eb;border-radius:6px;overflow:hidden;margin-top:5px}
        .vprog-fill{height:100%;background:linear-gradient(90deg,#0A4038,#1ecc8f);border-radius:6px;transition:width .25s linear}
        .vupzone{border:2px dashed #0A4038;border-radius:7px;padding:14px;text-align:center;background:#f0faf7;animation:vCardIn .4s ease .15s backwards}
        .vupzone-icon{font-size:20px;color:#0A4038;margin-bottom:4px}
        .vupzone-label{font-size:.71rem;font-weight:700;color:#0A4038}
        .vupzone-sub{font-size:.6rem;color:#6b7280;margin-top:2px}
        .vtool-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}
        .vtool-card{background:#fff;border-radius:7px;padding:9px 10px;display:flex;align-items:center;gap:8px;box-shadow:0 1px 5px rgba(0,0,0,.07);border:2px solid transparent;animation:vCardIn .3s ease backwards}
        .vtool-card.vactive{border-color:#0A4038}
        .vtool-icon{width:30px;height:30px;border-radius:7px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:12px;flex-shrink:0}
        .vtool-name{font-size:.68rem;font-weight:700;color:#1f2937}
        .vtool-desc{font-size:.58rem;color:#9ca3af;margin-top:1px}
        .vinfo-box{background:#f0faf7;border:1.5px solid #a7f3d0;border-radius:6px;padding:7px 10px;font-size:.66rem;color:#065f46}
        .verr-box{background:#fff7ed;border:1.5px solid #fed7aa;border-radius:6px;padding:7px 10px;font-size:.66rem;color:#7c2d12}
        .vsep{height:1px;background:#f3f4f6;margin:4px 0}

        /* Attendance calendar */
        .vcal-header{display:grid;grid-template-columns:repeat(7,1fr);gap:1px;margin-bottom:2px}
        .vcal-dh{text-align:center;font-size:.56rem;font-weight:700;color:#9ca3af}
        .vcal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px}
        .vcal-day{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:.58rem;font-weight:600;border-radius:4px;cursor:pointer}
        .vcal-day.vhol{background:#fee2e2;color:#dc2626}
        .vcal-day.vwork{background:#f9fafb;color:#374151}
        .vcal-day.vtoday{background:#0A4038;color:#fff}
        .vcal-day.vweekend{color:#9ca3af}

        /* Challan document preview */
        .vdoc{background:#fff;border:1px solid #e5e7eb;border-radius:6px;padding:9px 11px;font-size:.63rem;color:#1f2937;overflow:hidden}
        .vdoc-h{text-align:center;font-weight:800;color:#0A4038;font-size:.72rem;margin-bottom:2px;border-bottom:2px solid #0A4038;padding-bottom:3px}
        .vdoc-sub{text-align:center;font-size:.58rem;color:#6b7280;margin-bottom:7px}

        /* Voucher table rows */
        .vamt-row{display:flex;align-items:center;gap:8px;padding:4px 7px;border-bottom:1px solid #f3f4f6;font-size:.68rem}
        .vamt-desc{flex:1;color:#374151}
        .vamt-val{font-weight:700;color:#0A4038;min-width:55px;text-align:right}

        /* Holiday list rows */
        .vhol-row{display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid #f3f4f6;animation:vRowIn .25s ease backwards}
        .vhol-date{font-size:.64rem;font-weight:700;color:#0A4038;min-width:52px}
        .vhol-day{font-size:.6rem;color:#9ca3af;min-width:28px}
        .vhol-name{font-size:.66rem;color:#374151;flex:1}

        /* RTE toolbar */
        .vrte-toolbar{display:flex;align-items:center;gap:2px;padding:5px 7px;background:#f8fafc;border:1.5px solid #e5e7eb;border-bottom:none;border-radius:5px 5px 0 0;flex-wrap:wrap}
        .vrte-btn{width:22px;height:22px;border:1px solid #e5e7eb;border-radius:3px;background:#fff;font-size:.6rem;font-weight:700;color:#374151;display:flex;align-items:center;justify-content:center;cursor:pointer;font-family:inherit}
        .vrte-btn.vactive{background:#0A4038;color:#fff;border-color:#0A4038}
        .vrte-sep{width:1px;height:16px;background:#e5e7eb;margin:0 2px}
        .vrte-area{border:1.5px solid #e5e7eb;border-top:none;border-radius:0 0 5px 5px;padding:7px 9px;font-size:.71rem;min-height:52px;color:#1f2937;background:#fff;line-height:1.5}

        /* Tab strip for tools */
        .vtabs-strip{display:flex;border-bottom:2px solid #e5e7eb;margin-bottom:8px;overflow-x:auto;scrollbar-width:none}
        .vtabs-strip::-webkit-scrollbar{display:none}
        .vtab{flex-shrink:0;padding:7px 13px;font-size:.67rem;font-weight:700;color:#6b7280;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;display:flex;align-items:center;gap:5px;white-space:nowrap}
        .vtab.vtab-active{color:#0A4038;border-bottom-color:#0A4038}

        /* Signature slot */
        .vsig-slot{border:2px dashed #e5e7eb;border-radius:6px;padding:8px;text-align:center;background:#fafafa;min-height:52px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px}
        .vsig-slot.vsig-filled{border-color:#a7f3d0;background:#f0faf7}
        .vsig-slot-label{font-size:.57rem;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:.3px}
        .vsig-slot-name{font-size:.63rem;color:#374151;font-weight:600}

        /* Stats bar */
        .vstat-bar{display:flex;gap:8px;margin-bottom:0}
        .vstat{background:#fff;border-radius:7px;padding:7px 10px;flex:1;box-shadow:0 1px 5px rgba(0,0,0,.06);display:flex;flex-direction:column;gap:2px;animation:vCardIn .3s ease backwards}
        .vstat-val{font-size:1.05rem;font-weight:800;color:#0A4038}
        .vstat-lbl{font-size:.58rem;color:#9ca3af;font-weight:600;text-transform:uppercase;letter-spacing:.3px}

        /* Leave balance rows */
        .vleave-row{display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid #f3f4f6}
        .vleave-name{flex:1;font-size:.68rem;font-weight:600;color:#1f2937}
        .vleave-pill{display:inline-block;padding:2px 9px;border-radius:10px;font-size:.62rem;font-weight:700;min-width:36px;text-align:center}
        .vleave-annual{background:#dcfce7;color:#166534}
        .vleave-sick{background:#dbeafe;color:#1d4ed8}
    </style>
</head>
<body class="text-gray-800 font-sans">

<div id="toastContainer" class="toast"></div>

<!-- Admin Modal -->
<div id="adminModal" class="modal-overlay hidden">
    <div class="bg-white p-6 rounded-lg shadow-xl w-80 z-[101]">
        <h3 class="text-lg font-bold mb-4 text-brand-dark"><i class="fas fa-user-lock mr-2"></i>Admin Login</h3>
        <input type="password" id="adminPassInput" autocomplete="off" class="w-full border border-gray-300 rounded p-2 mb-2" placeholder="Enter Password" onkeypress="if(event.key==='Enter')submitAdminLogin()">
        <p id="adminError" class="text-red-500 text-sm mb-4 hidden">Incorrect Password!</p>
        <div class="flex justify-end space-x-2">
            <button onclick="closeAdminModal()" class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400 font-medium">Cancel</button>
            <button onclick="submitAdminLogin()" class="px-4 py-2 bg-brand text-white rounded hover:bg-brand-dark font-medium">Login</button>
        </div>
    </div>
</div>

<!-- Manage Links Modal -->
<div id="manageModal" class="modal-overlay hidden">
    <div class="bg-white rounded-lg shadow-2xl w-full max-w-2xl max-h-[90vh] flex flex-col z-[101]">
        <div class="p-4 border-b flex justify-between items-center bg-brand text-white rounded-t-lg shrink-0">
            <h3 class="text-lg font-bold"><i class="fas fa-cog mr-2"></i>Manage Portal Links</h3>
            <button onclick="closeManageModal()" class="text-white hover:text-gray-300 text-xl"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-5 overflow-y-auto flex-1">
            <div id="linksList" class="space-y-3 mb-4"></div>
            <button onclick="openAddEditModal(null)" class="w-full py-2.5 border-2 border-dashed border-brand text-brand rounded-lg font-bold hover:bg-brand-light transition"><i class="fas fa-plus mr-2"></i>Add New Link</button>
        </div>
        <div class="p-4 border-t bg-gray-50 flex justify-between items-center rounded-b-lg">
            <button onclick="openBgModal()" class="px-4 py-2 bg-gray-700 text-white rounded hover:bg-gray-800 font-medium text-sm"><i class="fas fa-image mr-2"></i>Background</button>
            <button onclick="closeManageModal()" class="px-5 py-2 bg-brand text-white rounded hover:bg-brand-dark font-bold">Done</button>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div id="addEditModal" class="modal-overlay hidden">
