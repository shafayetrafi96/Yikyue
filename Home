var _timers=[];
function _after(fn,ms){var id=setTimeout(fn,ms);_timers.push(id);return id;}
function _every(fn,ms){var id=setInterval(fn,ms);_timers.push(id);return id;}
function _clearAll(){_timers.forEach(function(t){clearTimeout(t);clearInterval(t);});_timers=[];}

function _type(elId,text,delay,speed){
    _after(function(){
        var el=document.getElementById(elId);if(!el)return;
        var span=document.createElement('span');span.className='vtyped';
        var cur=el.querySelector('.vcursor');
        if(cur)el.insertBefore(span,cur);else el.appendChild(span);
        var i=0;
        _every(function(){if(!el.isConnected)return;span.textContent=text.slice(0,++i);if(i>=text.length){}},speed||50);
    },delay||0);
}
function _focus(elId,on){var el=document.getElementById(elId);if(el){if(on)el.classList.add('vfocus');else el.classList.remove('vfocus');}}
function _setText(elId,text,delay){_after(function(){var el=document.getElementById(elId);if(el)el.textContent=text;},delay||0);}
function _showDrop(parentId,opts,selText,delay){
    _after(function(){
        var p=document.getElementById(parentId);if(!p)return;
        p.querySelector('.vdropdown')&&p.querySelector('.vdropdown').remove();
        var d=document.createElement('div');d.className='vdropdown';
        opts.forEach(function(o){var item=document.createElement('div');item.className='vopt'+(o===selText?' vsel':'');item.textContent=o;d.appendChild(item);});
        p.style.position='relative';p.appendChild(d);
    },delay||0);
}
function _hideDrop(parentId,delay){_after(function(){var p=document.getElementById(parentId);if(p){var d=p.querySelector('.vdropdown');if(d)d.remove();}},delay||0);}
function _click(elId,delay){_after(function(){var el=document.getElementById(elId);if(el){el.classList.add('vclicking');_after(function(){if(el.isConnected)el.classList.remove('vclicking');},240);}},delay||0);}
function _toast(msg,delay,col){_after(function(){var p=document.getElementById('guidePlayer');if(!p)return;var t=document.createElement('div');t.className='vtoast';t.style.background=col||'#059669';t.innerHTML='<i class="fas fa-check-circle"></i> '+msg;p.appendChild(t);},delay||0);}
function _progress(fillId,pct,delay,dur){_after(function(){var el=document.getElementById(fillId);if(el){el.style.transition='width '+(dur||1600)+'ms linear';el.style.width=pct+'%';}},delay||0);}

