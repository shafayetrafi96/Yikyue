/* ══════════════════════════════════════════════════════════
   PLAYER ENGINE
   ══════════════════════════════════════════════════════════ */
var GP={
    appIdx:0,sceneIdx:0,playing:true,sceneTimer:null,progressStart:0,progressDur:0,

    curApp:function(){return GUIDE_APPS[this.appIdx];},
    curScene:function(){return this.curApp().scenes[this.sceneIdx];},

    loadApp:function(idx){
        this.appIdx=idx;this.sceneIdx=0;
        document.querySelectorAll('.gtab').forEach(function(t){t.classList.remove('active');});
        var tb=document.getElementById('gtab_'+GUIDE_APPS[idx].id);if(tb)tb.classList.add('active');
        document.getElementById('gAppName').textContent=GUIDE_APPS[idx].name;
        this.runScene();
    },

    runScene:function(){
        var self=this;
        _clearAll();clearTimeout(this.sceneTimer);
        var scene=this.curScene();
        var total=this.curApp().scenes.length;
        document.getElementById('gCounter').textContent=(this.sceneIdx+1)+' / '+total;

        var player=document.getElementById('guidePlayer');
        player.innerHTML='<div class="vbadge">'+scene.label+'</div>'+scene.html();
        scene.run();

        var fillEl=document.getElementById('gFill');
        if(fillEl){fillEl.style.transition='none';fillEl.style.width='0%';requestAnimationFrame(function(){fillEl.style.transition='width '+scene.duration+'ms linear';fillEl.style.width='100%';});}

        this.progressStart=Date.now();this.progressDur=scene.duration;
        if(this.playing){this.sceneTimer=setTimeout(function(){self.next();},scene.duration);}
        document.getElementById('gPlayBtn').innerHTML=this.playing?'<i class="fas fa-pause"></i>':'<i class="fas fa-play"></i>';
    },

    next:function(){var n=this.curApp().scenes.length;this.sceneIdx=(this.sceneIdx+1)%n;this.runScene();},
    prev:function(){var n=this.curApp().scenes.length;this.sceneIdx=(this.sceneIdx-1+n)%n;this.runScene();},

    toggle:function(){
        this.playing=!this.playing;
        if(this.playing){
            var self=this;var rem=Math.max(0,this.progressDur-(Date.now()-this.progressStart));
            this.sceneTimer=setTimeout(function(){self.next();},rem);
            var fillEl=document.getElementById('gFill');
            if(fillEl){var pct=Math.min(100,((Date.now()-this.progressStart)/this.progressDur)*100);fillEl.style.transition='none';fillEl.style.width=pct+'%';requestAnimationFrame(function(){fillEl.style.transition='width '+rem+'ms linear';fillEl.style.width='100%';});}
        }else{
            clearTimeout(this.sceneTimer);
            var fillEl=document.getElementById('gFill');
            if(fillEl){var cur=parseFloat(fillEl.style.width)||0;fillEl.style.transition='none';fillEl.style.width=cur+'%';}
        }
        document.getElementById('gPlayBtn').innerHTML=this.playing?'<i class="fas fa-pause"></i>':'<i class="fas fa-play"></i>';
    },

    seek:function(e){
        var bar=document.getElementById('gProgressBar');
        var rect=bar.getBoundingClientRect();
        var pct=(e.clientX-rect.left)/rect.width;
        var n=this.curApp().scenes.length;
        this.sceneIdx=Math.max(0,Math.min(Math.round(pct*(n-1)),n-1));
        this.runScene();
    }
};

function buildTabs(){
    var bar=document.getElementById('guideTabs');bar.innerHTML='';
    GUIDE_APPS.forEach(function(app,i){
        var btn=document.createElement('button');btn.className='gtab'+(i===0?' active':'');btn.id='gtab_'+app.id;
        btn.innerHTML='<i class="fas '+app.icon+'"></i>'+escH(app.name);
        btn.onclick=function(){GP.loadApp(i);};
        bar.appendChild(btn);
    });
}

document.addEventListener('keydown',function(e){
    if(e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA')return;
    if(e.key==='ArrowRight')GP.next();
    else if(e.key==='ArrowLeft')GP.prev();
    else if(e.key===' '){e.preventDefault();GP.toggle();}
});

