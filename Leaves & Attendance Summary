function iso2d(s){if(!s||!s.includes('-'))return s;var p=s.split('-');var mn=['January','February','March','April','May','June','July','August','September','October','November','December'];var mo=parseInt(p[1],10)-1;return p[2].padStart(2,'0')+' '+(mn[mo]||p[1]);}
function d2iso(s){if(!s)return'';var p=s.split('/');if(p.length!==3)return'';var y=p[2].length===2?'20'+p[2]:p[2];return y+'-'+p[1].padStart(2,'0')+'-'+p[0].padStart(2,'0');}
