/* Merge annual (auto-processed + manual) + sick for review display */
function getMergedLeavesForReview(r, mk){
    var n=(r.name||'').trim();
    var sickItems=[], manualAnnualItems=[];
    /* 1. Check D.manualLeaves for both sick AND manual annual */
    var manualMap=(D.manualLeaves[mk]&&typeof D.manualLeaves[mk]==='object')?D.manualLeaves[mk]:{};
    if(manualMap[n]){
        var mItems=parseLeaveDateItems(manualMap[n]);
        sickItems=mItems.filter(function(i){return i.sick;});
        manualAnnualItems=mItems.filter(function(i){return!i.sick;});
    }
    /* 2. Fallback: sick entered AFTER the month was already saved lives in D.summaries */
    if(!sickItems.length&&D.summaries[mk]){
        var prev=ensureArray(D.summaries[mk].results);
        for(var si=0;si<prev.length;si++){
            if((prev[si].name||'').trim()===n){
                sickItems=parseLeaveDateItems(prev[si].leaves||'0').filter(function(i){return i.sick;});
                break;
            }
        }
    }
    /* 2b. Fallback: manual annual dates entered after a previous save also live in D.summaries
       Only pick up dates NOT already in the current auto-processed result (to avoid double-counting) */
    if(!manualAnnualItems.length&&D.summaries[mk]){
        var prevAnn=ensureArray(D.summaries[mk].results);
        var _autoSet=new Set(parseLeaveDateItems(r.leaves||'0').filter(function(i){return!i.sick;}).map(function(i){return i.date;}));
        for(var _pj=0;_pj<prevAnn.length;_pj++){
            if((prevAnn[_pj].name||'').trim()===n){
                manualAnnualItems=parseLeaveDateItems(prevAnn[_pj].leaves||'0').filter(function(i){return!i.sick&&!_autoSet.has(i.date);});
                break;
            }
        }
    }
    /* Build annual base: auto-processed + any manual annual/exchanged (deduplicated by date) */
    var annualItems=parseLeaveDateItems(r.leaves||'0').filter(function(i){return!i.sick;});
    var autoAnnualDates=new Set(annualItems.map(function(i){return i.date;}));
    manualAnnualItems.forEach(function(item){
        if(!autoAnnualDates.has(item.date)) annualItems.push(item);
    });
    if(!sickItems.length&&!manualAnnualItems.length)return r.leaves;
    var sickDates=new Set(sickItems.map(function(i){return i.date;}));
    var filteredAnnual=annualItems.filter(function(i){return!sickDates.has(i.date);});
    var all=filteredAnnual.concat(sickItems);
    if(!all.length)return'0';
    /* Total excludes {Exchanged} days — they are not deducted from any leave type */
    var total=all.filter(function(i){return!i.exchanged;}).reduce(function(s,i){return s+(i.count||1);},0);
    var fmt=all.map(function(i){
        var pfx=(i.count&&i.count!==1)?i.count+':':'';
        if(i.exchanged) return pfx+i.date+' (exchanged)';
        return pfx+i.date+(i.sick?' (sick)':'');
    });
    return total+' ['+fmt.join(', ')+']';
}

function renderReview(){
    var ra=document.getElementById('reviewArea'),rd=document.getElementById('results');
    rd.innerHTML='';
    if(!pendingResults)return;
    var mk=pendingResults.year+'-'+String(pendingResults.month).padStart(2,'0');
    /* All employees are kept in the review — deleted employees' records are preserved */
    var allRevResults=pendingResults.results;
    var h='<div class="review-bar"><span style="font-weight:700;color:var(--brand)"><i class="fas fa-clipboard-check"></i> Review — Edit Any Cell Before Saving</span><button class="save-sum" onclick="saveToSummary()"><i class="fas fa-save"></i> Save to Summary</button><button class="discard" onclick="discardResults()"><i class="fas fa-times"></i> Discard</button></div>';
    h+='<table><thead><tr><th>Employee Name</th><th>Late Arrival Days</th><th>Total Late Minutes</th><th>Weekend Duty Days & Dates</th><th>On Leaves</th></tr></thead><tbody>';
    allRevResults.forEach(function(r,i){
        var mergedLeaves=getMergedLeavesForReview(r,mk);
        var displayLeaves=formatLeavesForSummary(filterLeavesToMonth(mergedLeaves,mk));
        h+='<tr><td class="ec" data-t="name" data-i="'+i+'" onclick="editRev(this)">'+r.name+'</td><td class="ec" data-t="lateDays" data-i="'+i+'" onclick="editRev(this)">'+r.lateDays+'</td><td class="ec" data-t="lateMins" data-i="'+i+'" onclick="editRev(this)">'+r.lateMins+'</td><td class="ec" data-t="weekendDuty" data-i="'+i+'" onclick="editRev(this)">'+r.weekendDuty+'</td><td class="ec" data-t="leaves" data-i="'+i+'" onclick="editRev(this)">'+displayLeaves+'</td></tr>';
    });
    h+='</tbody></table>';ra.innerHTML=h;
}

function editRev(cell){
    if(!isAdmin)return;
    if(cell.querySelector('input'))return;
    var t=cell.dataset.t,idx=parseInt(cell.dataset.i),r=pendingResults.results[idx];if(!r)return;
    var mk=pendingResults.year+'-'+String(pendingResults.month).padStart(2,'0');
    var cv;
    if(t==='leaves'){cv=formatLeavesForSummary(filterLeavesToMonth(getMergedLeavesForReview(r,mk),mk));}
    else{cv=String(r[t]);}
    var ic='ni',ph='';
    if(t==='lateDays'||t==='lateMins'){ic='ni-sm';ph='0';}
    var inp=document.createElement('input');inp.type='text';inp.className=ic;inp.value=cv;inp.placeholder=ph;
    cell.textContent='';cell.appendChild(inp);inp.focus();inp.select();
    function done(){
        var v=inp.value.trim();
        if(t==='lateDays')r.lateDays=parseInt(v)||0;
        else if(t==='lateMins')r.lateMins=parseInt(v)||0;
        else r[t]=v;
        renderReview();
    }
    inp.addEventListener('blur',done);
    inp.addEventListener('keydown',function(e){if(e.key==='Enter')inp.blur();if(e.key==='Escape')renderReview();});
}

async function saveToSummary(){
    if(!pendingResults)return;
    var mn=['','January','February','March','April','May','June','July','August','September','October','November','December'];
    var mk=pendingResults.year+'-'+String(pendingResults.month).padStart(2,'0');
    var ml=mn[pendingResults.month]+' '+pendingResults.year;

    /* Merge any manually-entered SICK leaves into processed results.
       Auto-processed absent days = Annual; manual sick entries are preserved and
       not overwritten. If the same date is both auto-absent and manually-sick,
       sick takes priority (the date is removed from annual). */
    var manualMap=(D.manualLeaves[mk]&&typeof D.manualLeaves[mk]==='object')?D.manualLeaves[mk]:{};

    function _buildLeaves(annualItems, sickItems){
        var sickDates=new Set(sickItems.map(function(i){return i.date;}));
        var filteredAnnual=annualItems.filter(function(i){return!sickDates.has(i.date);});
        var all=filteredAnnual.concat(sickItems);
        if(!all.length)return'0';
        /* Total excludes {Exchanged} days — they are not deducted from any leave type */
        var total=all.filter(function(i){return!i.exchanged;}).reduce(function(s,i){return s+(i.count||1);},0);
        var fmt=all.map(function(i){
            var pfx=(i.count&&i.count!==1)?i.count+':':'';
            if(i.exchanged) return pfx+i.date+' (exchanged)';
            return pfx+i.date+(i.sick?' (sick)':'');
        });
        return total+' ['+fmt.join(', ')+']';
    }

    /* Snapshot of any previously-saved summary for this month (needed to recover
       sick items that were entered after the last save and live in D.summaries,
       not in D.manualLeaves). We snapshot before the overwrite below. */
    var prevSummaryResults=D.summaries[mk]?ensureArray(D.summaries[mk].results):[];
    function _prevSickForName(n){
        for(var _pi=0;_pi<prevSummaryResults.length;_pi++){
            if((prevSummaryResults[_pi].name||'').trim()===n){
                return parseLeaveDateItems(prevSummaryResults[_pi].leaves||'0').filter(function(i){return i.sick;});
            }
        }
        return[];
    }

    var mergedResults=ensureArray(pendingResults.results).map(function(r){
        var n=(r.name||'').trim();
        /* 1. Try sick + annual items from D.manualLeaves */
        var manualItems=manualMap[n]?parseLeaveDateItems(manualMap[n]):[];
        var sickItems=manualItems.filter(function(i){return i.sick;});
        var manualAnnualItems=manualItems.filter(function(i){return!i.sick;});
        /* 2. Fallback: sick entered after last save lives in D.summaries, not manualLeaves */
        if(!sickItems.length) sickItems=_prevSickForName(n);
        /* 2b. Fallback: manual annual/exchanged leaves entered via Remaining Leaves section
           (editLeaveCell on a processed month) live in D.summaries, not D.manualLeaves */
        if(!manualAnnualItems.length){
            var _autoAnnSet=new Set(parseLeaveDateItems(r.leaves||'0').filter(function(i){return!i.sick;}).map(function(i){return i.date;}));
            for(var _pj=0;_pj<prevSummaryResults.length;_pj++){
                if((prevSummaryResults[_pj].name||'').trim()===n){
                    manualAnnualItems=parseLeaveDateItems(prevSummaryResults[_pj].leaves||'0').filter(function(i){return!i.sick&&!_autoAnnSet.has(i.date);});
                    break;
                }
            }
        }
        /* Existing items already in this result's leaves — may include tags the admin
           typed directly in the Review grid (e.g. changed {Annual} to {Exchanged}) */
        var currentItems=parseLeaveDateItems(r.leaves||'0');
        var currentSick=currentItems.filter(function(i){return i.sick;});
        var sickDateSet=new Set(sickItems.map(function(i){return i.date;}));
        currentSick.forEach(function(item){
            if(!sickDateSet.has(item.date)){ sickItems.push(item); sickDateSet.add(item.date); }
        });
        var annualItems=currentItems.filter(function(i){return!i.sick;});
        /* Merge manual annual/exchanged dates that aren't already present */
        var autoDateSet=new Set(annualItems.map(function(i){return i.date;}));
        manualAnnualItems.forEach(function(item){
            if(!autoDateSet.has(item.date)) annualItems.push(item);
        });
        /* Always recompute — this ensures the total correctly excludes {Exchanged}
           days even when the admin edited the Review cell text directly. */
        return Object.assign({},r,{leaves:_buildLeaves(annualItems,sickItems)});
    });

    /* Add employees who only have manual data (sick or annual) but aren't in the Excel */
    var processedNames={};
    mergedResults.forEach(function(r){processedNames[(r.name||'').trim()]=true;});
    Object.keys(manualMap).forEach(function(n){
        if(n&&!processedNames[n]&&manualMap[n]&&manualMap[n]!=='0'){
            var manualItems=parseLeaveDateItems(manualMap[n]);
            var sickItems=manualItems.filter(function(i){return i.sick;});
            var annualItems=manualItems.filter(function(i){return!i.sick;});
            if(sickItems.length||annualItems.length){
                mergedResults.push({name:n,lateDays:0,lateMins:0,weekendDuty:'0',leaves:_buildLeaves(annualItems,sickItems)});
            }
        }
    });
    mergedResults.sort(function(a,b){return(a.name||'').localeCompare(b.name||'');});

    /* Copy leave data into D.manualLeaves[mk] so "Remaining Leaves" section picks it up.
       This is the ONLY way leave data reaches "Remaining Leaves for BD Colleagues". */
    if(!D.manualLeaves[mk]||typeof D.manualLeaves[mk]!=='object') D.manualLeaves[mk]={};
    mergedResults.forEach(function(r){
        var n=(r.name||'').trim();if(!n)return;
        var lv=(r.leaves||'').trim();
        if(lv&&lv!=='0'){D.manualLeaves[mk][n]=lv;}
        else{delete D.manualLeaves[mk][n];}
    });
    if(!Object.keys(D.manualLeaves[mk]).length) delete D.manualLeaves[mk];
    try{await saveManualLeaveMonth(mk);}catch(e){console.error('[saveToSummary] manualLeaves save failed:',e);}

    D.summaries[mk]={label:ml,processedAt:new Date().toISOString(),results:mergedResults,pmFlags:pendingResults.pmFlags};
    console.log('[saveToSummary]',mk,'— results:',mergedResults.length,'sick-merged from manual');
    /* Register any new employee names so they persist in Remaining Leaves even after month deletion */
    var _knownSet=new Set(D.knownEmployees);
    var _added=false;
    /* Skip ex-employees so hiding + re-processing a month doesn't silently restore them */
    var _exSet=new Set(D.exEmployees.map(function(e){return e.name;}));
    mergedResults.forEach(function(r){var n=(r.name||'').trim();if(n&&!_knownSet.has(n)&&!_exSet.has(n)){D.knownEmployees.push(n);_knownSet.add(n);_added=true;}});
    if(_added)try{await saveKnownEmployees();}catch(e){console.error('[saveToSummary] knownEmployees save failed:',e);}
    await saveSummaryMonth(mk);
    populateMonths();document.getElementById('monthSel').value=mk;showSummary();
    document.getElementById('reviewArea').innerHTML='';
    document.getElementById('results').innerHTML='<div style="color:var(--success);font-weight:600;padding:12px"><i class="fas fa-check-circle"></i> Saved to Monthly Attendance Summary.</div>';
    pendingResults=null;toast(ml+' saved to cloud!','success');
}

async function discardResults(){
    var confirmed=await showConfirm('Discard Results','Discard the processed attendance data? This cannot be undone.');
    if(!confirmed)return;
    pendingResults=null;
    document.getElementById('reviewArea').innerHTML='';
    document.getElementById('results').innerHTML='';
    document.getElementById('debugInfo').style.display='none';
    document.getElementById('debugInfo').innerHTML='';
    document.getElementById('loading').style.display='none';
    toast('Results discarded.','info');
}

