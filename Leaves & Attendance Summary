/* Firebase Realtime Database keys cannot contain '.', '#', '$', '/', '[', ']'.
   Employee names routinely contain periods (e.g. "MD. Shafayet Hossain"), and
   manualLeaves is keyed BY employee name — so writing it as-is silently fails
   with a permission/validation error from Firebase. Encode/decode names only
   at the Firebase read/write boundary; in-memory code keeps using real names. */
function _fbKeyEncode(name){
    return String(name).replace(/\./g,'%2E').replace(/#/g,'%23').replace(/\$/g,'%24').replace(/\//g,'%2F').replace(/\[/g,'%5B').replace(/\]/g,'%5D');
}
function _fbKeyDecode(key){
    return String(key).replace(/%2E/g,'.').replace(/%23/g,'#').replace(/%24/g,'$').replace(/%2F/g,'/').replace(/%5B/g,'[').replace(/%5D/g,']');
}
function _encodeManualLeavesMonth(monthObj){
    if(!monthObj||typeof monthObj!=='object')return monthObj;
    var out={};
    Object.keys(monthObj).forEach(function(n){out[_fbKeyEncode(n)]=monthObj[n];});
    return out;
}
function _decodeManualLeavesMonth(monthObj){
    if(!monthObj||typeof monthObj!=='object')return monthObj;
    var out={};
    Object.keys(monthObj).forEach(function(n){out[_fbKeyDecode(n)]=monthObj[n];});
    return out;
}
function _decodeAllManualLeaves(all){
    if(!all||typeof all!=='object')return {};
    var out={};
    Object.keys(all).forEach(function(mk){out[mk]=_decodeManualLeavesMonth(all[mk]);});
    return out;
}

