function ensureArray(v){
    if(Array.isArray(v))return v;
    if(v===null||v===undefined)return[];
    if(typeof v==='object'){
        var k=Object.keys(v);
        if(!k.length)return[];
        if(k.every(function(x){return/^\d+$/.test(x)&&parseInt(x)>=0;})){
            k.sort(function(a,b){return parseInt(a)-parseInt(b);});
            return k.map(function(x){return v[x];});
        }
    }
    return [];
}

