/* ═══════════════════════════════════════════════════
   PARSE LEAVES BY TYPE (Annual vs Sick) - UPDATED
   ═══════════════════════════════════════════════════ */
function getLeavesCount(leavesStr, type) {
    var str = String(leavesStr || '').trim();
    if(!str) return 0;

    /* Has a bracketed list: parse each item individually so that mixed-type
       strings (annual + sick in the same bracket) are tallied correctly
       for each type independently. */
    var listMatch = str.match(/\[([\s\S]*?)\]/);
    if(listMatch) {
        var rawItems = listMatch[1].split(',').map(function(s){ return s.trim(); }).filter(Boolean);
        var total = 0;
        rawItems.forEach(function(item) {
            /* Skip Exchanged days — not deducted from any leave type */
            if(/[\(\{]exchanged[\)\}]/i.test(item)) return;
            var isSick = /[\(\{]sick[\)\}]/i.test(item);
            if(type === 'sick'   && !isSick) return;
            if(type === 'annual' &&  isSick) return;
            /* For annual: skip items whose date part has other parenthetical notes
               like "(exchanged)", "(lieu)", etc. */
            if(type === 'annual') {
                var stripped = item.replace(/[\(\{]annual[\)\}]/gi,'').replace(/[\(\{]sick[\)\}]/gi,'').trim();
                var withoutPrefix = stripped.replace(/^\d+(?:\.\d+)?:/, '').trim();
                if(/\([^)]*\)/.test(withoutPrefix)) return;
            }
            /* Extract fractional count from storage "count:date" OR display "(count) date" prefix */
            var core = item.replace(/[\(\{]sick[\)\}]/gi,'').replace(/[\(\{]annual[\)\}]/gi,'').trim();
            var cm = core.match(/^(\d+(?:\.\d+)?):(.+)/);
            if(cm){ total += parseFloat(cm[1]); }
            else { var pm2=core.match(/^\((\d+(?:\.\d+)?)\)\s*(.+)/); total += pm2?parseFloat(pm2[1]):1; }
        });
        return total;
    }

    /* No brackets: plain number or bare string */
    var isSickEntry = /[\(\{]sick[\)\}]/i.test(str);
    if(type === 'sick'   && !isSickEntry) return 0;
    if(type === 'annual' &&  isSickEntry) return 0;
    if(type === 'annual' && /\([^)]*\)/.test(str)) return 0;

    var num = parseFloat(str);
    return isNaN(num) ? 0 : num;
}


/* ═══════════════════════════════════════════════════
   Leave Date Helpers
   ═══════════════════════════════════════════════════ */
var MONTH_ABBR_TO_FULL = {'Jan':'January','Feb':'February','Mar':'March','Apr':'April','May':'May','Jun':'June','Jul':'July','Aug':'August','Sep':'September','Oct':'October','Nov':'November','Dec':'December'};
var MONTH_FULL_TO_ABBR = {'january':'Jan','february':'Feb','march':'Mar','april':'Apr','may':'May','june':'Jun','july':'Jul','august':'Aug','september':'Sep','october':'Oct','november':'Nov','december':'Dec'};

function parseLeaveDateItems(str) {
    str = String(str || '').trim();
    if (!str || str === '0') return [];
    var match = str.match(/\[([\s\S]*?)\]/);
    if (!match) return [];
    var items = match[1].split(',').map(function(s){ return s.trim(); }).filter(Boolean);
    return items.map(function(item) {
        var exchanged = /[\(\{]exchanged[\)\}]/i.test(item);
        var sick = /[\(\{]sick[\)\}]/i.test(item);
        var date = item.replace(/[\(\{]sick[\)\}]/gi, '').replace(/[\(\{]annual[\)\}]/gi, '').replace(/[\(\{]exchanged[\)\}]/gi, '').trim();
        var count = 1;
        /* Storage format:  "0.5:29 Jun" */
        var cm = date.match(/^(\d+(?:\.\d+)?):(.+)/);
        if(cm){ count = parseFloat(cm[1]); date = cm[2].trim(); }
        else {
            /* Display / user-typed format: "(0.5) 29 Jun" */
            var pm = date.match(/^\((\d+(?:\.\d+)?)\)\s*(.+)/);
            if(pm){ count = parseFloat(pm[1]); date = pm[2].trim(); }
        }
        /* Normalize leading zeros on day number: "08 Jun" → "8 Jun" */
        date = date.replace(/^0*(\d+)/, '$1');
        return { date: date, sick: sick, exchanged: exchanged, count: count };
    }).filter(Boolean);
}

function expandMonthAbbr(dateStr) {
    return dateStr.replace(/\b(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\b/gi, function(m) {
        var key = m.charAt(0).toUpperCase() + m.slice(1).toLowerCase();
        return MONTH_ABBR_TO_FULL[key] || m;
    });
}

function formatLeavesForSummary(str) {
    str = String(str || '').trim();
    if(!str || str === '0') return str;
    var listMatch = str.match(/\[([\s\S]*?)\]/);
    if(!listMatch) return str;
    var items = listMatch[1].split(',').map(function(s){ return s.trim(); }).filter(Boolean);
    /* Parse all items */
    var parsed = items.map(function(item){
        var sick = /[\(\{]sick[\)\}]/i.test(item);
        var exchanged = /[\(\{]exchanged[\)\}]/i.test(item);
        item = item.replace(/[\(\{]sick[\)\}]/gi,'').replace(/[\(\{]annual[\)\}]/gi,'').replace(/[\(\{]exchanged[\)\}]/gi,'').trim();
        var count = 1;
        /* Storage format: "0.5:29 Jun" */
        var cm = item.match(/^(\d+(?:\.\d+)?):(.+)/);
        if(cm){ count = parseFloat(cm[1]); item = cm[2].trim(); }
        else {
            /* Display / user-typed format: "(0.5) 29 Jun" */
            var pm = item.match(/^\((\d+(?:\.\d+)?)\)\s*(.+)/);
            if(pm){ count = parseFloat(pm[1]); item = pm[2].trim(); }
        }
        return { sick: sick, exchanged: exchanged, count: count, date: item };
    });
    /* Deduplicate by date — sick > exchanged > annual priority */
    var seenIdx = {};
    var deduped = [];
    parsed.forEach(function(entry){
        /* Normalize leading zeros: "08 Jun" → "8 jun" so they match "8 Jun" */
        var key = entry.date.toLowerCase().trim().replace(/^0*(\d+)/, '$1');
        if(seenIdx[key] !== undefined){
            if(entry.sick) deduped[seenIdx[key]] = entry;
            else if(entry.exchanged && !deduped[seenIdx[key]].sick) deduped[seenIdx[key]] = entry;
        } else {
            seenIdx[key] = deduped.length;
            deduped.push(entry);
        }
    });
    /* Sort by day number so dates display in order: 8, 9, 10 … 30 */
    deduped.sort(function(a, b){
        return parseInt(a.date, 10) - parseInt(b.date, 10);
    });
    var formatted = deduped.map(function(entry){
        var countPrefix = (entry.count !== 1) ? '(' + entry.count + ') ' : '';
        if(entry.exchanged) return countPrefix + entry.date + ' {Exchanged}';
        return countPrefix + entry.date + (entry.sick ? ' {sick}' : ' {Annual}');
    });
    /* Total excludes {Exchanged} days — they are not deducted */
    var total = deduped.filter(function(e){ return !e.exchanged; }).reduce(function(s, e){ return s + e.count; }, 0);
    var totalStr = Number.isInteger(total) ? String(total) : total.toFixed(1);
    return totalStr + ' [' + formatted.join(', ') + ']';
}

function manualDatesToLeavesStr(input) {
    if (!input || !input.trim()) return '0';
    var items = input.split(',').map(function(s){ return s.trim(); }).filter(Boolean);
    if (!items.length) return '0';
    var formatted = items.map(function(item) {
        var sick = /[\(\{]sick[\)\}]/i.test(item);
        item = item.replace(/[\(\{]sick[\)\}]/gi, '').trim();
        item = item.replace(/\b(january|february|march|april|may|june|july|august|september|october|november|december)\b/gi, function(m) {
            return MONTH_FULL_TO_ABBR[m.toLowerCase()] || m;
        });
        return item + (sick ? ' (sick)' : '');
    });
    return formatted.length + ' [' + formatted.join(', ') + ']';
}


/* ═══════════════════════════════════════════════════
   Remaining Leaves UI
   ═══════════════════════════════════════════════════ */
function showRemainingLeaves(){
    // 1. Get selected type (Annual or Sick)
    var typeSel = document.getElementById('leaveTypeSel');
    var type = typeSel ? typeSel.value : 'annual';
    
    // 2. Set Limits
    var ANNUAL_LIMIT = 10;
    var SICK_LIMIT = 14;
    var limit = (type === 'annual') ? ANNUAL_LIMIT : SICK_LIMIT;
    
    // 3. Calculate Financial Year (April - March) for BOTH types
    var now = new Date(), cy = now.getFullYear(), cm = now.getMonth() + 1;
    var lyStart = (cm >= 4) ? cy : cy - 1;
    var lyEnd = lyStart + 1;
    var lyLabel = 'April ' + lyStart + ' – March ' + lyEnd;

    var leaveMonthKeys = [];
    for(var m=4; m<=12; m++) leaveMonthKeys.push(lyStart + '-' + String(m).padStart(2,'0'));
    for(var m=1; m<=3; m++) leaveMonthKeys.push(lyEnd + '-' + String(m).padStart(2,'0'));

    // 4. Aggregate data — from processed summaries AND manual leaves
    var emp = {};

    // 4b. Read from D.manualLeaves for ALL months.
    // Leave data is written here only when "Save to Summary" is pressed.
    // _empSeenDates tracks which dates have already been counted per employee
    // to prevent cross-month duplicate entries from being counted/displayed twice.
    var _empSeenDates={};
    leaveMonthKeys.forEach(function(mk){
        var ml=D.manualLeaves[mk];
        if(!ml||typeof ml!=='object')return;
        Object.keys(ml).forEach(function(n){
            if(!n)return;
            if(!emp[n])emp[n]={used:0,dateList:[]};
            if(!_empSeenDates[n])_empSeenDates[n]={};
            var leavesStr=ml[n]||'0';
            var dateItems=parseLeaveDateItems(leavesStr);
            dateItems.forEach(function(item){
                if(item.exchanged)return;
                if(type==='sick'&&!item.sick)return;
                if(type==='annual'&&item.sick)return;
                /* Deduplicate: skip if this date was already counted for this employee
                   (same date can appear in multiple months' entries after a cross-month save) */
                var dateKey=(item.date||''). toLowerCase().trim().replace(/^0+(\d)/,'$1');
                if(!dateKey||_empSeenDates[n][dateKey])return;
                _empSeenDates[n][dateKey]=true;
                emp[n].used+=(item.count||1);
                emp[n].dateList.push({date:item.date,sick:item.sick,count:item.count||1});
            });
        });
    });

    /* also register employees who appear but took 0 leave this year */
    leaveMonthKeys.forEach(function(mk){
        if(!D.summaries[mk])return;
        ensureArray(D.summaries[mk].results).forEach(function(r){
            var n=(r.name||'').trim();if(n&&!emp[n])emp[n]={used:0,dateList:[]};
        });
    });
    leaveMonthKeys.forEach(function(mk){
        var ml=D.manualLeaves[mk];
        if(!ml||typeof ml!=='object')return;
        Object.keys(ml).forEach(function(n){if(n&&!emp[n])emp[n]={used:0,dateList:[]};});
    });
    /* Seed from persistent roster — ensures employees remain visible even after their
       months are deleted from the Monthly Attendance Summary */
    D.knownEmployees.forEach(function(n){if(n&&!emp[n])emp[n]={used:0,dateList:[]};});

    /* Build ex-employees lookup set for quick filtering */
    var exSet={};
    var exEntryMap={}; /* name → entry for display */
    D.exEmployees.forEach(function(e){exSet[e.name]=true;exEntryMap[e.name]=e;});

    /* Separate active and ex-employees */
    var allNames=Object.keys(emp).sort();
    var activeNames=allNames.filter(function(n){return!exSet[n];});
    var exNames=allNames.filter(function(n){return exSet[n];});

    var ct=document.getElementById('leaveRemBody');
    if(!ct)return;
    var lbl=document.getElementById('leaveYearLabel');
    if(lbl)lbl.textContent=lyLabel;

    if(!allNames.length){ct.innerHTML='<div class="no-data">No attendance records found for '+lyLabel+'.</div>';return;}

    var h='<table><thead><tr><th>Employee Name</th><th style="text-align:center;width:110px">Used Leaves</th><th style="text-align:center;width:130px">Remaining Leaves</th><th>Months on Leave</th></tr></thead><tbody>';

    activeNames.forEach(function(n){
        var e=emp[n],used=e.used,rem=limit-used;
        var displayUsed = Number.isInteger(used) ? used : used.toFixed(1);
        var displayLimit = Number.isInteger(limit) ? limit : limit.toFixed(1);
        var displayRem = Number.isInteger(rem) ? rem : rem.toFixed(1);

        var remColor=rem<=0?'var(--danger)':rem<=3?'#d97706':'var(--success)';
        var remBg=rem<=0?'#fef2f2':rem<=3?'#fffbeb':'#f0fdf4';
        var remTxt=rem<=0?displayRem+' (Exceeded)':String(displayRem);

        // Format actual leave dates for display (3-letter month, fractional count prefix)
        // Sort chronologically within the fiscal year (Apr → Mar), then by day
        var _mnSortRL={jan:1,feb:2,mar:3,apr:4,may:5,jun:6,jul:7,aug:8,sep:9,oct:10,nov:11,dec:12};
        var sortedDateList = e.dateList.slice().sort(function(a,b){
            var am=a.date.match(/[a-zA-Z]+/), bm=b.date.match(/[a-zA-Z]+/);
            var aMonth=am?(_mnSortRL[am[0].toLowerCase()]||0):0, bMonth=bm?(_mnSortRL[bm[0].toLowerCase()]||0):0;
            var aFy=(aMonth>=4)?aMonth-4:aMonth+8, bFy=(bMonth>=4)?bMonth-4:bMonth+8;
            if(aFy!==bFy) return aFy-bFy;
            var aDay=parseInt(a.date)||0, bDay=parseInt(b.date)||0;
            return aDay-bDay;
        });
        var datesDisplay = sortedDateList.map(function(item){
            var c = item.count || 1;
            return c !== 1 ? c + ' (' + item.date + ')' : item.date;
        }).join(', ') || '\u2014';

        h+='<tr>';
        h+='<td>'+n;
        if(isAdmin){
            h+='<span class="emp-remove-btn" onclick="hideEmployee(\''+n.replace(/'/g,"\\'")+ '\')" title="Remove employee (left company)">&#10005;</span>';
        }
        h+='</td>';
        h+='<td style="text-align:center;">'+displayUsed+' / '+displayLimit+'</td>';
        h+='<td style="text-align:center;"><span style="font-weight:700;color:'+remColor+';background:'+remBg+';padding:2px 10px;border-radius:10px;">'+remTxt+'</span></td>';
        if(isAdmin){
            /* Always clickable for admin — calendar handles month navigation internally */
            var _cellMk = '';
            /* Fall back to most recent available fiscal month */
            for(var _fi=leaveMonthKeys.length-1;_fi>=0;_fi--){
                if(D.summaries[leaveMonthKeys[_fi]]||D.manualLeaves[leaveMonthKeys[_fi]]){_cellMk=leaveMonthKeys[_fi];break;}
            }
            if(!_cellMk) _cellMk = leaveMonthKeys[leaveMonthKeys.length-1]||leaveMonthKeys[0]||'';
            h+='<td class="ec" data-emp="'+n.replace(/"/g,'&quot;')+'" data-mk="'+_cellMk+'" data-type="'+type+'" onclick="editLeaveCell(this)" style="color:var(--text-muted);font-size:12px;cursor:pointer;" title="Click to edit leave dates"><i class="fas fa-calendar-alt" style="opacity:.35;font-size:10px;margin-right:3px"></i>'+datesDisplay+'</td>';
        } else {
            h+='<td style="color:var(--text-muted);font-size:12px;">'+datesDisplay+'</td>';
        }
        h+='</tr>';
    });

    h+='</tbody></table>';

    var typeText = (type === 'annual') ? 'Annual' : 'Sick';
    h+='<div style="margin-top:10px;font-size:11px;color:var(--text-muted)"><i class="fas fa-info-circle"></i> '+typeText+' entitlement: <b>'+limit+' days</b> per employee &nbsp;|&nbsp; Leave year: <b>'+lyLabel+'</b>';

    if(type === 'annual') {
        h+=' &nbsp;|&nbsp; Dates with parenthetical notes (Sick, exchanged, etc.) are not counted.';
    } else {
        h+=' &nbsp;|&nbsp; Only days marked specifically as <b>(Sick)</b> are counted.';
    }
    h+='</div>';

    var _now=new Date();
    var _months=['January','February','March','April','May','June','July','August','September','October','November','December'];
    var _latestProcessed=null;
    leaveMonthKeys.forEach(function(mk){
        if(D.summaries[mk]&&D.summaries[mk].processedAt){
            var _pa=new Date(D.summaries[mk].processedAt);
            if(!_latestProcessed||_pa>_latestProcessed)_latestProcessed=_pa;
        }
    });
    var _lastUpd=_latestProcessed?(_latestProcessed.getDate()+' '+_months[_latestProcessed.getMonth()]+' '+_latestProcessed.getFullYear()):'\u2014';
    var _nextWD=getFirstWorkingDay(_now.getMonth()===11?_now.getFullYear()+1:_now.getFullYear(),_now.getMonth()===11?0:_now.getMonth()+1);
    var _nextUpd=_nextWD.getDate()+' '+_months[_nextWD.getMonth()]+' '+_nextWD.getFullYear();
    h+='<div style="margin-top:5px;font-size:11px;color:var(--text-muted)"><i class="fas fa-clock"></i> Last updated: <b>'+_lastUpd+'</b> &nbsp;|&nbsp; Next update: <b>'+_nextUpd+'</b></div>';

    if(isAdmin){
        h+='<div style="margin-top:6px;font-size:11px;color:var(--brand);padding:6px 10px;background:var(--brand-light);border-radius:6px;border:1px solid #a8d5ba"><i class="fas fa-calendar-alt"></i> <b>Admin:</b> Click any name in <b>Months on Leave</b> to open a date-picker and add/remove leave dates. Use <b>Ann / Sick / &frac12;</b> per date. Data saves directly to Firebase and persists across page reloads.</div>';
    }

    /* Former Employees section (admin only) */
    if(isAdmin&&exNames.length){
        h+='<div class="ex-emp-section">';
        h+='<div class="ex-title"><i class="fas fa-user-slash"></i> Former Employees ('+exNames.length+')</div>';
        var _now=Date.now();
        var _mNames=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        exNames.forEach(function(n){
            var e=emp[n],used=e.used,rem=limit-used;
            var displayUsed = Number.isInteger(used) ? used : used.toFixed(1);
            var displayRem = Number.isInteger(rem) ? rem : rem.toFixed(1);
            var remTxt=rem<=0?displayRem+' (Exceeded)':String(displayRem);
            var entry=exEntryMap[n]||{deletedAt:0};
            var deletedAt=entry.deletedAt||0;
            var expiresAt=deletedAt+THIRTY_DAYS_MS;
            var msLeft=expiresAt-_now;
            var dlClass,timeLeftStr;
            if(msLeft<=0){
                dlClass='urgent';timeLeftStr='Expired';
            }else{
                var _tHrs=Math.floor(msLeft/(60*60*1000));
                var _tDays=Math.floor(_tHrs/24);
                var _remHrs=_tHrs%24;
                var _remMins=Math.floor((msLeft%(60*60*1000))/(60*1000));
                if(_tDays>7)dlClass='ok';
                else if(_tDays>=1)dlClass='warn';
                else dlClass='urgent';
                if(_tDays>0)timeLeftStr=_tDays+'d '+_remHrs+'h left';
                else if(_tHrs>0)timeLeftStr=_remHrs+'h '+_remMins+'m left';
                else timeLeftStr=_remMins+'m left';
            }
            var _delDate=deletedAt?new Date(deletedAt):null;
            var _expDate=deletedAt?new Date(expiresAt):null;
            var _delStr=_delDate?(_delDate.getDate()+' '+_mNames[_delDate.getMonth()]+' '+_delDate.getFullYear()):'Unknown';
            var _expStr=_expDate?(_expDate.getDate()+' '+_mNames[_expDate.getMonth()]+' '+_expDate.getFullYear()):'—';
            h+='<div class="ex-emp-item">';
            var daysSinceDelete = deletedAt ? Math.floor((_now - deletedAt)/(24*60*60*1000)) : 0;
            var sinceLabel = daysSinceDelete===0?'Today':daysSinceDelete===1?'1 day ago':daysSinceDelete+' days ago';
            h+='<span class="ex-name">'+n+'</span>';
            h+='<span style="font-size:12px;color:var(--text-muted)">Used: '+displayUsed+'/'+limit+' | Remaining: '+remTxt+'</span>';
            h+='<span style="font-size:11px;color:var(--text-muted);white-space:nowrap"><i class="fas fa-calendar-minus" style="color:#ef4444;margin-right:3px"></i>Deleted: <b>'+_delStr+'</b> <span style="color:#6b7280;font-style:italic">('+sinceLabel+')</span>&nbsp;&bull;&nbsp;<i class="fas fa-calendar-times" style="color:#f97316;margin-right:3px"></i>Expires: <b>'+_expStr+'</b></span>';
            h+='<span class="days-left '+dlClass+'" title="Expires: '+_expStr+'"><i class="fas fa-hourglass-half"></i> '+timeLeftStr+'</span>';
            h+='<button class="restore-btn" onclick="restoreEmployee(\''+n.replace(/'/g,"\\'")+ '\')" ><i class="fas fa-undo"></i> Restore</button>';
            h+='</div>';
        });
        h+='</div>';
    }

    ct.innerHTML=h;

}

/* ═══════════════════════════════════════════════════
   Hide / Restore Employee (for Remaining Leaves)
   ═══════════════════════════════════════════════════ */
async function hideEmployee(name){
    if(!isAdmin)return;
    if(!name||!name.trim())return;
    name=name.trim();
    /* Check if already hidden */
    if(D.exEmployees.find(function(e){return e.name===name;})){
        toast(name+' is already removed.','info');
        return;
    }
    var confirmed=await showConfirm('Remove Employee','Remove "'+name+'" from the Remaining Leaves list? This employee will be moved to the Former Employees section and can be restored within 30 days.');
    if(!confirmed)return;
    D.exEmployees.push({name:name,deletedAt:Date.now()});
    await saveExEmployees();
    /* Remove from persistent roster so they don't reappear after the 30-day ex window expires */
    var _ki=D.knownEmployees.indexOf(name);
    if(_ki!==-1){D.knownEmployees.splice(_ki,1);try{await saveKnownEmployees();}catch(e){}}
    showRemainingLeaves();
    toast(name+' moved to Former Employees.','success');
}

async function restoreEmployee(name){
    if(!isAdmin)return;
    if(!name||!name.trim())return;
    name=name.trim();
    var idx=D.exEmployees.findIndex(function(e){return e.name===name;});
    if(idx===-1){
        toast(name+' is not in the removed list.','info');
        return;
    }
    D.exEmployees.splice(idx,1);
    await saveExEmployees();
    /* Re-add to persistent roster so they appear in Remaining Leaves again */
    if(D.knownEmployees.indexOf(name)===-1){D.knownEmployees.push(name);try{await saveKnownEmployees();}catch(e){}}
    showRemainingLeaves();
    toast(name+' restored to the active list.','success');
}

/* ═══════════════════════════════════════════════════
   Edit Leave Cell from Remaining Leaves section
   ═══════════════════════════════════════════════════ */
function editLeaveCell(cell) {
    if(!isAdmin) return;
    var empName = cell.dataset.emp;
    var mk = cell.dataset.mk;
    var type = cell.dataset.type || 'annual';
    if(!empName || !mk) return;

    var mkParts = mk.split('-');
    var mkMonthNum = parseInt(mkParts[1]);

    /* Fiscal-year range */
    var lyS = (mkMonthNum >= 4) ? parseInt(mkParts[0]) : parseInt(mkParts[0]) - 1;
    var lyE = lyS + 1;
    var fyKeys = [];
    for(var _fm=4;_fm<=12;_fm++) fyKeys.push(lyS+'-'+(_fm<10?'0':'')+_fm);
    for(var _fm=1;_fm<=3;_fm++) fyKeys.push(lyE+'-'+(_fm<10?'0':'')+_fm);

    /* Build typeItems — pre-populate calendar from ALL fiscal months.
       Pulls from D.summaries first (Admin processed data), falls back to D.manualLeaves.
       Ensures bare day-numbers get their originating month attached so the calendar
       can resolve them to the correct ISO date without ambiguity. */
    var typeItems = [];
    var _MN_ABBR_PP = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    fyKeys.forEach(function(fmk) {
        var leavesStr = '0';
        if(D.summaries[fmk]) {
            ensureArray(D.summaries[fmk].results).forEach(function(r) {
                if((r.name||'').trim() === empName) leavesStr = r.leaves || '0';
            });
        } else if(D.manualLeaves[fmk] && D.manualLeaves[fmk][empName]) {
            leavesStr = D.manualLeaves[fmk][empName];
        }
        parseLeaveDateItems(leavesStr).forEach(function(item) {
            if(item.exchanged) return;
            if(type === 'annual' && item.sick) return;
            if(type === 'sick' && !item.sick) return;
            var dateStr = item.date;
            /* Bare number ("8") — attach month so _lcDateToISO can resolve it */
            if(!/[a-zA-Z]/.test(dateStr)) {
                var mNum = parseInt(fmk.split('-')[1]) || 0;
                dateStr = dateStr + ' ' + (_MN_ABBR_PP[mNum] || '');
            }
            typeItems.push({ date: dateStr, sick: item.sick, exchanged: false, count: item.count || 1 });
        });
    });

    /* Deduplicate by normalised date key */
    var _ppSeen = {};
    typeItems = typeItems.filter(function(item) {
        var key = item.date.toLowerCase().trim().replace(/^0+(\d)/, '$1');
        if(!key || _ppSeen[key]) return false;
        _ppSeen[key] = true;
        return true;
    });

    cell.style.outline = '2px solid var(--brand)';
    _openLeaveCalendar({
        empName: empName, mk: mk, type: type,
        typeItems: typeItems,
        fyKeys: fyKeys, lyS: lyS, lyE: lyE,
        mkMonthNum: mkMonthNum, mkParts: mkParts,
        onClose: function() { cell.style.outline = ''; }
    });
}


/* ═══════════════════════════════════════════════════
   Leave Calendar Popup — all Firebase, persists across page reloads
   ═══════════════════════════════════════════════════ */
var _lc = {
    ctx: null,
    viewYear: 0,
    viewMonth: 0,
    selected: {},    /* "YYYY-MM-DD" -> {sick:bool, count:1|0.5} */
    minMk: '',
    maxMk: ''
};

var _LC_ABBR  = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
var _LC_FULL  = ['','January','February','March','April','May','June','July','August','September','October','November','December'];
var _LC_MN2NUM = {jan:1,feb:2,mar:3,apr:4,may:5,jun:6,jul:7,aug:8,sep:9,oct:10,nov:11,dec:12};

function _openLeaveCalendar(ctx) {
    _lc.ctx = ctx;
    _lc.minMk = ctx.fyKeys[0];
    _lc.maxMk = ctx.fyKeys[ctx.fyKeys.length - 1];

    /* Pre-populate selected dates from typeItems (aggregated fiscal-year leaves) */
    _lc.selected = {};
    ctx.typeItems.forEach(function(item){
        var isoKey = _lcDateToISO(item.date, ctx.lyS, ctx.lyE);
        if(isoKey) _lc.selected[isoKey] = { sick: !!item.sick, count: item.count || 1 };
    });

    /* Start view at the edit month */
    _lc.viewYear  = parseInt(ctx.mkParts[0]);
    _lc.viewMonth = ctx.mkMonthNum;

    document.getElementById('lcTitle').textContent = 'Edit Leave — ' + ctx.empName;
    document.getElementById('lcTypeBadge').textContent = ctx.type === 'annual' ? 'Annual' : 'Sick';
    document.getElementById('lcOverlay').classList.add('active');
    _lcRender();
}

/* "DD Mon" or "D Mon" -> "YYYY-MM-DD" */
function _lcDateToISO(dateStr, lyS, lyE) {
    if(!dateStr) return null;
    dateStr = dateStr.trim();
    var mm = dateStr.match(/^(\d{1,2})\s+([a-zA-Z]+)/);
    if(!mm) return null;
    var day = parseInt(mm[1], 10);
    var monKey = mm[2].slice(0,3).toLowerCase();
    var monNum = _LC_MN2NUM[monKey];
    if(!monNum) return null;
    var yr = (monNum >= 4) ? lyS : lyE;
    return yr + '-' + String(monNum).padStart(2,'0') + '-' + String(day).padStart(2,'0');
}

/* "YYYY-MM-DD" -> "D Mon" (no leading zero) */
function _lcISOToDisplay(isoKey) {
    var p = isoKey.split('-');
    return parseInt(p[2], 10) + ' ' + (_LC_ABBR[parseInt(p[1], 10)] || '');
}

function _lcNav(dir) {
    var nm = _lc.viewMonth + dir, ny = _lc.viewYear;
    if(nm > 12){ nm = 1; ny++; } if(nm < 1){ nm = 12; ny--; }
    var newMk = ny + '-' + String(nm).padStart(2,'0');
    if(newMk < _lc.minMk || newMk > _lc.maxMk) return;
    _lc.viewYear = ny; _lc.viewMonth = nm;
    _lcRender();
}

function _lcRender() {
    var yr = _lc.viewYear, mo = _lc.viewMonth;
    var curMk = yr + '-' + String(mo).padStart(2,'0');
    var prevMo = (mo===1) ? (yr-1)+'-12' : yr+'-'+String(mo-1).padStart(2,'0');
    var nextMo = (mo===12) ? (yr+1)+'-01' : yr+'-'+String(mo+1).padStart(2,'0');
    document.getElementById('lcPrevBtn').disabled = (prevMo < _lc.minMk);
    document.getElementById('lcNextBtn').disabled = (nextMo > _lc.maxMk);
    document.getElementById('lcMonthLabel').textContent = _LC_FULL[mo] + ' ' + yr;

    /* Gather holidays for this month */
    var holSet = {};
    ensureArray(D.holidays[String(yr)]).forEach(function(h){
        if(h && h.date && h.date.startsWith(curMk+'-')) holSet[h.date] = h.name;
    });

    var firstDow = new Date(yr, mo-1, 1).getDay();
    var lastD    = new Date(yr, mo, 0).getDate();
    var html = '';
    for(var i=0; i<firstDow; i++) html += '<div class="lc-day lc-empty"></div>';

    for(var d=1; d<=lastD; d++) {
        var iso = yr + '-' + String(mo).padStart(2,'0') + '-' + String(d).padStart(2,'0');
        var dow = new Date(yr, mo-1, d).getDay();
        var isWk = (dow===0||dow===6), isHol = !!holSet[iso];
        var sel = _lc.selected[iso];

        var cls = 'lc-day';
        var inner = '<span class="lc-day-num">' + d + '</span>';
        if(sel) {
            cls += sel.sick ? ' lc-sel-sick' : ' lc-sel-annual';
            inner += '<span class="lc-day-tag">' + (sel.sick ? 'Sick' : 'Ann') + '</span>';
            if(sel.count !== 1) inner += '<span class="lc-day-half">' + sel.count + 'd</span>';
        } else if(isHol) {
            cls += ' lc-holiday';
            inner += '<span class="lc-day-tag" style="color:#d97706">Hol</span>';
        } else if(isWk) {
            cls += ' lc-weekend';
        }
        /* Use data-iso attribute to avoid any quoting issues in onclick */
        html += '<div class="' + cls + '" data-iso="' + iso + '" onclick="_lcHandleDay(this)">' + inner + '</div>';
    }

    document.getElementById('lcDays').innerHTML = html;
    _lcRenderList();
}

/* Called by calendar day click — reads iso from data attribute */
function _lcHandleDay(el) {
    var iso = el.dataset.iso;
    if(!iso) return;
    if(_lc.selected[iso]) {
        delete _lc.selected[iso];
    } else {
        _lc.selected[iso] = { sick: (_lc.ctx && _lc.ctx.type === 'sick'), count: 1 };
    }
    _lcRender();
}

