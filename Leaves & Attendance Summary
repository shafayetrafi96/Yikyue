/* Saves the complete D.manualLeaves object in a single Firebase write.
   Used by done() (leave calendar) instead of 12 parallel per-month writes,
   which caused a race condition where the Firebase listener could fire between
   writes and overwrite in-memory state with a stale snapshot. */
async function saveAllManualLeaves(){
    if(!fbReady){toast('Cloud not connected','error');return;}
    savingManualLeaves=true;updateSyncBadge('saving');
    try{
        var raw=D.manualLeaves&&Object.keys(D.manualLeaves).length?JSON.parse(JSON.stringify(D.manualLeaves)):null;
        var data=null;
        if(raw){
            data={};
            Object.keys(raw).forEach(function(mk){data[mk]=_encodeManualLeavesMonth(raw[mk]);});
        }
        /* Always write — even null — so cleared leaves are removed from Firebase
           and cannot reappear from the realtime listener replaying stale cloud state. */
        await db.ref(FB_MANUAL).set(data);
        console.log('[FB] All ManualLeaves saved atomically, keys:', data?Object.keys(data).length:0);
    }catch(e){console.error('[FB] ManualLeaves atomic save failed:',e);toast('Cloud save failed for manual leaves','error');}
    finally{savingManualLeaves=false;updateSyncBadge(fbConnected?'online':'offline');}
}

