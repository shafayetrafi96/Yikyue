/* Overlay the canonical leave data (appState/manualLeaves) onto in-memory
   D.summaries[mk].results[].leaves so all existing render/print code keeps
   working, while Firebase itself only stores leave data in one place. */
function _mergeLeavesIntoSummaries(){
    Object.keys(D.summaries||{}).forEach(function(mk){
        var s=D.summaries[mk];
        if(!s||!Array.isArray(s.results))return;
        var manualMap=D.manualLeaves&&D.manualLeaves[mk]||{};
