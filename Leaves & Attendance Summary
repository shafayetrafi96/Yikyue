    }else{
        var banner=document.getElementById('syncBanner');
        banner.innerHTML='<i class="fas fa-exclamation-triangle"></i> Cloud database not available.';
        banner.className='sync-error';banner.style.display='block';
        try{
            var _cn=localStorage.getItem('companyName_att');if(_cn)companyName=_cn;
            var _ca=localStorage.getItem('companyAddress_att');if(_ca)companyAddress=_ca;
            var _pn=sessionStorage.getItem('prevCN_att');if(_pn)prevCompanyName=_pn;
            var _pa=sessionStorage.getItem('prevCA_att');if(_pa)prevCompanyAddress=_pa;
        }catch(e){}
        updateHeaderDisplay();
    }
    var syncBanner=document.getElementById('syncBanner');
    if(!syncBanner.classList.contains('sync-error'))syncBanner.style.display='none';
    renderHol();populateMonths();showSummary();showRemainingLeaves();updateUI();ssoCheck(function(ok){if(ok){isAdmin=true;updateUI();_backfillKnownEmployees().then(function(){return _backfillManualLeavesSeed();}).then(function(){showRemainingLeaves();}).catch(function(e){console.error('[ssoCheck] backfill failed:',e);});}});
    console.log('[Init] Complete. Holidays:',Object.keys(D.holidays).length,'years | Summaries:',Object.keys(D.summaries).length,'months | Ex-employees:',D.exEmployees.length);
}

