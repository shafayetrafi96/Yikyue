/* ═══════════════════════════════════════════════════
   First Working Day Helper
   ═══════════════════════════════════════════════════ */
function getFirstWorkingDay(year, month){
    var d=new Date(year,month,1);
    while(d.getDay()===0||d.getDay()===6){d.setDate(d.getDate()+1);}
    return d;
}

/* ═══════════════════════════════════════════════════
   Filter a leaves string to only dates in a given month key ("YYYY-MM")
   Prevents cross-month dates leaking into the displayed summary.
   ═══════════════════════════════════════════════════ */
function filterLeavesToMonth(leavesStr, monthKey) {
    if (!monthKey || !leavesStr || leavesStr === '0') return leavesStr;
    var parts = monthKey.split('-');
    if (parts.length < 2) return leavesStr;
    var monthNum = parseInt(parts[1], 10);
    var ABBRS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var targetAbbr = ABBRS[monthNum - 1];
    if (!targetAbbr) return leavesStr;
    var rMonth = new RegExp('\\b' + targetAbbr + '\\b', 'i');

    var listMatch = leavesStr.match(/\[([\s\S]*?)\]/);
    if (!listMatch) return leavesStr; /* plain number — no date list to filter */

    var items = listMatch[1].split(',').map(function(s){ return s.trim(); }).filter(Boolean);
    var filtered = items.filter(function(item) {
        /* Strip labels and count prefix to isolate the date string */
        var cleaned = item
            .replace(/[\(\{]sick[\)\}]/gi, '')
            .replace(/[\(\{]annual[\)\}]/gi, '')
            .replace(/^\d+(?:\.\d+)?:/, '')
            .replace(/^\(\d+(?:\.\d+)?\)\s*/, '')
            .trim();
        return rMonth.test(cleaned);
    });

    if (!filtered.length) return '0';

    /* Recompute total from the filtered subset */
    var total = 0;
    filtered.forEach(function(item) {
        var core = item.replace(/[\(\{]sick[\)\}]/gi,'').replace(/[\(\{]annual[\)\}]/gi,'').trim();
        var cm = core.match(/^(\d+(?:\.\d+)?):(.+)/);
        if (cm) { total += parseFloat(cm[1]); }
        else { var pm = core.match(/^\((\d+(?:\.\d+)?\))\s*(.+)/); total += pm ? parseFloat(pm[1]) : 1; }
    });
    var totalStr = Number.isInteger(total) ? String(total) : total.toFixed(1);
    return totalStr + ' [' + filtered.join(', ') + ']';
}

