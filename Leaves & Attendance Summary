async function deleteSelectedMonth(){
    if(!isAdmin)return;
    var k=document.getElementById('monthSel').value;
    if(!k||!D.summaries[k]){toast('No month selected.','error');return;}
    var label=D.summaries[k].label||k;
    var confirmed=await showConfirm('Delete Month','Delete the attendance summary for "'+label+'"? This cannot be undone.');
    if(!confirmed)return;

    /* Preserve leave data: migrate summary leaves → D.manualLeaves[k] BEFORE deleting
       the summary, so "Remaining Leaves for BD Colleagues" still reflects everything. */
    var resultsToPreserve=ensureArray(D.summaries[k].results);
    if(resultsToPreserve.length){
        if(!D.manualLeaves[k]||typeof D.manualLeaves[k]!=='object') D.manualLeaves[k]={};
        resultsToPreserve.forEach(function(r){
            var n=(r.name||'').trim();
