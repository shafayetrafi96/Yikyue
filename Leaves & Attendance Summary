        var ms2=String(tM).padStart(2,'0');
        hl.forEach(function(h){if(h.date&&h.date.startsWith(tY+'-'+ms2+'-')&&!hols.includes(h.date))hols.push(h.date);});
        /* Exception days: Sat/Sun/holidays treated as regular working days */
        var excs=[];
        if(es.trim()!==''){es.split(',').map(function(d){return parseInt(d.trim());}).filter(function(d){return!isNaN(d);}).forEach(function(dy){excs.push(tY+'-'+String(tM).padStart(2,'0')+'-'+String(dy).padStart(2,'0'));});}
        var emps={};
        ed.forEach(function(row){
            var nm=(row['Name']||'').trim(),id=String(row['ID Number']||'').trim(),do2=row['Date'],ts=row['Time'],dp=row['Department']||row['Dept']||'';
            if(!do2||!ts||!id)return;
            var ds=fmtD(new Date(do2));
            if(!emps[id])emps[id]={name:nm,dept:dp.trim(),wr:wkRule(dp),records:{}};
            else{if((!emps[id].dept||emps[id].dept==='')&&dp&&dp.trim()!==''){emps[id].dept=dp.trim();emps[id].wr=wkRule(dp);}}
            if(!emps[id].records[ds])emps[id].records[ds]=[];
            if(typeof ts==='object'&&ts instanceof Date){
                var hh=ts.getHours(),mi=ts.getMinutes(),ss=ts.getSeconds(),ap=hh>=12?'PM':'AM';
                if(hh>12)hh-=12;if(hh===0)hh=12;
                ts=String(hh).padStart(2,'0')+':'+String(mi).padStart(2,'0')+':'+String(ss).padStart(2,'0')+' '+ap;
            }
            emps[id].records[ds].push(String(ts));
        });
        var mp={},vc=0;
        mr.forEach(function(r){var p=r.dateStr.split('/'),iso=p[2]+'-'+p[1]+'-'+p[0];if(parseInt(p[2])===tY&&parseInt(p[1])===tM){if(!mp[r.id])mp[r.id]=new Set();mp[r.id].add(iso);vc++;}});
        var srcLabel=src==='auto'?'⚡ Movement DB (Auto)':'📄 PDF';
        var dh='<b>Log</b><br>Month: <b>'+tY+'-'+String(tM).padStart(2,'0')+'</b> | Movement Source: <b>'+srcLabel+'</b> | Records matched: <b>'+vc+'</b><br><hr style="border:0;border-top:1px solid #ddf;margin:5px 0">';
        for(var eid in emps){var e=emps[eid];var wrLabel=e.wr==='driver'?'<span style="color:purple">Driver (Fri+Sat+Sun off)</span>':e.wr==='fri'?'<span style="color:green">QA (Fri off)</span>':'<span style="color:blue">Sat+Sun off</span>';dh+='<b>'+e.name+'</b> ('+eid+') &rarr; '+wrLabel+'<br>';}
        db2.innerHTML=dh;db2.style.display='block';
        var results=[],pf=[],fd=new Date(tY,tM-1,1),ld2=new Date(tY,tM,0);
        var procMk=tY+'-'+String(tM).padStart(2,'0');
        /* Build a set of deleted employee names for fast lookup */
        var _exEmpSet={};
        D.exEmployees.forEach(function(ex){if(ex&&ex.name)_exEmpSet[ex.name.trim()]=true;});
        for(var eid2 in emps){
            var e2=emps[eid2],ld3=0,lm=0,wd=[],lv=[],ldArr=[],d=new Date(fd);
            var _empN=(e2.name||'').trim();
            /* Skip deleted (former) employees — do not process their attendance */
            if(_exEmpSet[_empN]) continue;
            /* Build a set of dates already recorded in manual/sick data for this employee this month
               so absent days that are already categorised are not double-counted as new leaves */
            var _manualDates=new Set();
            (function(){
                /* Always read from D.manualLeaves[procMk] — the authoritative source for
                   "Remaining Leaves for BD Colleagues". Any leave date already recorded there
                   (either manually or via a previous "Save to Summary") must not be re-added
                   as a new auto-detected entry in the Review section. */
                if(D.manualLeaves[procMk]&&D.manualLeaves[procMk][_empN]){
                    parseLeaveDateItems(D.manualLeaves[procMk][_empN]).forEach(function(item){
                        _manualDates.add(item.date.toLowerCase());
                    });
                }
            })();
            while(d<=ld2){
                var ds2=fmtD(d),dow=d.getDay();
                var isExc=excs.includes(ds2);
                if(hols.includes(ds2)&&!isExc){
                    /* Public holiday (not overridden as working day):
                       if the employee was present → Holiday Duty (counted in wd)
                       if absent → holiday off, no leave counted */
                    var ha2=e2.records[ds2]&&e2.records[ds2].length>0,hm2=mp[eid2]&&mp[eid2].has(ds2);
                    if(ha2||hm2)wd.push(ds2);
                    d.setDate(d.getDate()+1);continue;
                }
                /* Classify the day for this employee */
                var iw=false;      /* regular weekend (Sat/Sun) — duty credit if present */
                var iDriverOff=false; /* driver off day (Fri+Sat+Sun) — no duty, no leave */
                if(!isExc){
                    if(e2.wr==='satsun'&&(dow===0||dow===6))iw=true;
                    if(e2.wr==='fri'&&dow===5)iw=true;                          /* QA: Fri off, duty credit if present */
                    if(e2.wr==='driver'&&(dow===5||dow===6||dow===0))iDriverOff=true; /* Driver: Fri+Sat+Sun off, no duty */
                }
                var ha=e2.records[ds2]&&e2.records[ds2].length>0,hm=mp[eid2]&&mp[eid2].has(ds2),ip=ha||hm;
                if(iDriverOff){
                    /* Driver off day (Fri/Sat/Sun): ignore completely — no duty, no leave */
                }else if(iw){
                    /* Regular weekend: present = weekend duty, absent = nothing */
                    if(ip)wd.push(ds2);
                }else{
                    /* Regular working day: absent = leave, present = check lateness */
                    if(!ip){
                        /* Skip if this date is already recorded in manual/sick leave data */
                        /* Strip leading zero so "08 Jun"→"8 jun" matches stored "8 jun" */
                        var _ds2Abbr=new Date(ds2+'T00:00:00').toLocaleDateString('en-GB',{day:'2-digit',month:'short'}).toLowerCase().replace(/^0+/,'');
                        if(!_manualDates.has(_ds2Abbr))lv.push(ds2);
                    }
                    else if(ha){
                        var pu=e2.records[ds2].map(function(t){return{timeStr:t,mins:t2m(t)};}).filter(function(t){return t.mins!==null;}).sort(function(a,b){return a.mins-b.mins;});
                        if(pu.length){var f=pu[0];if(f.mins>=PM_LIM)pf.push({name:e2.name,date:ds2,time:f.timeStr});else if(f.mins>LATE_LIM){ld3++;ldArr.push(ds2);lm+=(f.mins-LATE_TH);}}
                    }
                }
                d.setDate(d.getDate()+1);
            }
            var fa=function(arr){if(!arr.length)return'0';return arr.length+' ['+arr.map(function(d2){return new Date(d2+'T00:00:00').toLocaleDateString('en-GB',{day:'2-digit',month:'short'});}).join(', ')+']';};
            results.push({name:e2.name,lateDays:fa(ldArr),lateMins:lm,weekendDuty:fa(wd),leaves:fa(lv)});
        }
        results.sort(function(a,b){return a.name.localeCompare(b.name);});
        pendingResults={results:results,pmFlags:pf,year:tY,month:tM};
        renderReview();
    }catch(err){console.error(err);rd.innerHTML='<div style="color:red">Error: '+err.message+'</div>';toast('Error: '+err.message,'error');}
    finally{ld.style.display='none';}
}

