/* ═══════════════════════════════════════════════════
   Add a BLANK row — no auto-date, no placeholder name
   ═══════════════════════════════════════════════════ */
function addHolRowAt(afterIdx){
    if(!isAdmin)return;
    if(!D.holidays[selYear])D.holidays[selYear]=[];
    var list=ensureArray(D.holidays[selYear]).filter(function(h){return h&&typeof h==='object'&&h.date;});
    D.holidays[selYear]=list;

    /* Insert a fully blank row — user fills in all fields */
    var newRow={date:'',day:'',name:''};

    if(afterIdx===-1){
        list.unshift(newRow);
    }else{
        list.splice(afterIdx+1,0,newRow);
    }

    /* Note: we do NOT sort here because the date is blank.
       Sorting will happen when the user edits and saves the date. */
    D.holidays[selYear]=list;

    saveHolidays();
    renderHol();
    toast('Blank row inserted — click Date and Name to fill in.','info');
}

function editHol(cell){
    if(!isAdmin)return;if(cell.querySelector('input'))return;
    var t=cell.dataset.t,idx=parseInt(cell.dataset.i);
    var list=ensureArray(D.holidays[selYear]).filter(function(h){return h&&typeof h==='object';});
    D.holidays[selYear]=list;var item=list[idx];if(!item)return;
    var cv='',ic='',ph='';
    if(t==='date'){if(item.date){var _dp=item.date.split('-');cv=_dp.length===3?_dp[2]+'/'+_dp[1]+'/'+_dp[0]:'';}else{cv='';}ic='di';ph='dd/mm/yyyy';}
    else if(t==='day'){cv=item.day||'';ic='ni';ph='Day';}
    else{cv=item.name||'';ic='ni';ph='Holiday name';}
    var inp=document.createElement('input');inp.type='text';inp.className=ic;inp.value=cv;inp.placeholder=ph;
    cell.textContent='';cell.appendChild(inp);inp.focus();inp.select();
    function done(){
        var v=inp.value.trim();
        if(t==='date'){
            if(v){
                var iso=d2iso(v);
                if(iso&&!isNaN(new Date(iso+'T00:00:00').getTime())){
                    item.date=iso;
                    try{item.day=new Date(iso+'T00:00:00').toLocaleDateString('en-US',{weekday:'short'});}catch(e){}
                    /* Re-sort by date after editing — skip blank-date rows */
                    list.sort(function(a,b){
                        if(!a.date&&!b.date)return 0;
                        if(!a.date)return 1;
                        if(!b.date)return -1;
                        return a.date.localeCompare(b.date);
                    });
                    D.holidays[selYear]=list;
                }else{toast('Invalid date format. Use dd/mm/yy or dd/mm/yyyy','error');}
            }else{
                item.date='';
            }
        }else if(t==='day'){
            item.day=v;
        }else{
            item.name=v;
        }
        saveHolidays();renderHol();
        updateHolDaysField();
    }
    inp.addEventListener('blur',done);
    inp.addEventListener('keydown',function(e){if(e.key==='Enter')inp.blur();if(e.key==='Escape')renderHol();});
}

function delHol(idx){
    if(!isAdmin)return;
    var l=ensureArray(D.holidays[selYear]).filter(function(h){return h&&typeof h==='object';});
    D.holidays[selYear]=l;l.splice(idx,1);saveHolidays();renderHol();
    updateHolDaysField();
    toast('Deleted.','info');
}
