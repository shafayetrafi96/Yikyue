function setupFBListen(){
    if(!fbReady)return;
    db.ref(FB_HOL).on('value',function(snap){
        if(savingHolidays)return;
        if(!snap.exists())return;
        var d=snap.val();
        if(!d||typeof d!=='object')return;
        for(var yr in d){d[yr]=ensureArray(d[yr]).filter(function(h){return h&&typeof h==='object'&&h.date;});}
        if(JSON.stringify(D.holidays)!==JSON.stringify(d)){
            D.holidays=d;console.log('[FB] Holidays realtime update');renderHol();
            /* Refresh holidays field if admin card is visible */
            updateHolDaysField();
        }
    },function(e){console.error('[FB] Holiday listener error:',e);});

    db.ref(FB_SUM).on('value',function(snap){
        if(savingSummaries)return;
        var d;
        if(!snap.exists()){d={};}
        else{
            d=snap.val();
            if(!d||typeof d!=='object')d={};
        }
        if(justDeletedKey){delete d[justDeletedKey];}
        for(var mk in d){
            if(d[mk]&&typeof d[mk]==='object'){
                d[mk].results=ensureArray(d[mk].results);
                d[mk].pmFlags=ensureArray(d[mk].pmFlags);
            }
        }
        if(JSON.stringify(D.summaries)!==JSON.stringify(d)){
            D.summaries=d;console.log('[FB] Summaries realtime update');
            _mergeLeavesIntoSummaries();
            populateMonths();showSummary();
        }
    },function(e){console.error('[FB] Summary listener error:',e);});

    db.ref(FB_MANUAL).on('value',function(snap){
        if(savingManualLeaves||_blockManualListener)return;
        var d={};
        if(snap.exists()&&snap.val()&&typeof snap.val()==='object')d=_decodeAllManualLeaves(snap.val());
        if(JSON.stringify(D.manualLeaves)!==JSON.stringify(d)){
            D.manualLeaves=d;console.log('[FB] ManualLeaves realtime update');
            _mergeLeavesIntoSummaries();
            showRemainingLeaves();showSummary();
        }
    },function(e){console.error('[FB] ManualLeaves listener error:',e);});

    db.ref(FB_EX).on('value',function(snap){
        if(savingExEmployees)return;
        D.exEmployees=snap.exists()&&snap.val()!==null?_parseExEmployees(snap.val()):[];
        console.log('[FB] Ex-employees realtime update:',D.exEmployees.length);
        showRemainingLeaves();
    },function(e){console.error('[FB] Ex-employees listener error:',e);});

    db.ref(FB_EMP).on('value',function(snap){
        if(savingKnownEmployees)return;
