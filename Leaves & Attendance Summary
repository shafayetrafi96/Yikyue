async function _lcSave() {
    var ctx = _lc.ctx;
    if(!ctx) { document.getElementById('lcOverlay').classList.remove('active'); return; }
    document.getElementById('lcOverlay').classList.remove('active');
    if(ctx.onClose) ctx.onClose();

    /* Commit any count inputs that haven't fired onblur yet */
    document.querySelectorAll('.lc-count-inp').forEach(function(inp) {
        var iso = inp.dataset.iso;
        if(iso && _lc.selected[iso]) {
            var num = parseFloat(inp.value);
            _lc.selected[iso].count = (!inp.value.trim() || isNaN(num) || num <= 0) ? 1 : Math.max(0.5, num);
        }
    });

    var empName     = ctx.empName;
    var type        = ctx.type;
    var fyKeys      = ctx.fyKeys;
    var lyS         = ctx.lyS;
    var selectedISO = _lc.selected;   /* { "YYYY-MM-DD": { sick, count } } */

    _lc.ctx = null; _lc.selected = {};

    /* ── Group selected ISO dates by fiscal-month key ── */
    var byMonth = {};
    fyKeys.forEach(function(mk) { byMonth[mk] = []; });
    Object.keys(selectedISO).forEach(function(iso) {
        var mk = iso.substring(0, 7);   /* "YYYY-MM" */
        if(!byMonth[mk]) byMonth[mk] = [];
        byMonth[mk].push({ iso: iso, sick: selectedISO[iso].sick, count: selectedISO[iso].count || 1 });
    });

    _blockManualListener = true;
    var summaryMonthsChanged = [];

    try {
        fyKeys.forEach(function(fmk) {
            var newDates = byMonth[fmk] || [];

            /* ── Pull current leave string from Admin data first, then manualLeaves ── */
            var existingStr = '0';
            if(D.summaries[fmk]) {
                ensureArray(D.summaries[fmk].results).forEach(function(r) {
                    if((r.name||'').trim() === empName) existingStr = r.leaves || '0';
                });
            } else if(D.manualLeaves[fmk] && D.manualLeaves[fmk][empName]) {
                existingStr = D.manualLeaves[fmk][empName];
            }

            /* Keep items of the OTHER leave type and any {Exchanged} entries untouched */
            var keepItems = parseLeaveDateItems(existingStr).filter(function(item) {
                if(item.exchanged) return true;
                return (type === 'annual') ? item.sick : !item.sick;
            });

            /* Build merged list: preserved items + newly selected dates for this type */
            var merged = keepItems.slice();
            newDates.forEach(function(d) {
                var p = d.iso.split('-');
                merged.push({
                    date    : parseInt(p[2], 10) + ' ' + (_LC_ABBR[parseInt(p[1], 10)] || ''),
                    sick    : (type === 'sick'),
                    exchanged: false,
                    count   : d.count
                });
            });

            /* Serialise to storage format */
            var nlv = '0';
            if(merged.length) {
                var tot = merged
                    .filter(function(i) { return !i.exchanged; })
                    .reduce(function(s, i) { return s + (i.count || 1); }, 0);
                var totStr = Number.isInteger(tot) ? String(tot) : tot.toFixed(1);
                var fmt = merged.map(function(it) {
                    var pfx = (it.count !== 1) ? it.count + ':' : '';
                    if(it.exchanged) return pfx + it.date + ' {Exchanged}';
                    return pfx + it.date + (it.sick ? ' (sick)' : '');
                });
                nlv = totStr + ' [' + fmt.join(', ') + ']';
            }

            /* ── Update D.manualLeaves ── */
            if(!D.manualLeaves[fmk]) D.manualLeaves[fmk] = {};
            if(!nlv || nlv === '0') {
                delete D.manualLeaves[fmk][empName];
                if(!Object.keys(D.manualLeaves[fmk]).length) delete D.manualLeaves[fmk];
            } else {
                D.manualLeaves[fmk][empName] = nlv;
            }

            /* ── Push to D.summaries if Admin has processed this month ──
               This keeps the Attendance Data Processor table in sync. */
            if(D.summaries[fmk]) {
                var rs = ensureArray(D.summaries[fmk].results), found = false;
                for(var ri = 0; ri < rs.length; ri++) {
                    if((rs[ri].name||'').trim() === empName) { rs[ri].leaves = nlv; found = true; break; }
                }
                if(!found && nlv !== '0') {
                    rs.push({ name: empName, lateDays: 0, lateMins: 0, weekendDuty: '0', leaves: nlv });
                    rs.sort(function(a, b) { return (a.name||'').localeCompare(b.name||''); });
                }
                D.summaries[fmk].results = rs;
                summaryMonthsChanged.push(fmk);
            }
        });

        /* ── Atomic write ──
           Leave data lives exclusively in appState/manualLeaves — a single
           Firebase set() covers every month, no race condition, and nothing
           is duplicated into appState/summaries (which never stores .leaves). */
        await saveAllManualLeaves();

        toast('Leave saved for ' + empName, 'success');
    } catch(err) {
        console.error('[LeaveCalendar] Save error:', err);
        toast('Save failed — please try again', 'error');
    } finally {
        _blockManualListener = false;
    }

    populateMonths();
    showSummary();
    showRemainingLeaves();
}


