async function readExcel(file){
    return new Promise(function(res,rej){
        var rd=new FileReader();rd.onload=function(e){
            var d=new Uint8Array(e.target.result);var wb=XLSX.read(d,{type:'array',cellDates:true});
            res(XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]]));
        };rd.onerror=rej;rd.readAsArrayBuffer(file);
    });
}

async function readPDFAtt(file){
    var ab=await file.arrayBuffer(),pdf=await loadPDF(ab),recs=[];
    for(var i=1;i<=pdf.numPages;i++){
        var pg=await pdf.getPage(i),tc=await pg.getTextContent();
        var pt=tc.items.map(function(x){return x.str;}).join(' ');
        var dr=/(\d{2}\/\d{2}\/\d{4})/g,match,dps=[];
        while((match=dr.exec(pt))!==null)dps.push({date:match[1],index:match.index});
        if(!dps.length)continue;dps.push({date:null,index:pt.length});
        for(var j=0;j<dps.length-1;j++){
            var cd=dps[j].date,si=dps[j].index+cd.length,ei=dps[j+1].index;
            var sec=pt.substring(si,ei);
            var ir=/(\d{2}-\d{4})/g,im,ids=new Set();
            while((im=ir.exec(sec))!==null)ids.add(im[1]);
            if(!ids.size&&typeof nameToIdMap!=='undefined'){
                for(var n in nameToIdMap){if(sec.toLowerCase().includes(n))ids.add(nameToIdMap[n]);}
            }
            ids.forEach(function(id){recs.push({id:id,dateStr:cd});});
        }
    }
    return recs;
}

async function processFiles(){
