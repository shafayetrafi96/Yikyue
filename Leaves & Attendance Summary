            /* Only write if there is actual leave data */
            if(lv&&lv!=='0') D.manualLeaves[k][n]=lv;
        });
        try{await saveManualLeaveMonth(k);}catch(e){console.error('[delete] manual leaves preserve failed:',e);}
    }

    justDeletedKey=k;
    delete D.summaries[k];
    try{await deleteSummaryMonthFB(k);}catch(e){console.error('Delete error:',e);}
