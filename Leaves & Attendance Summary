function processHolText(){
    var text=document.getElementById('holText')?document.getElementById('holText').value.trim():'';
    if(!text){toast('Paste or type holiday data first.','error');return;}
    var parsed=parseHolText(text);
    if(!parsed.list.length){
        toast('Could not detect any holidays. Check the format and try again.','error');
        return;
    }
    var yr=String(parsed.year||parseInt(selYear));
    var existing=ensureArray(D.holidays[yr]).filter(function(h){return h&&typeof h==='object'&&h.date;});
    var existingDates={};
    existing.forEach(function(h){existingDates[h.date]=true;});
    var added=0,skipped=0;
    parsed.list.forEach(function(h){
        if(!existingDates[h.date]){
            existing.push(h);
            existingDates[h.date]=true;
            added++;
        }else{
            skipped++;
        }
    });
    existing.sort(function(a,b){return a.date.localeCompare(b.date);});
    D.holidays[yr]=existing;
    selYear=yr;
    document.getElementById('holYearSel').value=selYear;
    saveHolidaysYear(yr);
    renderHol();
    updateHolDaysField();
    if(added===0){
        toast('All '+parsed.list.length+' detected holiday(s) already exist — nothing new added.','info');
    }else if(skipped>0){
        toast(added+' new holiday(s) added! ('+skipped+' duplicate(s) skipped)','success');
    }else{
        toast(added+' holiday(s) saved and sorted by date!','success');
    }
}

function parseHolText(text){
    var hols=[],year=null;
    var ym=text.match(/(\d{4})\s*Public\s+Holidays?/i);if(ym)year=parseInt(ym[1]);
    if(!year){var ym2=text.match(/\b(20\d{2})\b/);if(ym2)year=parseInt(ym2[1]);}
    var M={january:1,jan:1,february:2,feb:2,march:3,mar:3,april:4,apr:4,may:5,june:6,jun:6,july:7,jul:7,august:8,aug:8,september:9,sep:9,october:10,oct:10,november:11,nov:11,december:12,dec:12};
    var DF=['sunday','monday','tuesday','wednesday','thursday','friday','saturday','sun','mon','tue','wed','thu','fri','sat'];
    function tryDate(s){
        s=s.trim();
        var dm=s.match(/^(\d{1,2})[\/\-\.](\d{1,2})[\/\-\.](\d{4})$/);if(dm)return{day:parseInt(dm[1]),month:parseInt(dm[2]),year:parseInt(dm[3])};
        for(var m in M){var r=new RegExp('^(\\d{1,2})\\s+'+m+'(?:\\s+(\\d{4}))?$','i');var ma=s.match(r);if(ma)return{day:parseInt(ma[1]),month:M[m],year:ma[2]?parseInt(ma[2]):null};}
        for(var m2 in M){var r2=new RegExp('^'+m2+'\\s+(\\d{1,2})(?:[,]?\\s+(\\d{4}))?$','i');var ma2=s.match(r2);if(ma2)return{day:parseInt(ma2[1]),month:M[m2],year:ma2[2]?parseInt(ma2[2]):null};}
        return null;
    }
    function isDay(s){var cl=s.trim().toLowerCase().replace(/[^a-z]/g,'');if(!cl)return false;for(var i=0;i<DF.length;i++){if(cl===DF[i])return true;}return false;}

    var lines=text.split(/\n/).map(function(l){return l.trim();}).filter(function(l){return l.length>1;});
    for(var i=0;i<lines.length;i++){
        var line=lines[i],dateInfo=null,dayName='',holName='';
        var dateMatch=line.match(/(\d{1,2}[\/\-\.]\d{1,2}[\/\-\.]\d{4})/);
        if(!dateMatch){
            for(var m in M){
                var r=new RegExp('(\\d{1,2}\\s+'+m+'(?:\\s+\\d{4})?)','i');
                var ma=line.match(r);if(ma){dateMatch=ma;break;}
            }
        }
        if(!dateMatch){
            for(var m2 in M){
                var r2=new RegExp('('+m2+'\\s+\\d{1,2}(?:[,]?\\s+(\\d{4}))?)','i');
                var ma2=line.match(r2);if(ma2){dateMatch=ma2;break;}
            }
        }
        if(dateMatch){
            dateInfo=tryDate(dateMatch[0]);
            var rem=line.replace(dateMatch[0],'').replace(/[\(\)\-\|]/g,' ').trim();
            var words=rem.split(/\s+/).filter(function(w){return w.length>0;});
            var dayIdx=-1;
            for(var wi=0;wi<words.length;wi++){
                if(isDay(words[wi])){
                    dayName=words[wi].charAt(0).toUpperCase()+words[wi].slice(1).toLowerCase();
                    dayIdx=wi;
                    break;
                }
            }
            var nameParts=[];
            for(var wi2=0;wi2<words.length;wi2++){
                if(wi2===dayIdx)continue;
                var w=words[wi2].trim();
                if(!w)continue;
                if(/^(20\d{2})$/.test(w))continue;
                if(/^\d{1,2}\.?$/.test(w))continue;
                nameParts.push(w);
            }
            holName=nameParts.join(' ').trim().replace(/^[\-\,\.]+\s*/,'').replace(/[\-\,\.]+$/,'').trim();
        }
        if(dateInfo&&!holName&&i+1<lines.length){
            var nxt=lines[i+1].trim();
            var hasDate=false;
            if(nxt.match(/\d{1,2}[\/\-\.]\d{1,2}[\/\-\.]\d{4}/))hasDate=true;
            if(!hasDate){
                for(var m3 in M){if(nxt.toLowerCase().includes(m3)&&nxt.match(/\d/)){hasDate=true;break;}}
            }
            if(!hasDate&&!/^\d+$/.test(nxt))holName=nxt;
        }
        if(dateInfo&&dateInfo.day>=1&&dateInfo.day<=31&&dateInfo.month>=1&&dateInfo.month<=12){
            var fy=dateInfo.year||year||parseInt(selYear);
            if(!dayName){
                try{
                    var dobj=new Date(fy,dateInfo.month-1,dateInfo.day);
                    if(!isNaN(dobj.getTime()))dayName=dobj.toLocaleDateString('en-US',{weekday:'short'});
                }catch(e){}
            }
            var iso=fy+'-'+String(dateInfo.month).padStart(2,'0')+'-'+String(dateInfo.day).padStart(2,'0');
            var dup=false;for(var h=0;h<hols.length;h++){if(hols[h].date===iso){dup=true;break;}}
            if(!dup){
                hols.push({date:iso,day:dayName||'--',name:holName||'Holiday'});
                if(!year)year=fy;
            }
        }
    }
    hols.sort(function(a,b){return a.date.localeCompare(b.date);});
    return{year:year,list:hols};
}

