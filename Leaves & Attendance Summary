        }
    }
    if(D.summaries&&typeof D.summaries==='object'){
        for(var mk in D.summaries){
            var sm=D.summaries[mk];
            if(sm&&typeof sm==='object'){
                if(sm.results)sm.results=ensureArray(sm.results);
                if(sm.pmFlags)sm.pmFlags=ensureArray(sm.pmFlags);
            }
        }
    }
    /* Ensure manualLeaves is a valid object */
    if(!D.manualLeaves||typeof D.manualLeaves!=='object'){D.manualLeaves={};}

    /* Ensure exEmployees is a valid array of {name,deletedAt} objects */
    if(!Array.isArray(D.exEmployees)){D.exEmployees=[];}
    D.exEmployees=_parseExEmployees(D.exEmployees);
