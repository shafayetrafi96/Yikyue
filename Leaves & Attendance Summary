<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YIK YUE Attendance Processor</title>
    <script src="https://cdn.sheetjs.com/xlsx-0.20.0/package/dist/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
    <style>
        :root{--brand:#0A4038;--brand-dark:#072e27;--brand-light:#e0efed;--bg:#f4f6f9;--card:#fff;--text:#1a1a1a;--text-muted:#656d76;--border:#d0d7de;--success:#1a7f37;--danger:#cf222e}
        *{box-sizing:border-box;margin:0;padding:0}
        body{font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;background:var(--bg);color:var(--text);min-height:100vh}
        .page-wrap{max-width:1280px;margin:0 auto;padding:16px 16px 48px}
        .app-header{background:var(--brand);color:#fff;padding:16px 24px;border-radius:10px 10px 0 0;display:flex;justify-content:space-between;align-items:center;box-shadow:0 3px 12px rgba(0,0,0,.2);gap:12px}
        .header-left h1{font-size:20px;font-weight:700;letter-spacing:.5px;margin:0}
        .header-left p{font-size:12px;opacity:.9;margin:2px 0 0}
        .header-right{display:flex;align-items:center;gap:10px;flex-shrink:0;flex-wrap:wrap}
        .admin-btn{background:#fff;color:var(--brand);padding:8px 16px;border-radius:6px;font-weight:700;font-size:13px;border:none;cursor:pointer;font-family:inherit;display:flex;align-items:center;gap:6px;box-shadow:0 1px 3px rgba(0,0,0,.1);transition:background .2s}
        .admin-btn:hover{background:#e8e8e8}
        .admin-badge-h{background:rgba(255,255,255,.15);color:#fff;padding:5px 12px;border-radius:16px;font-size:12px;font-weight:600;display:flex;align-items:center;gap:5px}
        .logout-btn{background:rgba(255,255,255,.1);color:rgba(255,255,255,.85);padding:7px 14px;border-radius:6px;font-weight:600;cursor:pointer;font-size:12px;font-family:inherit;border:1px solid rgba(255,255,255,.2);transition:all .2s}
        .logout-btn:hover{background:rgba(255,255,255,.2)}
        .sync-badge{padding:4px 10px;border-radius:12px;font-size:11px;font-weight:600;display:flex;align-items:center;gap:5px;white-space:nowrap}
        .sync-badge.online{background:rgba(34,197,94,.25);color:#bbf7d0}
        .sync-badge.offline{background:rgba(239,68,68,.25);color:#fecaca}
        .sync-badge.saving{background:rgba(234,179,8,.25);color:#fef08a}
        .modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;justify-content:center;align-items:center}
        .modal-overlay.active{display:flex}
        .modal{background:#fff;padding:24px;border-radius:10px;width:340px;box-shadow:0 12px 40px rgba(0,0,0,.2)}
        .modal h3{font-size:18px;font-weight:700;color:var(--brand-dark);margin:0 0 16px}
        .modal input[type="password"]{width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:6px;font-size:14px;margin-bottom:8px;outline:none;font-family:inherit}
        .modal input[type="password"]:focus{border-color:var(--brand);box-shadow:0 0 0 2px rgba(10,64,56,.15)}
        .modal .err{color:var(--danger);font-size:13px;margin-bottom:8px;display:none}
        .modal p.msg{font-size:14px;color:#374151;margin-bottom:16px;line-height:1.5}
        .modal-act{display:flex;gap:8px;justify-content:flex-end}
        .modal-act button{padding:8px 18px;border-radius:6px;font-weight:600;cursor:pointer;font-size:14px;border:none;font-family:inherit}
        .m-cancel{background:#d1d5db;color:#374151}.m-cancel:hover{background:#b0b5bc}
        .m-ok{background:var(--brand);color:#fff}.m-ok:hover{background:var(--brand-dark)}
        .m-danger{background:var(--danger);color:#fff}.m-danger:hover{background:#a40e26}
        .card{background:var(--card);padding:20px 24px;box-shadow:0 1px 6px rgba(0,0,0,.06);margin-bottom:16px;border:1px solid #e5e7eb;border-top:none}
        .card:first-of-type{border-top:1px solid #e5e7eb}
        .card-title{font-size:16px;font-weight:700;margin-bottom:14px;padding-bottom:10px;border-bottom:2px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
        .card-title .title-actions{display:flex;gap:8px;align-items:center}
        .print-btn{background:var(--brand);color:#fff;border:none;padding:6px 14px;border-radius:6px;font-weight:600;cursor:pointer;font-size:12px;font-family:inherit;display:flex;align-items:center;gap:5px;transition:background .2s}
        .print-btn:hover{background:var(--brand-dark)}
        .copy-btn{background:#2563eb;color:#fff;border:none;padding:6px 14px;border-radius:6px;font-weight:600;cursor:pointer;font-size:12px;font-family:inherit;display:flex;align-items:center;gap:5px;transition:background .2s}
        .copy-btn:hover{background:#1d4ed8}
        .copy-btn:active{background:#1e3a8a}
        .del-month-btn{background:var(--danger);color:#fff;border:none;padding:6px 14px;border-radius:6px;font-weight:600;cursor:pointer;font-size:12px;font-family:inherit;display:flex;align-items:center;gap:5px;transition:background .2s}
        .del-month-btn:hover{background:#a40e26}
        .del-month-btn.hide{display:none!important}
        .sel-row{display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap}
        .sel-row label{font-weight:600;font-size:14px}
        .sel-row select{padding:7px 10px;border:1px solid var(--border);border-radius:6px;font-size:14px;outline:none;font-family:inherit}
        table{width:100%;border-collapse:collapse;font-size:13px;margin-top:8px}
        th,td{border:1px solid var(--border);padding:7px 10px;text-align:left}
        th{background:var(--brand-light);color:var(--brand-dark);font-weight:600;white-space:nowrap;font-size:12px;text-transform:uppercase;letter-spacing:.3px}
        tr:nth-child(even){background:#f9fbf9}
        .ec{cursor:pointer;min-width:70px;transition:background .12s}
        .ec:hover{background:#d0eee5!important;outline:2px solid var(--brand);outline-offset:-2px}
        .di{width:88px;padding:3px 5px;border:2px solid var(--brand);border-radius:4px;font-size:13px;font-family:inherit;outline:none;background:#fff}
        .ni{width:160px;padding:3px 5px;border:2px solid var(--brand);border-radius:4px;font-size:13px;font-family:inherit;outline:none;background:#fff}
        .ni-sm{width:70px;padding:3px 5px;border:2px solid var(--brand);border-radius:4px;font-size:13px;font-family:inherit;outline:none;background:#fff}
        .paste-area{margin-bottom:14px;display:none}
        .paste-area textarea{width:100%;min-height:180px;padding:12px;border:1px solid var(--border);border-radius:8px;font-family:'Consolas','Courier New',monospace;font-size:13px;resize:vertical;outline:none;line-height:1.6}
        .paste-area textarea:focus{border-color:var(--brand);box-shadow:0 0 0 2px rgba(10,64,56,.1)}
        .paste-actions{display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;align-items:center}
        .extract-btn{background:var(--brand);color:#fff;border:none;padding:8px 16px;border-radius:6px;font-weight:600;cursor:pointer;font-size:13px;font-family:inherit;transition:background .2s}
        .extract-btn:hover{background:var(--brand-dark)}
        .clear-paste-btn{background:#e5e7eb;color:var(--text);border:none;padding:8px 16px;border-radius:6px;font-weight:600;cursor:pointer;font-size:13px;font-family:inherit}
        .paste-hint{font-size:11px;color:var(--text-muted);margin-left:4px}
        .hol-bar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;align-items:center}
        .hol-bar button{padding:5px 14px;border-radius:6px;font-weight:600;cursor:pointer;font-size:12px;border:none;font-family:inherit;transition:background .15s}
        .dm-btn{background:var(--danger);color:#fff}.dm-btn:hover{background:#a40e26}
        .dm-btn:disabled{opacity:.4;cursor:not-allowed}
        .mk-col{width:36px;text-align:center}
        .mk-col input[type="checkbox"]{width:15px;height:15px;cursor:pointer;accent-color:var(--brand)}
        .del-x{color:var(--danger);cursor:pointer;font-size:15px;font-weight:700;opacity:.6;transition:opacity .15s}
        .del-x:hover{opacity:1}
        .ins-plus-btn{background:var(--success);color:#fff;border:none;width:22px;height:22px;border-radius:50%;font-size:15px;font-weight:700;cursor:pointer;line-height:1;display:inline-flex;align-items:center;justify-content:center;opacity:.7;transition:opacity .15s,transform .15s;padding:0;vertical-align:middle;flex-shrink:0}
        .ins-plus-btn:hover{opacity:1;transform:scale(1.2)}
        .ins-top-row td{border:none!important;background:transparent!important;padding:3px 0!important;text-align:center;height:auto}
        .ins-top-row:hover td{background:transparent!important}
        .fg{margin-bottom:14px;display:flex;align-items:center;gap:15px;flex-wrap:wrap}
        .fg label{font-weight:600;min-width:140px;font-size:14px}
        .fg input[type="text"],.fg input[type="file"]{padding:8px;border:1px solid var(--border);border-radius:6px;flex-grow:1;min-width:140px;font-size:13px;font-family:inherit}
        .proc-btn{background:var(--success);color:#fff;border:none;padding:10px 22px;border-radius:6px;font-weight:600;cursor:pointer;font-size:14px;font-family:inherit;transition:background .2s}
        .proc-btn:hover{background:#16863a}
        .prev-btn{background:#5c6b62;color:#fff;border:none;padding:8px 14px;border-radius:6px;font-weight:600;cursor:pointer;font-size:13px;font-family:inherit;flex-shrink:0}
        .prev-btn:hover{background:#4a5750}
        #loading{display:none;color:var(--brand);font-weight:700;margin-top:10px}
        .dbg{font-size:12px;color:#333;margin-top:14px;background:#eef;padding:10px;border-radius:6px;border:1px solid #ddf}
        .no-data{text-align:center;padding:24px 10px;color:var(--text-muted);font-style:italic}
        .toast{position:fixed;bottom:20px;right:20px;padding:12px 22px;border-radius:8px;font-size:14px;font-weight:600;z-index:2000;opacity:0;transform:translateY(20px);transition:all .3s;pointer-events:none;color:#fff;max-width:400px}
        .toast.show{opacity:1;transform:translateY(0)}
        .toast.success{background:var(--success)}.toast.error{background:var(--danger)}.toast.info{background:var(--brand)}
        .admin-card{border:2px solid #a8d5ba;background:linear-gradient(135deg,#f4faf6,#fff);border-top:2px solid #a8d5ba}
        .review-bar{display:flex;align-items:center;gap:12px;margin-top:14px;padding:14px 16px;background:var(--brand-light);border-radius:8px;border:1px solid #a8d5ba;flex-wrap:wrap}
        .review-bar .save-sum{background:var(--brand);color:#fff;border:none;padding:8px 20px;border-radius:6px;font-weight:600;cursor:pointer;font-size:13px;font-family:inherit}
        .review-bar .save-sum:hover{background:var(--brand-dark)}
        .review-bar .discard{background:var(--danger);color:#fff;border:none;padding:8px 20px;border-radius:6px;font-weight:600;cursor:pointer;font-size:13px;font-family:inherit}
        .review-bar .discard:hover{background:#a40e26}
        .sync-banner{text-align:center;padding:14px;background:var(--brand-light);border:1px solid #a8d5ba;border-radius:8px;margin-bottom:16px;font-size:13px;color:var(--brand-dark)}
        .sync-banner i{margin-right:6px}
        .sync-error{text-align:center;padding:14px;background:#fef2f2;border:1px solid #fca5a5;border-radius:8px;margin-bottom:16px;font-size:13px;color:#991b1b}
        .bulk-divider{border:none;border-top:1px dashed var(--border);margin:16px 0}
        .emp-remove-btn{color:var(--danger);cursor:pointer;font-size:14px;font-weight:700;opacity:.5;transition:opacity .15s;margin-left:6px;vertical-align:middle;display:inline-block}
        .emp-remove-btn:hover{opacity:1}
        .ex-emp-section{margin-top:14px;padding:12px 14px;background:#fef2f2;border:1px solid #fca5a5;border-radius:8px}
        .ex-emp-section .ex-title{font-size:13px;font-weight:700;color:#991b1b;margin-bottom:8px;display:flex;align-items:center;gap:6px}
        .ex-emp-item{display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid #fecaca;font-size:13px}
        .ex-emp-item:last-child{border-bottom:none}
        .ex-emp-item .ex-name{flex:1;color:#7f1d1d}
        .hidden{display:none!important}
        .ex-emp-item .restore-btn{background:var(--success);color:#fff;border:none;padding:4px 12px;border-radius:5px;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit;transition:background .15s}
        .ex-emp-item .restore-btn:hover{background:#16863a}
        .ex-emp-item .days-left{font-size:11px;padding:2px 8px;border-radius:10px;font-weight:600;white-space:nowrap}
        .ex-emp-item .days-left.urgent{background:#fef2f2;color:#991b1b;border:1px solid #fca5a5}
        .ex-emp-item .days-left.warn{background:#fffbeb;color:#92400e;border:1px solid #fcd34d}
        .ex-emp-item .days-left.ok{background:#f0fdf4;color:#166534;border:1px solid #86efac}
        @media(max-width:768px){
    /* ── Layout ── */
    .page-wrap{padding:6px 8px 36px}
    /* ── Header ── */
    .app-header{padding:10px 12px;flex-wrap:wrap;gap:8px;border-radius:8px 8px 0 0}
    .header-left{flex:1 1 100%}
    .header-left h1{font-size:15px;line-height:1.3}
    .header-left p{font-size:10px;line-height:1.4}
    .header-right{width:100%;justify-content:flex-end;gap:8px}
    .sync-badge{font-size:10px;padding:3px 8px}
    .admin-btn{font-size:12px;padding:7px 13px}
    /* ── Cards ── */
    .card{padding:12px 10px;margin-bottom:10px}
    .card-title{font-size:14px;flex-direction:column;align-items:flex-start;gap:8px;padding-bottom:8px;margin-bottom:10px}
    .card-title .title-actions{width:100%;display:flex;flex-wrap:wrap;gap:6px}
    .print-btn,.copy-btn,.del-month-btn{font-size:11px;padding:6px 11px}
    /* ── Month selector row ── */
    .sel-row{flex-direction:column;align-items:flex-start;gap:6px}
    .sel-row select{width:100%;font-size:14px}
    /* ── Tables: horizontal scroll ── */
    table{font-size:12px;display:block;overflow-x:auto;-webkit-overflow-scrolling:touch;white-space:nowrap}
    th,td{padding:6px 8px;font-size:11px}
    /* ── Form groups (fg) ── */
    .fg{flex-direction:column;align-items:flex-start;gap:8px}
    .fg label{min-width:auto;font-size:13px}
    .fg input[type="text"],.fg input[type="file"]{width:100%;min-width:0;font-size:13px}
    .fg select{width:100%;font-size:13px}
    .fg span[style*="white-space:nowrap"]{white-space:normal!important;font-size:10px}
    /* ── Quick Add holiday form ── */
    #holPasteArea>div[style*="display:flex"]{flex-direction:column;gap:8px}
    #holPasteArea input[type="text"]{width:100%!important}
    #holPasteArea button[onclick*="addQuickHol"]{width:100%;justify-content:center}
    /* ── Processor card selects ── */
    #procMonth,#procYear{width:100%;margin-bottom:4px}
    #pdfRow{flex-direction:column;gap:6px;display:flex!important}
    #pdfRow input[type="file"]{width:100%}
    /* ── Buttons ── */
    .proc-btn{width:100%;padding:12px;font-size:14px;text-align:center}
    .hol-bar{gap:6px}
    .hol-bar button{font-size:12px;padding:7px 12px}
    /* ── Modal ── */
    .modal{width:calc(100vw - 32px);max-width:340px;padding:18px 16px}
    .modal h3{font-size:16px}
    .modal-act button{padding:9px 16px;font-size:13px}
    /* ── Toast ── */
    .toast{right:10px;left:10px;max-width:none;font-size:13px;padding:10px 16px}
    /* ── No-data placeholder ── */
    .no-data{font-size:13px;padding:18px 8px}
    /* ── Review bar ── */
    .review-bar{flex-direction:column;align-items:flex-start;gap:8px;padding:10px 12px}
    .review-bar .save-sum,.review-bar .discard{width:100%;text-align:center;padding:10px}
    /* ── Paste area ── */
    .paste-actions{flex-direction:column;gap:6px}
    .extract-btn,.clear-paste-btn{width:100%;text-align:center}
    .paste-hint{margin-left:0;margin-top:2px}
    /* ── Leave year badge ── */
    #leaveYearLabel{font-size:10px!important;padding:3px 7px!important}
}

        /* ── Leave Calendar Popup ── */
        .lc-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:2000;justify-content:center;align-items:center}
        .lc-overlay.active{display:flex}
        .lc-modal{background:#fff;border-radius:12px;box-shadow:0 16px 60px rgba(0,0,0,.3);width:390px;max-width:96vw;max-height:92vh;overflow-y:auto;display:flex;flex-direction:column}
        .lc-header{background:var(--brand);color:#fff;padding:14px 18px;border-radius:12px 12px 0 0;display:flex;justify-content:space-between;align-items:center;gap:8px;flex-shrink:0}
        .lc-header h3{font-size:14px;font-weight:700;margin:0;flex:1;line-height:1.3}
        .lc-type-badge{font-size:11px;font-weight:700;padding:3px 10px;border-radius:10px;background:rgba(255,255,255,.2);white-space:nowrap}
        .lc-nav{display:flex;align-items:center;justify-content:space-between;padding:12px 16px 6px;gap:8px;flex-shrink:0}
        .lc-nav-btn{background:var(--brand-light);border:none;color:var(--brand);font-size:15px;font-weight:700;cursor:pointer;border-radius:6px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;transition:background .15s}
        .lc-nav-btn:hover{background:#b2d8d0}
        .lc-nav-btn:disabled{opacity:.3;cursor:default}
        .lc-month-label{font-size:14px;font-weight:700;color:var(--brand-dark);flex:1;text-align:center}
        .lc-grid{padding:0 12px 8px;flex-shrink:0}
        .lc-weekdays{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;margin-bottom:4px}
        .lc-wd{text-align:center;font-size:10px;font-weight:700;color:var(--text-muted);padding:2px 0;text-transform:uppercase;letter-spacing:.3px}
        .lc-days{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}
        .lc-day{min-height:34px;border-radius:6px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:13px;font-weight:500;transition:background .12s;border:2px solid transparent;position:relative;gap:1px}
        .lc-day:hover:not(.lc-empty):not(.lc-other-mo){background:var(--brand-light)!important;border-color:var(--brand)!important}
        .lc-empty,.lc-other-mo{cursor:default;pointer-events:none}
        .lc-other-mo{color:#ccc}
        .lc-weekend{background:#f5f5f5}
        .lc-holiday{background:#fff8e1}
        .lc-sel-annual{background:#d1fae5!important;border-color:#34d399!important;font-weight:700;color:#065f46}
        .lc-sel-sick{background:#fee2e2!important;border-color:#f87171!important;font-weight:700;color:#991b1b}
        .lc-day-num{line-height:1;font-size:13px}
        .lc-day-tag{font-size:8px;font-weight:700;line-height:1;letter-spacing:.2px;text-transform:uppercase}
        .lc-day-half{font-size:9px;font-weight:700;color:inherit;opacity:.8}
        .lc-sel-list{padding:8px 14px 4px;border-top:1px solid #e5e7eb;flex-shrink:0;max-height:190px;overflow-y:auto}
        .lc-sel-title{font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px}
        .lc-sel-item{display:flex;align-items:center;gap:6px;padding:4px 0;border-bottom:1px solid #f3f4f6;font-size:12px}
        .lc-sel-item:last-child{border-bottom:none}
        .lc-sel-date{flex:1;font-weight:600;color:var(--text)}
        .lc-sel-btns{display:flex;gap:4px}
        .lc-tb{padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;cursor:pointer;border:1.5px solid;font-family:inherit;transition:all .15s}
        .lc-tb-ann-on{background:#d1fae5;border-color:#34d399;color:#065f46}
        .lc-tb-sick-on{background:#fee2e2;border-color:#f87171;color:#991b1b}
        .lc-tb-off{background:#fff;border-color:#d1d5db;color:#9ca3af}
        .lc-count-wrap{display:flex;align-items:center;gap:3px;font-size:10px;color:var(--text-muted);white-space:nowrap}
        .lc-count-inp{width:46px;padding:2px 5px;border:1.5px solid #d1d5db;border-radius:5px;font-size:11px;font-family:inherit;text-align:center;outline:none;transition:border-color .15s}
        .lc-count-inp:focus{border-color:var(--brand)}
        .lc-sel-del{color:var(--danger);cursor:pointer;font-size:14px;font-weight:700;opacity:.5;transition:opacity .15s;padding:0 3px;flex-shrink:0}
        .lc-sel-del:hover{opacity:1}
        .lc-footer{padding:12px 14px;border-top:1px solid #e5e7eb;display:flex;gap:8px;justify-content:flex-end;flex-shrink:0;background:#f9fafb;border-radius:0 0 12px 12px}
