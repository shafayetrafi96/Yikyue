function wkRule(dept){
    if(!dept||dept.toString().trim()==='')return'satsun';
    dept=dept.toString().trim().toLowerCase();
    if(dept.includes('driver'))return'driver';          /* Fri+Sat+Sun off, no duty credit */
    if(dept==='qa'||dept.includes('quality assurance'))return'fri'; /* Fri off, duty credit if present */
    return'satsun';
}
function t2m(ts){
    if(!ts||typeof ts!=='string')return null;
    ts=ts.toUpperCase();var p=ts.match(/(\d+):(\d+):(\d+)\s*(AM|PM)/);
    if(!p)return null;
    var h=parseInt(p[1]),m=parseInt(p[2]),ap=p[4];
    if(ap==='PM'&&h!==12)h+=12;if(ap==='AM'&&h===12)h=0;
    return h*60+m;
}
