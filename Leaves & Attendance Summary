async function readMovementFromDB(year,month){
    if(!movFbReady)throw new Error('Movement database not connected. Switch to PDF mode or check your internet connection.');
    var snap=await movDb.ref('movements').once('value');
    if(!snap.exists()||!snap.val()){
        console.log('[MovDB] No movement records found');
        return [];
    }
    var raw=snap.val();
    var entries=Array.isArray(raw)?raw:Object.values(raw);
    var recs=[];
    var ym=year+'-'+String(month).padStart(2,'0');
    entries.forEach(function(m){
        if(!m||!m.date||!m.idNo)return;
        if(!m.date.startsWith(ym))return;
        var parts=m.date.split('-');
        if(parts.length!==3)return;
