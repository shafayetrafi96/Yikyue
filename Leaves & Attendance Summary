/* ═══════════════════════════════════════════════════
   Backfill knownEmployees from all existing data
   Runs once on startup and after cloud refresh so that
   employees processed before this feature was added are
   registered and survive month deletion.
   ═══════════════════════════════════════════════════ */
async function _backfillKnownEmployees(){
    var known=new Set(D.knownEmployees);
    var ex=new Set(D.exEmployees.map(function(e){return e.name;}));
    var added=false;
    /* Scan ALL months in D.summaries (not limited to financial year) */
    Object.keys(D.summaries).forEach(function(mk){
        ensureArray(D.summaries[mk].results).forEach(function(r){
            var n=(r.name||'').trim();
            if(n&&!known.has(n)&&!ex.has(n)){known.add(n);D.knownEmployees.push(n);added=true;}
        });
    });
    /* Scan ALL months in D.manualLeaves */
    Object.keys(D.manualLeaves).forEach(function(mk){
        var ml=D.manualLeaves[mk];
        if(!ml||typeof ml!=='object')return;
        Object.keys(ml).forEach(function(n){
            n=(n||'').trim();
            if(n&&!known.has(n)&&!ex.has(n)){known.add(n);D.knownEmployees.push(n);added=true;}
        });
    });
    if(added&&isAdmin){
        console.log('[backfill] Added',D.knownEmployees.length,'entries to knownEmployees');
        try{await saveKnownEmployees();}catch(e){console.error('[backfill] save failed:',e);}
    }
}

/* ═══════════════════════════════════════════════════
   Backfill: ensure EVERY known employee has at least one
   record under appState/manualLeaves. Employees that only
   ever existed in the knownEmployees roster (e.g. added via
   "Add Employee" before this fix, or never given any leave
   dates) get a '0' placeholder written into the current
   month so their record is guaranteed to survive a reload
   independently of the knownEmployees list.
   ═══════════════════════════════════════════════════ */
async function _backfillManualLeavesSeed(){
    var exSet={};
    D.exEmployees.forEach(function(e){exSet[e.name]=true;});
    var hasRecord={};
    Object.keys(D.manualLeaves).forEach(function(mk){
        var ml=D.manualLeaves[mk];
        if(!ml||typeof ml!=='object')return;
        Object.keys(ml).forEach(function(n){hasRecord[n]=true;});
    });
    var mk=_currentMonthKey();
    var added=false;
    D.knownEmployees.forEach(function(n){
        if(!n||exSet[n]||hasRecord[n])return;
        if(!D.manualLeaves[mk])D.manualLeaves[mk]={};
        D.manualLeaves[mk][n]='0';
        hasRecord[n]=true;added=true;
    });
    if(added&&isAdmin){
        console.log('[backfill] Seeded appState/manualLeaves placeholders for employees without leave records');
        try{await saveAllManualLeaves();}catch(e){console.error('[backfill] manualLeaves seed save failed:',e);}
    }
}

async function refreshFromCloud(){
    toast('Refreshing from cloud...','info');
    await loadFB();
    if(isAdmin){await _backfillKnownEmployees();await _backfillManualLeavesSeed();}
    _mergeLeavesIntoSummaries();
    renderHol();populateMonths();updateUI();showSummary();showRemainingLeaves();
    updateHolDaysField();
    toast('Data refreshed','success');
}

