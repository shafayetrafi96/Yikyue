/* ===== Rich Text Editor (Word-like) for Challan ===== */
function getChallanRteDoc(){
    var dc=document.getElementById('detailContent');
    return dc?dc.querySelector('.challan-doc'):null;
}

function makeDocEditable(docEl){
    if(!docEl)return;
    docEl.contentEditable='true';
    docEl.classList.add('rte-editable');
    docEl.removeEventListener('keydown',_rteKeyHandler,false);
    docEl.removeEventListener('keyup',_rteUpdateState,false);
    docEl.removeEventListener('mouseup',_rteUpdateState,false);
    docEl.addEventListener('keydown',_rteKeyHandler,false);
    docEl.addEventListener('keyup',_rteUpdateState,false);
    docEl.addEventListener('mouseup',_rteUpdateState,false);
    document.removeEventListener('selectionchange',_rteUpdateState,false);
    document.addEventListener('selectionchange',_rteUpdateState,false);
    docEl.addEventListener('keydown',function(e){
        if(e.key==='Enter'&&!e.shiftKey){
            e.preventDefault();
            document.execCommand('insertHTML',false,'<br><br>');
        }
    },false);
}

function _rteKeyHandler(e){
    if(e.shiftKey&&e.key==='Enter'){e.preventDefault();document.execCommand('insertHTML',false,'<br>');return;}
    if(e.shiftKey&&!e.ctrlKey&&!e.metaKey&&e.key.toLowerCase()==='a'){
        e.preventDefault();
        var d=getChallanRteDoc();
        if(d){var r=document.createRange();r.selectNodeContents(d);var s=window.getSelection();s.removeAllRanges();s.addRange(r);}
        return;
    }
    clearTimeout(_rteKeyHandler._t);
    _rteKeyHandler._t=setTimeout(function(){autoChallanSaveRte();},1800);
}

function _rteUpdateState(){updateRteToolbarState();}

function rteExec(cmd,val){
    var d=getChallanRteDoc();if(!d)return;
    d.focus();
    document.execCommand(cmd,false,val||null);
    updateRteToolbarState();
    clearTimeout(rteExec._t);
    rteExec._t=setTimeout(autoChallanSaveRte,1800);
}

function rteToggleFormat(cmd){rteExec(cmd);}

function rteSetFontSize(px){
    px=parseInt(px);if(!px||px<1)return;
    var d=getChallanRteDoc();if(!d)return;d.focus();
    var sel=window.getSelection();
    if(!sel||sel.rangeCount===0||sel.isCollapsed){
        var szSel=document.getElementById('rteFontSize');if(szSel)szSel.value=_closestFontSizeOption(px);
        return;
    }
    document.execCommand('fontSize',false,'7');
    var fonts=d.querySelectorAll('font[size="7"]');
    fonts.forEach(function(f){
        var span=document.createElement('span');
        span.style.fontSize=px+'px';
        while(f.firstChild)span.appendChild(f.firstChild);
        f.parentNode.replaceChild(span,f);
    });
    updateRteToolbarState();
    clearTimeout(rteSetFontSize._t);
    rteSetFontSize._t=setTimeout(autoChallanSaveRte,1200);
}

function rteFontSizeStep(delta){
    var d=getChallanRteDoc();if(!d)return;
    var sel=window.getSelection();
    var currentPx=12;
    if(sel&&sel.rangeCount>0){
        var node=sel.getRangeAt(0).startContainer;
        while(node&&node.nodeType===3)node=node.parentNode;
        if(node&&node!==d&&d.contains(node)){
            try{currentPx=parseInt(window.getComputedStyle(node).fontSize)||12;}catch(e){}
        }
    }
    rteSetFontSize(Math.max(6,Math.min(200,currentPx+delta)));
    var newPx=Math.max(6,Math.min(200,currentPx+delta));
    var szSel=document.getElementById('rteFontSize');
    if(szSel)szSel.value=_closestFontSizeOption(newPx);
}

function _closestFontSizeOption(px){
    var szSel=document.getElementById('rteFontSize');if(!szSel)return px;
    var best=szSel.options[0].value,bestDiff=Infinity;
    for(var i=0;i<szSel.options.length;i++){
        var diff=Math.abs(parseInt(szSel.options[i].value)-px);
        if(diff<bestDiff){bestDiff=diff;best=szSel.options[i].value;}
    }
    return best;
}

function rteSetLineHeight(val){
    if(!val)return;
    var d=getChallanRteDoc();if(!d)return;
    var sel=window.getSelection();
    var target=d;
    if(sel&&sel.rangeCount>0){
        var node=sel.getRangeAt(0).commonAncestorContainer;
        while(node&&node.nodeType===3)node=node.parentNode;
        if(node&&node!==d&&d.contains(node))target=node;
    }
    target.style.lineHeight=val;
    autoChallanSaveRte();
    var ls=document.getElementById('rteLineSpacing');if(ls)ls.selectedIndex=0;
}

function updateRteToolbarState(){
