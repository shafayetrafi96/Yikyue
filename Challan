function deleteEntry(id){var c=challans.find(function(ch){return ch._id===id;});if(!isAdmin&&c&&c.deviceId&&c.deviceId!==currentDeviceId){showToast('You can only delete your own challans','error');return;}deleteTargetId=id;isBulkDelete=false;document.getElementById('deleteMessage').textContent='Delete Challan '+((c&&c.challanNo)||'this entry')+'?';document.getElementById('deleteModal').classList.remove('hidden');}
function closeDeleteModal(){document.getElementById('deleteModal').classList.add('hidden');deleteTargetId=null;}
function confirmDelete(){if(isBulkDelete){var ids=Array.from(document.querySelectorAll('.row-check:checked')).map(function(cb){return cb.dataset.id;});challans=challans.filter(function(c){return!ids.includes(c._id);});commitAction();showToast(ids.length+' challans deleted','success');}else if(deleteTargetId){challans=challans.filter(function(c){return c._id!==deleteTargetId;});commitAction();showToast('Deleted!','success');}closeDeleteModal();}
function promptBulkDelete(){var checked=document.querySelectorAll('.row-check:checked');if(!checked.length){showToast('Select challans first','error');return;}isBulkDelete=true;document.getElementById('deleteMessage').textContent='Delete '+checked.length+' selected challan(s)?';document.getElementById('deleteModal').classList.remove('hidden');}
function toggleSelectAll(cb){document.querySelectorAll('.row-check').forEach(function(c){c.checked=cb.checked;});}

/* ===== Init ===== */
window.addEventListener('DOMContentLoaded',function(){
    /* Load persisted font sizes */
    if(isFirebaseConnected){
        db.ref('challanFontSizes').once('value',function(s){if(s.val())challanFontSizes=Object.assign({},DEFAULT_CHALLAN_FONT_SIZES,s.val());});
        db.ref('challanBoldFields').once('value',function(s){if(s.val())challanBoldFields=Object.assign({},DEFAULT_CHALLAN_BOLD,s.val());});
        db.ref('challanFontFamily').once('value',function(s){if(s.val())challanFontFamily=s.val();});
        /* Load company name/address from Firebase */
        db.ref('companyName').once('value',function(s){if(s.val()){companyName=s.val();updateHeaderDisplay();}});
        db.ref('companyAddress').once('value',function(s){if(s.val()){companyAddress=s.val();updateHeaderDisplay();}});
        try{var _pn=sessionStorage.getItem('prevCompanyName_ch');if(_pn)prevCompanyName=_pn;var _pa=sessionStorage.getItem('prevCompanyAddress_ch');if(_pa)prevCompanyAddress=_pa;}catch(e){}
    } else {
        /* Load from localStorage fallback */
        try{
            var cn=localStorage.getItem('companyName');if(cn)companyName=cn;
            var ca=localStorage.getItem('companyAddress');if(ca)companyAddress=ca;
            var pn=sessionStorage.getItem('prevCompanyName_ch');if(pn)prevCompanyName=pn;
            var pa=sessionStorage.getItem('prevCompanyAddress_ch');if(pa)prevCompanyAddress=pa;
        }catch(e){}
        updateHeaderDisplay();
    }

    datePickerInstance=flatpickr('#entryDate',{dateFormat:'Y-m-d',allowInput:true,disableMobile:true,defaultDate:new Date()});

    setupSuggestionInput('entryAttention','attentionPersons');
    setupSuggestionInput('entryOrganization','organizations');
    setupSuggestionInput('entryMobile','mobiles');
    setupSuggestionInput('entryItem','items');
    setupSuggestionInput('entryStyle','styles');
    setupSuggestionInput('entrySampleType','sampleTypes');
    setupSuggestionInput('entryColor','colors');

    document.getElementById('challanForm').addEventListener('submit',handleSubmit);
    document.getElementById('searchInput').addEventListener('input',renderTable);
    document.getElementById('monthFilter').addEventListener('change',renderTable);

    renderFormItems();

    if(isFirebaseConnected){
        db.ref('challans').once('value',function(s){
            var d=s.val();
            if(d){challans=Array.isArray(d)?d:Object.values(d);challans=challans.filter(Boolean);}
            db.ref('suggestions').once('value',function(ss){
                var sd=ss.val();
                if(sd){var dd=decodeFromFB(sd);for(var k in dynamicSuggestions){if(dd[k])dynamicSuggestions[k]=dd[k];}}
                loadBgImage();
                processAndRender();
            });
        });
    }else{
        challans=loadData('challans',[]);
        var ls=loadData('suggestions',null);
        if(ls){for(var k in dynamicSuggestions){if(ls[k])dynamicSuggestions[k]=ls[k];}}
        loadBgImage();
        processAndRender();
    }

    ssoCheck(function(ok){
        if(ok){
            isAdmin=true;
            document.getElementById('adminBtn').innerHTML='<i class="fas fa-user-shield mr-2"></i>Logout';
            toggleAdminUI(true);
        }
    });
    /* Show short device ID in header */
    var _dEl=document.getElementById('deviceIdShort');
    if(_dEl)_dEl.textContent=currentDeviceId.slice(-8).toUpperCase();
});
</script>

