<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YIK YUE (H.K.) COMMERCIAL LIMITED - Challan System</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect x='18' y='3' width='64' height='94' rx='6' fill='%230A4038'/%3E%3Crect x='24' y='9' width='52' height='82' rx='3' fill='white'/%3E%3Cline x1='32' y1='30' x2='68' y2='30' stroke='%230A4038' stroke-width='3'/%3E%3Cline x1='32' y1='44' x2='68' y2='44' stroke='%230A4038' stroke-width='3'/%3E%3Cline x1='32' y1='58' x2='54' y2='58' stroke='%230A4038' stroke-width='3'/%3E%3C/svg%3E">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>tailwind.config={theme:{extend:{colors:{brand:'#0A4038','brand-dark':'#072e27','brand-light':'#e0efed'}}}}</script>
    <style>
        body{background-color:#f4f6f9;background-image:url('https://www.transparenttextures.com/patterns/cubes.png');background-attachment:fixed}
        ::selection{background-color:#0A4038;color:white}
        .suggestion-dropdown{position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid #cbd5e0;border-top:none;max-height:150px;overflow-y:auto;z-index:50;box-shadow:0 4px 6px -1px rgba(0,0,0,.1);border-radius:0 0 .25rem .25rem}
        .suggestion-item{padding:8px 12px;cursor:pointer;font-size:.875rem;color:#4a5568}
        .suggestion-item:hover,.suggestion-item:active{background-color:#e0efed;color:#0A4038}
        .toast{position:fixed;bottom:30px;left:50%;transform:translateX(-50%);padding:14px 28px;border-radius:12px;color:#fff;font-weight:600;font-size:14px;z-index:9999;opacity:0;transition:opacity .3s;box-shadow:0 8px 30px rgba(0,0,0,.2);pointer-events:none}
        .toast.show{opacity:1}
        .toast-success{background:#059669}
        .toast-error{background:#dc2626}
        input:-webkit-autofill,input:-webkit-autofill:hover,input:-webkit-autofill:focus,input:-webkit-autofill:active{-webkit-box-shadow:0 0 0 30px #fff inset!important;-webkit-text-fill-color:#2d3748!important;transition:background-color 5000s ease-in-out 0s}

        /* CHALLAN DOCUMENT STYLES */
        .challan-doc{font-family:'Calibri',sans-serif;color:#000;width:210mm;margin:0 auto;padding:5mm 10mm;line-height:1.3;position:relative;background-color:#fff;zoom:.56}
        .challan-header{margin-bottom:3mm}
        .challan-header .company-name{text-align:left;font-size:14px;font-weight:bold;letter-spacing:1px;margin:0}
        .challan-header .company-sub{text-align:left;font-size:8.5px;font-weight:600;margin:2px 0 0;color:#333}
        .challan-header .company-addr{text-align:left;font-size:8px;color:#444;margin:1px 0 0}
        .challan-header .header-line{border:none;border-top:2px solid #000;margin:4px 0 0}
        .challan-ruler{border:1px solid #555;padding:5mm 7mm;background-color:#fff;background-size:92% auto;background-position:center;background-repeat:no-repeat;min-height:calc(297mm - 22mm);display:flex;flex-direction:column}
        .challan-ruler .challan-body{flex:0 1 auto}
        .challan-ruler .signature-section{margin-top:auto;padding-top:8px}
        .challan-ruler .title-section{text-align:center;margin:8px 0 30px}
        .challan-ruler .title-text{font-size:13px;font-weight:bold;letter-spacing:3px;text-transform:uppercase;display:inline-block;padding:2px 16px;border-top:1.5px solid #000;border-bottom:1.5px solid #000}
        .challan-ruler .info-row{display:flex;justify-content:space-between;font-size:10px;margin-bottom:20px;font-weight:bold}
        .challan-ruler .to-section{margin-bottom:40px;font-size:10px}
        .challan-ruler .to-label{font-weight:bold;margin-bottom:2px;font-size:10px}
        .challan-ruler .to-name{font-weight:bold;font-size:11px}
        .challan-ruler .to-org{font-size:10px}
        .challan-ruler .to-mobile{font-size:8.5px;color:#555}
        .challan-ruler table{width:100%;border-collapse:collapse;font-size:9.5px;margin-bottom:20px}
        .challan-ruler table thead th{background:transparent;color:#000;padding:4px 5px;text-align:center;font-weight:bold;font-size:9px;border:1px solid #000}
        .challan-ruler table thead th:nth-child(2),.challan-ruler table thead th:nth-child(3),.challan-ruler table thead th:nth-child(4),.challan-ruler table thead th:nth-child(5){text-align:left}
        .challan-ruler table tbody td{padding:3px 5px;border:1px solid #000;font-size:9.5px}
        .challan-ruler table tbody td:first-child{text-align:center}
        .challan-ruler table tbody td:nth-child(6){text-align:center}
        .challan-ruler table tfoot td{padding:4px 5px;border:none;font-weight:bold;font-size:9.5px;background:transparent}
        .challan-ruler table tfoot .total-label{text-align:right;border:none}
        .challan-ruler table tfoot .total-value{text-align:center;border:1px solid #000}
        .challan-ruler .signature-section{display:flex;justify-content:space-between;font-size:9.5px}
        .challan-ruler .signature-box{text-align:center;min-width:130px}
        .challan-ruler .signature-line{border-top:1px solid #000;padding-top:3px;font-weight:bold;font-size:9.5px}

        /* ===== Word-like Editing Toolbar ===== */
        input[type=range]{accent-color:#0A4038}
        .word-toolbar{background:#f0f4f8;border:1px solid #cbd5e0;border-radius:6px;padding:6px 10px;margin-bottom:8px;display:flex;flex-wrap:wrap;gap:4px;align-items:center;}
        .word-toolbar-btn{border:1px solid #cbd5e0;background:#fff;border-radius:4px;padding:3px 8px;font-size:12px;cursor:pointer;color:#374151;transition:all .15s;display:inline-flex;align-items:center;gap:3px;}
        .word-toolbar-btn:hover{background:#e0efed;border-color:#0A4038;color:#0A4038;}
        .word-toolbar-btn.active{background:#0A4038;color:#fff;border-color:#0A4038;}
        .word-toolbar-sep{width:1px;height:20px;background:#cbd5e0;margin:0 2px;}
        .rte-editable{outline:none;cursor:text;}
        .rte-editable:focus-within{outline:2px solid rgba(10,64,56,0.15);border-radius:2px;}
        kbd{font-family:monospace;font-size:10px;background:#e5e7eb;border:1px solid #d1d5db;border-radius:3px;padding:1px 5px;}
        button:disabled{opacity:.4;cursor:not-allowed}

        @keyframes rowFlash {
            0%   { background-color: #fef08a; }
            100% { background-color: transparent; }
        }
        .row-flash { animation: rowFlash 10s ease-out; }
    </style>
</head>
<body class="text-gray-800 font-sans">
    <div id="toastContainer" class="toast"></div>
    <input type="file" id="bgUploadInput" accept="image/*" class="hidden" onchange="handleBgUpload(event)">

    <!-- ===== Admin Login Modal ===== -->
    <div id="adminModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-[100] flex justify-center items-center">
        <div class="bg-white p-6 rounded-lg shadow-xl w-80 z-[101]">
            <h3 class="text-lg font-bold mb-4 text-brand-dark">Admin Login</h3>
            <input type="password" id="adminPassInput" autocomplete="off" class="w-full border border-gray-300 rounded p-2 mb-2" placeholder="Enter Password" onkeypress="if(event.key==='Enter')submitAdminLogin()">
            <p id="adminError" class="text-red-500 text-sm mb-4 hidden">Incorrect Password!</p>
            <div class="flex justify-end space-x-2">
                <button onclick="closeAdminModal()" class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400 font-medium">Cancel</button>
                <button onclick="submitAdminLogin()" class="px-4 py-2 bg-brand text-white rounded hover:bg-brand-dark font-medium">Login</button>
            </div>
        </div>
    </div>

    <!-- ===== Delete Confirm Modal ===== -->
    <div id="deleteModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-[100] flex justify-center items-center" onclick="closeDeleteModal()">
        <div class="bg-white p-6 rounded-lg shadow-2xl w-80 border border-red-200 z-[101]" onclick="event.stopPropagation()">
            <h3 class="text-lg font-bold mb-4 text-red-600">Confirm Deletion</h3>
            <p id="deleteMessage" class="mb-6">Are you sure?</p>
            <div class="flex justify-end space-x-2">
                <button onclick="closeDeleteModal()" class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400 font-medium">Cancel</button>
                <button onclick="confirmDelete()" class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 font-medium">Delete</button>
            </div>
        </div>
    </div>

    <!-- ===== Suggestions Modal ===== -->
    <div id="suggestionsModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-[100] flex justify-center items-center p-4">
        <div class="bg-white rounded-lg shadow-2xl w-full max-w-4xl max-h-[90vh] flex flex-col z-[101]">
            <div class="p-4 border-b flex justify-between items-center bg-brand text-white rounded-t-lg shrink-0">
                <h3 class="text-lg font-bold"><i class="fas fa-list-alt mr-2"></i>Manage Suggestions</h3>
                <button onclick="closeSuggestionManager()" class="text-white hover:text-gray-300 text-xl"><i class="fas fa-times"></i></button>
            </div>
            <div class="flex border-b bg-gray-50 px-4 pt-2 overflow-x-auto shrink-0">
                <button onclick="switchSuggestionTab('attentionPersons')" class="tab-btn px-4 py-2 font-medium text-sm border-b-2 border-brand text-brand" data-tab="attentionPersons">Attention</button>
                <button onclick="switchSuggestionTab('organizations')" class="tab-btn px-4 py-2 font-medium text-sm border-b-2 border-transparent text-gray-500" data-tab="organizations">Organizations</button>
                <button onclick="switchSuggestionTab('mobiles')" class="tab-btn px-4 py-2 font-medium text-sm border-b-2 border-transparent text-gray-500" data-tab="mobiles">Mobiles</button>
                <button onclick="switchSuggestionTab('items')" class="tab-btn px-4 py-2 font-medium text-sm border-b-2 border-transparent text-gray-500" data-tab="items">Items</button>
                <button onclick="switchSuggestionTab('styles')" class="tab-btn px-4 py-2 font-medium text-sm border-b-2 border-transparent text-gray-500" data-tab="styles">Styles</button>
                <button onclick="switchSuggestionTab('sampleTypes')" class="tab-btn px-4 py-2 font-medium text-sm border-b-2 border-transparent text-gray-500" data-tab="sampleTypes">Sample Types</button>
                <button onclick="switchSuggestionTab('colors')" class="tab-btn px-4 py-2 font-medium text-sm border-b-2 border-transparent text-gray-500" data-tab="colors">Colors</button>
            </div>
            <div class="p-6 overflow-y-auto flex-1 bg-white">
                <div class="flex mb-6 gap-2">
                    <input type="text" id="newSuggestionInput" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" class="flex-1 border border-gray-300 rounded p-2" placeholder="New suggestion..." onkeypress="if(event.key==='Enter')addNewSuggestion()">
                    <button onclick="addNewSuggestion()" class="bg-brand text-white px-4 py-2 rounded hover:bg-brand-dark font-medium">Add</button>
                    <button onclick="clearAllSuggestions()" class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600 font-medium"><i class="fas fa-trash-alt mr-1"></i>Clear</button>
                </div>
                <div id="suggestionsList" class="space-y-2"></div>
            </div>
        </div>
    </div>

    <!-- ===== Name & Address Modal ===== -->
    <div id="nameAddressModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-[100] flex justify-center items-center p-4" onclick="closeNameAddressModal()">
        <div class="bg-white rounded-lg shadow-2xl w-full max-w-lg z-[101]" onclick="event.stopPropagation()">
            <div class="p-4 border-b flex justify-between items-center bg-brand text-white rounded-t-lg">
                <h3 class="text-lg font-bold"><i class="fas fa-building mr-2"></i>Name &amp; Address</h3>
                <button onclick="closeNameAddressModal()" class="text-white hover:text-gray-300 text-xl"><i class="fas fa-times"></i></button>
            </div>
            <div class="p-6">
                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Company Name</label>
                    <input type="text" id="naNameInput" class="w-full border border-gray-300 rounded p-2 text-sm focus:ring-2 focus:ring-brand focus:border-brand outline-none" placeholder="Company Name">
                </div>
                <div class="mb-6">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Address</label>
                    <textarea id="naAddressInput" rows="3" class="w-full border border-gray-300 rounded p-2 text-sm focus:ring-2 focus:ring-brand focus:border-brand outline-none resize-none" placeholder="Full Address"></textarea>
                </div>
                <div id="naPrevInfo" class="mb-4 p-3 bg-gray-50 border border-gray-200 rounded text-xs text-gray-500 hidden">
                    <p class="font-semibold text-gray-600 mb-1"><i class="fas fa-history mr-1"></i>Previous Version:</p>
                    <p id="naPrevName" class="truncate"></p>
                    <p id="naPrevAddr" class="truncate"></p>
                </div>
                <div class="flex justify-between items-center gap-2">
                    <button id="naRestoreBtn" onclick="restoreNameAddress()" class="px-4 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600 font-medium text-sm"><i class="fas fa-undo mr-1"></i>Restore Previous</button>
                    <div class="flex gap-2 ml-auto">
                        <button onclick="closeNameAddressModal()" class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400 font-medium text-sm">Cancel</button>
                        <button onclick="saveNameAddress()" class="px-4 py-2 bg-brand text-white rounded hover:bg-brand-dark font-medium text-sm"><i class="fas fa-save mr-1"></i>Save</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== Server Settings Modal ===== -->
    <div id="serverModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-[100] flex justify-center items-center p-4" onclick="closeServerModal()">
        <div class="bg-white rounded-lg shadow-2xl w-full max-w-xl z-[101]" onclick="event.stopPropagation()">
            <div class="p-4 border-b flex justify-between items-center bg-brand text-white rounded-t-lg">
                <h3 class="text-lg font-bold"><i class="fas fa-server mr-2"></i>Server Settings</h3>
                <button onclick="closeServerModal()" class="text-white hover:text-gray-300 text-xl"><i class="fas fa-times"></i></button>
            </div>
            <div class="p-6">
                <p class="text-xs text-gray-500 mb-4 bg-yellow-50 border border-yellow-200 rounded p-2"><i class="fas fa-info-circle mr-1 text-yellow-600"></i>Changes take effect after saving and reloading the page.</p>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Firebase Config (JSON)</label>
                    <textarea id="srv_configJson" rows="10" spellcheck="false" class="w-full border border-gray-300 rounded p-2 text-xs font-mono focus:ring-2 focus:ring-brand outline-none resize-none"></textarea>
                </div>
                <div id="srvPrevInfo" class="mt-4 p-3 bg-gray-50 border border-gray-200 rounded text-xs text-gray-500 hidden">
                    <p class="font-semibold text-gray-600 mb-1"><i class="fas fa-history mr-1"></i>Previous Version saved — restore available.</p>
                </div>
                <div class="flex justify-between items-center gap-2 mt-4">
                    <button id="srvRestoreBtn" onclick="restoreServerConfig()" class="px-4 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600 font-medium text-sm disabled:opacity-40 disabled:cursor-not-allowed"><i class="fas fa-undo mr-1"></i>Restore to Previous Version</button>
                    <div class="flex gap-2 ml-auto">
                        <button onclick="closeServerModal()" class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400 font-medium text-sm">Cancel</button>
                        <button onclick="saveServerConfig()" class="px-4 py-2 bg-brand text-white rounded hover:bg-brand-dark font-medium text-sm"><i class="fas fa-save mr-1"></i>Save &amp; Reload</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== Challan Detail / View Modal ===== -->
    <div id="detailModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-[100] flex justify-center items-center p-1 overflow-y-auto">
        <div id="detailModalInner" class="bg-white rounded-lg shadow-2xl w-full max-w-5xl my-1 z-[101] flex" onclick="event.stopPropagation()">
            <div class="flex-1 flex flex-col min-w-0">
                <!-- Word-like toolbar (all users, view mode) -->
                <div id="wordToolbar" class="p-2 border-b bg-gray-50 rounded-tl-lg">
                    <div class="word-toolbar" id="wordToolbarInner">
                        <select id="rteFontFamily" class="word-toolbar-btn py-0.5 px-1" style="min-width:95px;font-size:11px" onchange="rteExec('fontName',this.value)" title="Font Family">
                            <option value="Calibri">Calibri</option><option value="Arial">Arial</option><option value="Times New Roman">Times New Roman</option><option value="Georgia">Georgia</option><option value="Verdana">Verdana</option><option value="Courier New">Courier New</option><option value="Tahoma">Tahoma</option>
                        </select>
                        <button class="word-toolbar-btn" onclick="rteFontSizeStep(-1)" title="Decrease font size" style="min-width:22px;font-weight:bold;font-size:14px;padding:1px 6px;">−</button>
                        <select id="rteFontSize" class="word-toolbar-btn py-0.5 px-1" style="min-width:52px;font-size:11px" onchange="rteSetFontSize(this.value)" title="Font Size (px)">
                            <option value="7">7</option><option value="8">8</option><option value="9">9</option><option value="10">10</option><option value="11">11</option><option value="12">12</option><option value="13">13</option><option value="14">14</option><option value="15">15</option><option value="16">16</option><option value="18">18</option><option value="20">20</option><option value="22">22</option><option value="24">24</option><option value="26">26</option><option value="28">28</option><option value="32">32</option><option value="36">36</option><option value="40">40</option><option value="48">48</option><option value="60">60</option><option value="72">72</option>
                        </select>
                        <button class="word-toolbar-btn" onclick="rteFontSizeStep(1)" title="Increase font size" style="min-width:22px;font-weight:bold;font-size:14px;padding:1px 6px;">+</button>
                        <div class="word-toolbar-sep"></div>
                        <button class="word-toolbar-btn font-bold" id="rteBtn_bold" onclick="rteToggleFormat('bold')" title="Bold (Ctrl+B)" style="min-width:28px">B</button>
                        <button class="word-toolbar-btn italic" id="rteBtn_italic" onclick="rteToggleFormat('italic')" title="Italic (Ctrl+I)" style="min-width:28px">I</button>
                        <button class="word-toolbar-btn underline" id="rteBtn_underline" onclick="rteToggleFormat('underline')" title="Underline (Ctrl+U)" style="min-width:28px">U</button>
                        <button class="word-toolbar-btn line-through text-sm" id="rteBtn_strikethrough" onclick="rteToggleFormat('strikethrough')" title="Strikethrough" style="min-width:28px">S</button>
                        <div class="word-toolbar-sep"></div>
                        <button class="word-toolbar-btn" onclick="rteExec('justifyLeft')" title="Align Left"><i class="fas fa-align-left"></i></button>
                        <button class="word-toolbar-btn" onclick="rteExec('justifyCenter')" title="Align Center"><i class="fas fa-align-center"></i></button>
                        <button class="word-toolbar-btn" onclick="rteExec('justifyRight')" title="Align Right"><i class="fas fa-align-right"></i></button>
                        <button class="word-toolbar-btn" onclick="rteExec('justifyFull')" title="Justify"><i class="fas fa-align-justify"></i></button>
                        <div class="word-toolbar-sep"></div>
                        <button class="word-toolbar-btn" onclick="rteExec('indent')" title="Indent"><i class="fas fa-indent"></i></button>
                        <button class="word-toolbar-btn" onclick="rteExec('outdent')" title="Outdent"><i class="fas fa-outdent"></i></button>
                        <div class="word-toolbar-sep"></div>
                        <label class="word-toolbar-btn" title="Text Color" style="cursor:pointer;position:relative"><i class="fas fa-font" id="rteFontColorIcon"></i><input type="color" id="rteForeColor" value="#000000" style="position:absolute;width:1px;height:1px;opacity:0;left:0;top:0" onchange="rteExec('foreColor',this.value);document.getElementById('rteFontColorIcon').style.color=this.value"></label>
                        <label class="word-toolbar-btn" title="Highlight" style="cursor:pointer;position:relative"><i class="fas fa-highlighter" id="rteHiliteIcon" style="color:#fc0"></i><input type="color" id="rteHiliteColor" value="#ffff00" style="position:absolute;width:1px;height:1px;opacity:0;left:0;top:0" onchange="rteExec('hiliteColor',this.value)"></label>
                        <div class="word-toolbar-sep"></div>
                        <select class="word-toolbar-btn py-0.5 px-1" style="min-width:74px;font-size:11px" onchange="rteSetLineHeight(this.value)" title="Line Spacing" id="rteLineSpacing">
                            <option value="">≡ Spacing</option><option value="1">Single</option><option value="1.2">1.2</option><option value="1.5">1.5</option><option value="2">Double</option><option value="2.5">2.5</option><option value="3">Triple</option>
                        </select>
                        <div class="word-toolbar-sep"></div>
                        <button class="word-toolbar-btn" onclick="saveRteContent()" title="Save layout" style="background:#0A4038;color:#fff;border-color:#0A4038"><i class="fas fa-save"></i> Save</button>
                        <button class="word-toolbar-btn" onclick="resetRteContent()" title="Reset to original layout" style="color:#dc2626;border-color:#fca5a5"><i class="fas fa-undo"></i> Reset</button>
                    </div>
                    <div class="flex items-center gap-2 mt-1 flex-wrap">
                        <span class="text-xs text-gray-500"><i class="fas fa-info-circle mr-1 text-brand"></i>Select text then use toolbar to format. <kbd>Shift+Enter</kbd> = new line &nbsp;·&nbsp; <kbd>Shift+A</kbd> = select all &nbsp;·&nbsp; <kbd>Ctrl+B/I/U</kbd> = bold/italic/underline.</span>
                    </div>
                </div>
                <div id="detailContent" class="bg-white overflow-auto" style="max-height:72vh;cursor:default;"></div>
                <div class="flex justify-end gap-2 p-2 border-t bg-gray-50 rounded-bl-lg">
                    <button onclick="closeDetailModal()" class="px-3 py-1.5 bg-gray-200 rounded hover:bg-gray-300 font-medium text-sm">Close</button>
                    <button onclick="editCurrentChallan()" id="viewEditBtn" class="px-3 py-1.5 bg-blue-600 text-white rounded hover:bg-blue-700 font-medium text-sm" style="display:none"><i class="fas fa-edit mr-1"></i>Edit</button>
                    <button onclick="printChallan()" class="px-3 py-1.5 bg-brand text-white rounded hover:bg-brand-dark font-medium text-sm"><i class="fas fa-print mr-1"></i>Print</button>
                </div>
            </div>
        </div>
    </div>

