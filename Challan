/* ===== Server Config Functions ===== */
function cfgToJsString(cfg){
    var keys=Object.keys(cfg);
    var lines=['const firebaseConfig = {'];
    keys.forEach(function(k,i){
        lines.push('  '+k+': "'+cfg[k]+'"'+(i<keys.length-1?',':''));
    });
    lines.push('};');
    return lines.join('\n');
}

function openServerModal(){
    /* Always show the currently active Firebase config (resolved at startup) */
    document.getElementById('srv_configJson').value = cfgToJsString(firebaseConfig);
    var hasPrev=!!sessionStorage.getItem('prevServerConfig_ch');
    document.getElementById('srvPrevInfo').classList.toggle('hidden',!hasPrev);
    document.getElementById('srvRestoreBtn').disabled=!hasPrev;
    document.getElementById('serverModal').classList.remove('hidden');
    document.body.style.overflow='hidden';
}

function closeServerModal(){
    document.getElementById('serverModal').classList.add('hidden');
    document.body.style.overflow='';
}

function parseServerConfigInput(raw){
    /* Accept plain JSON or JS-style: const firebaseConfig = { ... }; */
    var s=raw.trim();
    /* Strip JS variable declaration wrapper if present */
    s=s.replace(/^\s*(?:const|var|let)\s+\w+\s*=\s*/,'').replace(/;\s*$/,'').trim();
    /* Quote unquoted object keys (handles standard JS object literal syntax) */
    s=s.replace(/([{,]\s*)([a-zA-Z_$][a-zA-Z0-9_$]*)\s*:/g,'$1"$2":');
    return JSON.parse(s);
}

function saveServerConfig(){
    var raw=document.getElementById('srv_configJson').value.trim();
    var newCfg;
    try { newCfg=parseServerConfigInput(raw); } catch(e){ showToast('Invalid config — please check the format','error'); return; }
    if(typeof newCfg!=='object'||Array.isArray(newCfg)){showToast('Config must be an object','error');return;}
    if(!newCfg.apiKey||!newCfg.databaseURL){showToast('apiKey and databaseURL are required','error');return;}
    /* Save previous config before overwriting */
    var currentSaved=localStorage.getItem('serverConfig');
    sessionStorage.setItem('prevServerConfig_ch', currentSaved||JSON.stringify(DEFAULT_SERVER_CONFIG));
    localStorage.setItem('serverConfig', JSON.stringify(newCfg));
    closeServerModal();
    showToast('Server config saved! Reloading...','success');
    setTimeout(function(){ window.location.reload(); }, 1200);
}

function restoreServerConfig(){
    var prev=sessionStorage.getItem('prevServerConfig_ch');
    if(!prev){showToast('No previous config to restore','error');return;}
    localStorage.setItem('serverConfig',prev);
    sessionStorage.removeItem('prevServerConfig_ch');
    closeServerModal();
    showToast('Previous server config restored! Reloading...','success');
    setTimeout(function(){ window.location.reload(); }, 1200);
}

