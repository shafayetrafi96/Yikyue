function handleSubmit(e){
    e.preventDefault();
    
    if(editingRowIdx > -1){
        showToast('Please save or cancel the row edit first.','error');
        return;
    }

    var dt=document.getElementById('entryDate').value;
    var ap=document.getElementById('entryAttention').value.trim();
    var og=document.getElementById('entryOrganization').value.trim();
    var mb=document.getElementById('entryMobile').value.trim();
    var its=currentFormItems.slice();

    if(!dt||!ap||!og){showToast('Fill required fields','error');return;}
    if(!its.length){showToast('Add items','error');return;}

    if(isEditing){
        var idx=challans.findIndex(function(c){return c._id===editingId;});
        if(idx!==-1){
            challans[idx].date=dt;
            challans[idx].attentionPerson=ap;
            challans[idx].organization=og;
            challans[idx].mobile=mb;
            challans[idx].items=its;
            showToast('Challan '+challans[idx].challanNo+' updated!','success');
            var viewId=editingId;
            commitAction();
            resetForm();
            viewChallan(viewId);
        }
    }else{
        var cn=getNextChallanNo();
        if(challans.find(function(c){return c.challanNo===cn;})){showToast('Sequence error, please retry','error');return;}
        
        addSuggestion('attentionPersons',ap);
        addSuggestion('organizations',og);
        addSuggestion('mobiles',mb);
        
        var en={date:dt,challanNo:cn,attentionPerson:ap,organization:og,mobile:mb,items:its,deviceId:currentDeviceId,_id:'ch_'+Date.now()+'_'+Math.random().toString(36).substr(2,9)};
        challans.push(en);
        
        var nid=en._id;
        commitAction();
        syncChallanToProductRegister(en);
        resetForm();
        viewChallan(nid);
    }
}

