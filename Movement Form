            } else {
                showToast(`No valid entries found in ${files.length} PDF(s). Column order: Date, Name, ID, Destination, Purpose, From, Exiting, Entering`, 'error');
            }

            progressEl.classList.add('hidden');
            event.target.value = '';
        }

        async function parseSinglePdf(file) {
            return new Promise((resolve, reject) => {
                const fileReader = new FileReader();
                fileReader.onload = async function() {
                    try {
                        const typedArray = new Uint8Array(this.result);
                        const pdf = await pdfjsLib.getDocument(typedArray).promise;
                        let allItems = [];
                        for (let i = 1; i <= pdf.numPages; i++) {
                            const page = await pdf.getPage(i);
                            const tc = await page.getTextContent();
                            tc.items.forEach(item => { if (item.str.trim() !== "") allItems.push({ page: i, x: item.transform[4], y: item.transform[5], text: item.str.trim() }); });
                        }
                        allItems.sort((a,b) => { if (a.page !== b.page) return a.page - b.page; if (Math.abs(a.y - b.y) > 2) return b.y - a.y; return a.x - b.x; });
                        let rows = [], curRow = [], curY = null;
                        allItems.forEach(item => { if (curY === null || Math.abs(item.y - curY) > 2) { if (curRow.length > 0) rows.push(curRow); curRow = [item]; curY = item.y; } else curRow.push(item); });
                        if (curRow.length > 0) rows.push(curRow);
                        let textRows = rows.map(r => { r.sort((a,b) => a.x - b.x); return r.map(i => i.text); });

                        let dataStartIdx = 0;
                        const hk = ['date','name','id','dest','purpose','from','exit','enter','sl','no'];
                        for (let i = 0; i < Math.min(textRows.length, 5); i++) {
                            const rt = textRows[i].join(' ').toLowerCase();
                            if (hk.some(kw => rt.includes(kw)) && !textRows[i].some(c => parseDateSmart(c))) { dataStartIdx = i + 1; break; }
                        }

                        let extracted = [];
                        for (let i = dataStartIdx; i < textRows.length; i++) {
                            const row = textRows[i];
                            if (row.filter(c => c.trim() !== '').length < 2) continue;
                            let startIdx = -1;
