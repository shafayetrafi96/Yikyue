        function formatTripRange(rangeStr){
            if(!rangeStr) return '';
            const parts = rangeStr.split(' to ');
            if(parts.length===1){ const d=new Date(parts[0]+'T00:00:00'); if(isNaN(d.getTime())) return rangeStr; return d.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'}); }
            const d1=new Date(parts[0]+'T00:00:00'), d2=new Date(parts[1]+'T00:00:00');
            if(isNaN(d1.getTime())||isNaN(d2.getTime())) return rangeStr;
            if(d1.getMonth()===d2.getMonth()&&d1.getFullYear()===d2.getFullYear()){
                return d1.getDate()+'-'+d2.getDate()+' '+d2.toLocaleDateString('en-GB',{month:'long',year:'numeric'});
            }
            return d1.toLocaleDateString('en-GB',{day:'numeric',month:'long'})+' - '+d2.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'});
        }

        function handleSubmit(e){
            e.preventDefault();
            if(editingId){ saveInlineEdit(editingId); return; }
            const d=document.getElementById('entryDate').value,n=document.getElementById('entryName').value,id=document.getElementById('entryIDDisplay').value,ds=document.getElementById('entryDest').value,p=document.getElementById('entryPurpose').value,f=document.getElementById('entryFrom').value,ot=convertTo24Hour(document.getElementById('entryOutTime').value),it=convertTo24Hour(document.getElementById('entryInTime').value);
            if(!d||!n||!id||!ds||!p){alert("Date, Name, ID No., Destination, and Purpose are required.");return;}
            const isLongTrip=document.getElementById('longTripCheck').checked;
            if(isLongTrip){
                const rawDates=d.trim();
                const selectedDates=rawDates.split(', ').map(s=>s.trim()).filter(s=>s.match(/^\d{4}-\d{2}-\d{2}$/));
                if(!selectedDates.length){alert('Please select at least one date for the long trip.');return;}
                selectedDates.forEach(sd=>{
                    const tripEntry={date:sd,name:n,idNo:id,dest:ds,purpose:p,from:f,outTime:ot,inTime:it,longTrip:true,deviceId:currentDeviceId};
                    tripEntry._id='entry_'+Date.now()+'_'+Math.random().toString(36).substr(2,9);
                    movements.push(tripEntry);
                });
            } else {
            const entry={date:d,name:n,idNo:id,dest:ds,purpose:p,from:f,outTime:ot,inTime:it,longTrip:false,deviceId:currentDeviceId};
            entry._id='entry_'+Date.now()+'_'+Math.random().toString(36).substr(2,9);
            movements.push(entry);
            } // end else (not longTrip)
            
            // Save Pair Suggestion - only add bare pair if no existing pair (with or without dept) already exists
            if(n && id) {
                const existingPairs = getMergedSuggestions('nameIdPairs');
                const pairAlreadyExists = existingPairs.some(k => {
                    const pm = k.match(/^(.+?)\s+\(([^)]+)\)/);
                    return pm && pm[1] === n && pm[2] === id;
                });
                if(!pairAlreadyExists) {
                    addSuggestion('nameIdPairs', `${n} (${id})`);
                }
            }
            // Save others
            addSuggestion('destinations',ds);addSuggestion('purposes',p);addSuggestion('froms',f);
            
            saveDevicePrefs(n,id);
            commitAction();
            clearForm();
            applyDevicePrefs({name:n,idNo:id});
            currentPersonName=n;
            const savedCount=isLongTrip?document.getElementById('longTripCheck').checked?0:1:1;
