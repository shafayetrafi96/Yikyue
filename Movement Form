                }

                progressBar.style.width = `${((f+1) / files.length) * 100}%`;
                await new Promise(r => setTimeout(r, 200));
            }

            if (allExtracted.length > 0) {
                const newEntries = allExtracted.filter(e => !isDuplicateEntry(e));
                newEntries.forEach(e => { 
                    addSuggestion('nameIdPairs', `${e.name} (${e.idNo})`); // Add pair suggestion
