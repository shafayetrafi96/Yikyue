        function processAndRender(){let u=false;movements.forEach(m=>{if(!m._id){m._id='gen_'+Date.now()+'_'+Math.random().toString(36).substr(2,9);u=true;}});if(u)saveData('movements',movements);populateMonthFilter();renderTable();updateCounters();}
        
        /* --- Default to Current Month --- */
        function populateMonthFilter(){
            const s=document.getElementById('monthFilter');
            if(!s) return;
            const cv=s.value;
            const ms=new Set();

            // 1. Add current YYYY-MM explicitly to the set so it always appears
            const d = new Date();
            const currentYM = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
            ms.add(currentYM);

            movements.forEach(m=>{
                if(m.date){
                    const d2=new Date(m.date);
                    if(!isNaN(d2.getTime()))ms.add(`${d2.getFullYear()}-${String(d2.getMonth()+1).padStart(2,'0')}`);
                }
            });
            const so=Array.from(ms).sort().reverse();
            s.innerHTML='<option value="all">All Months</option>';
            so.forEach(m=>{
                const o=document.createElement('option');
                o.value=m;
                o.textContent=new Date(m+'-02').toLocaleDateString('en-US',{year:'numeric',month:'long'});
                s.appendChild(o);
            });
            
            // 2. Logic to set default value:
            // If there's an existing valid selection, keep it.
            // Otherwise, default to the Current Month.
            if(cv && so.includes(cv)){
                s.value=cv;
            } else {
                s.value = currentYM;
            }
        }

        function renderTable(){
            const mf=document.getElementById('monthFilter').value;
            const st=document.getElementById('searchInput').value.toLowerCase();
            const tb=document.getElementById('tableBody');
            if(!tb) return;
            document.getElementById('thSelectAll').classList.toggle('hidden',!isAdmin);
            
            let fl=movements.filter(m=>{
                let mm=true;
                if(mf!=='all'){
                    const d=new Date(m.date);
                    if(!isNaN(d.getTime()))mm=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`===mf;
                    else mm=false;
                }
                
                /* --- Search by Date (Formatted) --- */
                let ms=true;
                if(st){
                    // Get formatted date (DD/MM/YYYY) to allow searching by visual date
                    let formattedDate = '';
                    if(m.date){
                        const tempDate = new Date(m.date+'T00:00:00');
                        if(!isNaN(tempDate.getTime())){
                            formattedDate = tempDate.toLocaleDateString('en-GB',{day:'2-digit',month:'2-digit',year:'numeric'}).toLowerCase();
                        }
                    }
                    
                    // Check against all string values AND the formatted date
                    const valuesMatch = Object.values(m).some(v => String(v).toLowerCase().includes(st));
                    ms = valuesMatch || formattedDate.includes(st);
                }
                
                return mm&&ms;
            });
            
            // Sort: Newest First
            fl.sort((a,b)=>{const dd=(b.date||'').localeCompare(a.date||'');if(dd!==0)return dd;return(b.outTime||'').localeCompare(a.outTime||'');});
            
            tb.innerHTML='';
            const cc=isAdmin?11:10;
            if(!fl.length){tb.innerHTML=`<tr><td colspan="${cc}" class="py-4 text-center text-gray-500">No entries found.</td></tr>`;return;}

            /* --- Inverted Serial Number --- */
            const totalFiltered = fl.length;

            fl.forEach((m,idx)=>{
                const tr=document.createElement('tr');
                const isEntryOwner = m.deviceId === currentDeviceId;
                const canEdit = isAdmin || isEntryOwner;
                
                const dd=m.date?new Date(m.date+'T00:00:00').toLocaleDateString('en-GB',{day:'2-digit',month:'2-digit',year:'numeric'}):'-';
                const ie=m._id===inlineEditId;
                
                const serialNum = totalFiltered - idx;

                if(true){
                    const rc = m._id===editingId ? 'bg-green-50 ring-2 ring-inset ring-green-400' : (idx % 2 === 0 ? 'bg-white' : 'bg-gray-50');
                    tr.className = `border-b border-gray-200 ${rc} hover:bg-gray-100 transition`;
                    tr.setAttribute('data-entry-id', m._id);
                    let ah = '';
                    if (canEdit) {
                        ah = `<button onclick="startEditMode('${m._id}')" class="text-blue-500 hover:text-blue-700 mr-2" title="Edit"><i class="fas fa-edit"></i></button>`;
                    }
                    if(isAdmin || isEntryOwner) ah += `<button onclick="deleteEntry('${m._id}',event)" class="text-red-500 hover:text-red-700" title="Delete"><i class="fas fa-trash"></i></button>`;
                    let rh = `<td class="py-3 px-4">${serialNum}</td><td class="py-3 px-4 whitespace-nowrap">${dd}${m.longTrip && m.tripDateRange ? '<br><span class="text-xs font-semibold text-brand bg-brand-light px-1.5 py-0.5 rounded mt-0.5 inline-block">' + formatTripRange(m.tripDateRange) + '</span>' : (m.longTrip ? '<br><span class="text-xs font-semibold text-brand bg-brand-light px-1.5 py-0.5 rounded mt-0.5 inline-block">Long Trip</span>' : '')}</td><td class="py-3 px-4 font-medium">${m.name||'-'}</td><td class="py-3 px-4">${m.idNo||'-'}</td><td class="py-3 px-4">${m.dest||'-'}</td><td class="py-3 px-4">${m.purpose||'-'}</td><td class="py-3 px-4">${m.from||'-'}</td><td class="py-3 px-4">${convertTo12Hour(m.outTime)}</td><td class="py-3 px-4">${convertTo12Hour(m.inTime)}</td><td class="py-3 px-4">${ah}</td>`;
                    if(isAdmin) rh = `<td class="py-3 px-4"><input type="checkbox" class="row-check" data-id="${m._id}"></td>` + rh;
                    tr.innerHTML = rh;
