                  try { const dp = localStorage.getItem('mePrefs_' + currentDeviceId); if (dp) applyDevicePrefs(JSON.parse(dp)); } catch(e) {}
                try { const ps = localStorage.getItem('mePersonSugs'); if (ps) personSuggestions = JSON.parse(ps); } catch(e) {}
