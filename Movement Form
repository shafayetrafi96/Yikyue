><td class="py-2 px-3">${e.outTime?convertTo12Hour(e.outTime):'-'}</td><td class="py-2 px-3">${e.inTime?convertTo12Hour(e.inTime):'-'}</td><td class="py-2 px-3">${dup?'<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-red-100 text-red-700"><i class="fas fa-copy mr-1"></i>Dup</span>':'<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-green-100 text-green-700"><i class="fas fa-plus mr-1"></i>New</span>'}</td>`;tb.appendChild(tr);});}

