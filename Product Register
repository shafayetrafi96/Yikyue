        /* ── Build the shared AI extraction prompt ── */
        function buildAiSystemPrompt(selectedType){
            const isIncoming=selectedType==='incoming';
            const dir=isIncoming
                ?'SENDER / SHIPPER (the party who SENT the parcel to you — the originating/sending company)'
                :'RECEIVER / CONSIGNEE (the party who will RECEIVE the parcel — the destination company)';
            const countryDir=isIncoming
                ?'SENDER / SHIPPER address block (the sending/originating side — NOT the receiver or consignee side)'
                :'RECEIVER / CONSIGNEE address block (the destination/receiving side — NOT the sender or shipper side)';
            return 'You are an expert courier waybill data extractor. You will receive one or more rendered images of a courier document (DHL, FedEx, UPS, TNT, Aramex, EMS, Steadfast, Pathao, RedX, Paperfly, eCourier, MFT or any other courier). The waybill always has TWO parties: (1) SHIPPER/SENDER — the party who sent the parcel; (2) CONSIGNEE/RECEIVER — the party who receives it.\n\n'
                +'Read every field, label, stamp, barcode label, and address block carefully. Extract and return ONLY a valid JSON object with exactly these keys:\n'
                +'"date" — shipment/pickup date in YYYY-MM-DD format\n'
                +'"waybillNo" — AWB/waybill/tracking number (digits and hyphens only; take the largest prominent number)\n'
                +'"orgName" — company/organisation name of the '+dir+' — MUST be a company name, NEVER a person\'s individual name\n'
                +'"country" — country from the '+countryDir+' (e.g. "Bangladesh", "United Kingdom")\n'
                +'"item" — description of shipped goods/contents (e.g. "Fabric Samples", "Garment Documents")\n'
                +'"qty" — quantity with unit (e.g. "3 pcs", "1 carton") or empty string\n'
                +'"bearer" — courier/carrier company name as printed (e.g. "DHL", "FedEx", "Steadfast")\n'
                +'"senderContact" — individual person name in the SHIPPER/SENDER block only. Empty string if not found.\n'
                +'"receiverContact" — individual person name in the CONSIGNEE/RECEIVER block only. Empty string if not found.\n\n'
                +'Rules:\n'
                +'- The document may be a scanned image — read it visually from the images.\n'
                +'- "waybillNo": include only the main tracking/AWB number, not sub-numbers.\n'
                +'- "bearer": the courier company name (DHL, FedEx, UPS, Steadfast, Pathao, RedX, Paperfly, eCourier, MFT, Aramex, TNT, Royal Mail, EMS, etc.) or whatever is printed on the document.\n'
                +'- "date": convert any format (DD/MM/YYYY, MM-DD-YYYY, etc.) to YYYY-MM-DD.\n'
                +'- Use empty string for any field you cannot confidently read.\n'
                +'Return ONLY the JSON object. No markdown, no explanation.';
        }

        /* ── OpenRouter extraction (accepts explicit key, throws on failure) ── */
        async function aiExtractViaOpenRouter(fullText,selectedType,pageImages,apiKey){
            if(!apiKey)throw new Error('No API key provided');
            const controller=new AbortController();
            const timeout=setTimeout(()=>controller.abort(),45000);
            try{
                const systemPrompt=buildAiSystemPrompt(selectedType);
                let userContent;
                if(pageImages&&pageImages.length>0){
                    userContent=[{type:'text',text:'Courier waybill PDF rendered as image(s). Read every label, box, stamp, and address block carefully. Extract all fields as JSON.'}];
                    pageImages.forEach(function(dataUrl){userContent.push({type:'image_url',image_url:{url:dataUrl,detail:'auto'}});});
                    if(fullText&&fullText.trim().length>20){userContent.push({type:'text',text:'Supplementary raw text:\n'+fullText.slice(0,3000)});}
                }else{
                    userContent='Courier PDF text:\n\n'+fullText.slice(0,8000);
                }
                const resp=await fetch(OPENROUTER_ENDPOINT,{
                    method:'POST',
                    headers:{'Content-Type':'application/json','Authorization':'Bearer '+apiKey,'HTTP-Referer':window.location.origin,'X-Title':'YIK YUE Product Register'},
                    body:JSON.stringify({model:OPENROUTER_MODEL,messages:[{role:'system',content:systemPrompt},{role:'user',content:userContent}],response_format:{type:'json_object'},temperature:0,max_tokens:600}),
                    signal:controller.signal
                });
                clearTimeout(timeout);
                if(!resp.ok){
                    let errMsg='HTTP '+resp.status+' '+resp.statusText;
                    try{const eBody=await resp.json();errMsg=eBody?.error?.message||eBody?.message||errMsg;}catch(ignored){}
                    throw new Error(errMsg);
                }
                const data=await resp.json();
                const raw=data?.choices?.[0]?.message?.content;
                if(!raw)throw new Error('Empty response from OpenRouter');
                let ai;
                try{ai=JSON.parse(raw);}catch(e){const m=raw.match(/\{[\s\S]*\}/);if(!m)throw new Error('Non-JSON response');ai=JSON.parse(m[0]);}
                ai._source='openrouter';
                return ai;
            }finally{
                clearTimeout(timeout);
            }
        }

        /* ── Fallback: try each key in sequence ── */
        async function aiExtractWithFallback(fullText,selectedType,pageImages){
            const keys=getOpenRouterKeys();
            if(keys.length===0)return null;
            let lastErr=null;
            for(let i=0;i<keys.length;i++){
                try{
                    const result=await aiExtractViaOpenRouter(fullText,selectedType,pageImages,keys[i]);
                    if(result)return result;
                }catch(err){
                    lastErr=err;
                    console.warn(`OpenRouter key ${i+1} failed:`,err.message);
                    if(i<keys.length-1){
                        showToast(`⚠️ Key ${i+1} failed — trying key ${i+2}…`,'info');
                    }
                }
            }
            // All keys failed — show error modal
            const msg=lastErr?lastErr.message:'All API keys failed';
            showApiErrorModal('OpenRouter AI Failed',msg,keys.length);
            return null;
        }

        /* ── Main AI extractor ── */
        async function aiExtractAllFields(fullText,selectedType,pageImages){
            return await aiExtractWithFallback(fullText,selectedType,pageImages);
        }

        /* ── Pattern-based extraction (no key needed, best-effort) ── */
        function patternExtractEntry(fullText,selectedType,entry){
            // ── AWB / tracking number ──
            const awbPatterns=[
                /\b(\d{10})\b/g,
                /AWB\s*(?:No\.?|#|Number)?\s*[:\-]?\s*([\d][\d \-]{7,16})/i,
                /(?:Waybill|Airwaybill)\s*(?:No\.?|#)?\s*[:\-]?\s*([\d]{8,14})/i,
                /(?:Tracking|Reference|Shipment)\s*(?:No\.?|#|ID)?\s*[:\-]?\s*([\d][\d \-]{7,16})/i,
                /(?:^|\n)\s*(\d{9,14})\s*(?:\n|$)/m,
            ];
            for(const pat of awbPatterns){
                const m=typeof pat.exec==='function'&&pat.global?null:fullText.match(pat);
                if(m&&m[1]){const n=m[1].replace(/[^\d]/g,'');if(n.length>=8&&n.length<=15){entry.awbNo=n;break;}}
                if(pat.global){let gm;pat.lastIndex=0;while((gm=pat.exec(fullText))!==null){const n=gm[1]||gm[0];const d=n.replace(/[^\d]/g,'');if(d.length>=8&&d.length<=15){entry.awbNo=d;break;}}}
                if(entry.awbNo)break;
            }
            // ── Date ──
            const datePatterns=[
                /(?:Shipment|Ship|Pickup|Dispatch|Collection)\s*Date\s*[:\-]?\s*(\d{4}[-\/]\d{2}[-\/]\d{2})/i,
                /(?:Shipment|Ship|Pickup|Dispatch)\s*Date\s*[:\-]?\s*(\d{1,2}[\s\/\-\.]\w{3}[\s\/\-\.]\d{2,4})/i,
                /(?:Shipment|Ship|Pickup|Dispatch)\s*Date\s*[:\-]?\s*(\d{1,2}[\s\/\-\.]\d{1,2}[\s\/\-\.]\d{2,4})/i,
                /(\d{4}-\d{2}-\d{2})\s+MY\s*DHL/i,
                /Date\s*[:\-]?\s*(\d{1,2}[\s\/\-\.]\d{1,2}[\s\/\-\.]\d{2,4})/im,
                /\b(\d{2}[\-\/]\d{2}[\-\/]\d{4})\b/,
                /\b(\d{4}[\-\/]\d{2}[\-\/]\d{2})\b/,
            ];
            for(const pat of datePatterns){
                const m=fullText.match(pat);
                if(m&&m[1]){const d=parseDateSmart(m[1]);if(d){entry.date=d;break;}}
            }
            // ── Carrier ──
            const carriers=[['DHL'],['FedEx','Federal Express'],['UPS'],['Aramex'],['TNT'],['Royal Mail'],['EMS','Express Mail'],['Steadfast'],['Pathao'],['RedX','Red X'],['Paperfly'],['eCourier','e-Courier'],['MFT'],['Leopards'],['TCS'],['Blue Dart'],['DTDC']];
            for(const names of carriers){
                const pat=new RegExp('\\b('+names.join('|')+')\\b','i');
                const m=fullText.match(pat);
                if(m){entry.bearer=names[0];break;}
            }
            // ── Organisation ──
            const cleanOrg=s=>s.trim().replace(/\s+/g,' ').replace(/\s*(Contact|Attention|Attn|Address|Phone|Tel|Fax|Email|Ref)[:\s].*$/i,'').trim();
            const countryList=['United Kingdom','United States','Bangladesh','India','China','Germany','France','Italy','Spain','Netherlands','Belgium','Sweden','Norway','Denmark','Finland','Switzerland','Austria','Australia','Japan','South Korea','Singapore','Hong Kong','Thailand','Vietnam','Indonesia','Malaysia','Philippines','Pakistan','Sri Lanka','Nepal','UAE','Saudi Arabia','Turkey','Brazil','Canada','Mexico','Ireland','Portugal','Poland','Czech Republic','New Zealand','South Africa'];
            let orgMatch=null,orgBlockStart=-1;
            if(selectedType==='incoming'){
                const pats=[
                    /(?:Shipper|Sender|From)\s*(?:Name|Company)?\s*[:\-]?\s*\n?\s*([A-Za-z][^\n\r]{2,80})/i,
                    /(?:^|\n)\s*From\s*[:\-]\s*([A-Za-z][^\n\r]{2,80})/im,
                    /\bShipper\b[^\n]*\n\s*([A-Za-z][^\n\r]{2,80})/i,
                ];
                for(const p of pats){const m=fullText.match(p);if(m){orgMatch=m;orgBlockStart=fullText.indexOf(m[0]);break;}}
            }else{
                const pats=[
                    /(?:Consignee|Receiver|Recipient|To)\s*(?:Name|Company)?\s*[:\-]?\s*\n?\s*([A-Za-z][^\n\r]{2,80})/i,
                    /(?:^|\n)\s*To\s*[:\-]\s*([A-Za-z][^\n\r]{2,80})/im,
                    /\bConsignee\b[^\n]*\n\s*([A-Za-z][^\n\r]{2,80})/i,
                ];
                for(const p of pats){const m=fullText.match(p);if(m){orgMatch=m;orgBlockStart=fullText.indexOf(m[0]);break;}}
            }
            if(orgMatch&&orgMatch[1]){
                entry.orgName=cleanOrg(orgMatch[1]);
                if(orgBlockStart!==-1){
                    const blockText=fullText.substring(orgBlockStart,orgBlockStart+800);
                    let foundCountry='';
                    for(const line of blockText.split('\n').map(l=>l.trim()).filter(l=>l)){
                        for(const c of countryList){if(new RegExp('\\b'+c.replace(/\s+/g,'\\s+')+'\\b','i').test(line)){foundCountry=c;break;}}
                        if(foundCountry)break;
                    }
                    if(foundCountry&&entry.orgName){const suffix=foundCountry==='United Kingdom'?'UK':foundCountry;entry.orgName+=' ('+suffix+')';}
                }
            }
            // ── Contents / Particulars ──
            const contPatterns=[
                /(?:Contents|Description of Goods|Goods Description|Nature of Goods|Item Description|Commodity|Shipment Contents)\s*[:\-]?\s*\n?\s*([A-Za-z][^\n\r]{1,120})/i,
                /(?:Content|Reference|Description)\s*[:\-]?\s*([A-Za-z][^\n\r]{1,80})/i,
            ];
            for(const p of contPatterns){const m=fullText.match(p);if(m&&m[1]){entry.particulars=m[1].trim();break;}}
            const qtyMatch=fullText.match(/\b(\d+)\s*(PCS|PIECES|SET|SETS|PAIR|PAIRS|ROLL|ROLLS|BOX|BOXES|UNIT|UNITS|DOZEN|EA|PACK|PACKS|CTN|CTNS|SAMPLE|SAMPLES|KG|KGS|CARTON|CARTONS)\b/i);
            if(qtyMatch&&entry.particulars)entry.particulars=qtyMatch[1]+' '+qtyMatch[2].toLowerCase()+' '+entry.particulars;
            else if(qtyMatch)entry.particulars=qtyMatch[1]+' '+qtyMatch[2].toLowerCase();
            if(!entry.particulars&&entry.awbNo)entry.particulars='Courier Document (AWB: '+entry.awbNo+')';
            return entry;
        }

        /* ── Apply AI result to entry object ── */
        function applyAiResult(ai,entry,selectedType){
            if(ai.date)entry.date=parseDateSmart(ai.date)||ai.date;
            if(ai.waybillNo){
                const n=String(ai.waybillNo).replace(/[^\d\-]/g,'').replace(/^-+|-+$/g,'');
                if(n.replace(/[^\d]/g,'').length>=6)entry.awbNo=n;
                else entry.awbNo=String(ai.waybillNo).trim();
            }
            if(ai.bearer&&ai.bearer.trim())entry.bearer=ai.bearer.trim();
            if(ai.orgName&&ai.orgName.trim()){
                let org=ai.orgName.trim();
                const country=(ai.country&&ai.country.trim())||'';
                if(country&&!/\([^()]*\)\s*$/.test(org))org+=' ('+country+')';
                entry.orgName=org;
            }
            if(ai.item||ai.qty){
                const combined=[(ai.qty||'').trim(),(ai.item||'').trim()].filter(Boolean).join(' ');
                if(combined)entry.particulars=combined;
            }
            const _cpRaw=selectedType==='incoming'?(ai.senderContact||''):(ai.receiverContact||'');
            if(_cpRaw&&_cpRaw.trim()){
                const sp=_cpRaw.trim();
                const looksLikeCompany=/\b(ltd|limited|llc|inc|corp|company|co\.|gmbh|pte|plc|enterprises|group|holdings|commercial|industries|trading|garments|textile)\b/i.test(sp);
                if(!looksLikeCompany)entry.remarks=(selectedType==='incoming'?'Sent by ':'Sent to ')+sp;
            }
        }

        /* ── Progress helpers ── */
        function showProgress(label,pct,badgeHtml){
            const wrap=document.getElementById('pdfProgressWrap');
            const lbl=document.getElementById('pdfProgressLabel');
            const bar=document.getElementById('pdfProgressBar');
            const badge=document.getElementById('pdfAiBadge');
            if(wrap)wrap.classList.remove('hidden');
            if(lbl)lbl.textContent=label;
            if(bar)bar.style.width=pct+'%';
            if(badge){if(badgeHtml){badge.innerHTML=badgeHtml;badge.classList.remove('hidden');}else badge.classList.add('hidden');}
        }
        function hideProgress(){
            const wrap=document.getElementById('pdfProgressWrap');
            if(wrap)wrap.classList.add('hidden');
        }

        /* ── Helper: read file as ArrayBuffer (supports older browsers) ── */
        function fileToArrayBuffer(file){
            if(file.arrayBuffer)return file.arrayBuffer();
            return new Promise((resolve,reject)=>{
                const reader=new FileReader();
                reader.onload=e=>resolve(e.target.result);
                reader.onerror=()=>reject(new Error('FileReader error'));
                reader.readAsArrayBuffer(file);
            });
        }

        /* ── Main PDF upload handler ── */
        async function handleCourierPdfUpload(event){
            const files=event.target.files;if(!files||files.length===0)return;
            const selectedType=document.getElementById('courierTypeSelect').value;
            const uploadBtn=document.getElementById('courierUploadBtn');
            const noAiNotice=document.getElementById('noAiKeyNotice');
            const hasAnyKey=getOpenRouterKeys().length>0;
            if(noAiNotice)noAiNotice.classList.toggle('hidden',hasAnyKey);
            let btnOrigHtml=null;
            if(uploadBtn){btnOrigHtml=uploadBtn.innerHTML;uploadBtn.disabled=true;uploadBtn.innerHTML='<i class="fas fa-spinner fa-spin mr-2"></i>Processing...';}
            try{
                for(let f=0;f<files.length;f++){
                    const fileName=files[f].name;
                    showProgress('Reading PDF…',5,'');
                    try{
                        // ── Load PDF with cMap support (fixes text extraction on many PDFs) ──
                        let arrayBuffer;
                        try{
                            arrayBuffer=await fileToArrayBuffer(files[f]);
                        }catch(readErr){
                            throw new Error('Cannot read file: '+readErr.message);
                        }

                        let pdf;
                        try{
                            pdf=await pdfjsLib.getDocument({
                                data:arrayBuffer,
                                cMapUrl:PDFJS_CMAP_URL,
                                cMapPacked:true,
                                verbosity:0,
                                disableRange:false,
                                disableStream:false
                            }).promise;
                        }catch(pdfLoadErr){
                            // If worker-based load fails, try without worker as fallback
                            console.warn('PDF.js worker load failed, retrying without worker:',pdfLoadErr);
                            try{
                                const savedWorkerSrc=pdfjsLib.GlobalWorkerOptions.workerSrc;
                                pdfjsLib.GlobalWorkerOptions.workerSrc='';
                                pdf=await pdfjsLib.getDocument({data:new Uint8Array(arrayBuffer),verbosity:0}).promise;
                                pdfjsLib.GlobalWorkerOptions.workerSrc=savedWorkerSrc;
                            }catch(fallbackErr){
                                throw new Error('PDF could not be loaded. It may be password-protected, corrupted, or in an unsupported format. ('+fallbackErr.message+')');
                            }
                        }

                        // ── Render pages as images (up to 2 pages) ──
                        let pageImages=[];
                        const maxImgPages=Math.min(pdf.numPages,2);
                        for(let pi=1;pi<=maxImgPages;pi++){
                            showProgress(`Rendering page ${pi}/${maxImgPages}…`,10+pi*20,'');
                            try{
                                const pg=await pdf.getPage(pi);
                                const baseVp=pg.getViewport({scale:1.0});
                                const imgScale=Math.min(2.0,1600/Math.max(baseVp.width,baseVp.height,1));
                                const vp=pg.getViewport({scale:imgScale});
                                const cvs=document.createElement('canvas');
                                cvs.width=Math.round(vp.width);cvs.height=Math.round(vp.height);
                                const ctx2d=cvs.getContext('2d');
                                if(!ctx2d)throw new Error('Canvas 2D context unavailable');
                                await pg.render({canvasContext:ctx2d,viewport:vp}).promise;
                                pageImages.push(cvs.toDataURL('image/jpeg',0.82));
                            }catch(imgErr){
                                console.warn('Page '+pi+' render failed:',imgErr.message);
                                // Continue — text extraction still works
                            }
                        }

                        // ── Extract text layer (used as supplement) ──
                        showProgress('Extracting text…',60,'');
                        let allItems=[];
                        try{
                            for(let i=1;i<=pdf.numPages;i++){
                                const page=await pdf.getPage(i);
                                const tc=await page.getTextContent({normalizeWhitespace:true,disableCombineTextItems:false});
                                tc.items.forEach(item=>{if(item.str&&item.str.trim()!=='')allItems.push({page:i,x:item.transform[4],y:item.transform[5],text:item.str.trim()});});
                            }
                        }catch(textErr){
                            console.warn('Text extraction failed:',textErr.message);
                            // pageImages still available for AI
                        }
                        allItems.sort((a,b)=>{if(a.page!==b.page)return a.page-b.page;if(Math.abs(a.y-b.y)>3)return b.y-a.y;return a.x-b.x;});
                        let lines=[],curLineItems=[],curY=null;
                        allItems.forEach(item=>{if(curY===null||Math.abs(item.y-curY)>3){if(curLineItems.length>0)lines.push({y:curY,text:curLineItems.map(i=>i.text).join(' ')});curLineItems=[item];curY=item.y;}else{curLineItems.push(item);}});
                        if(curLineItems.length>0)lines.push({y:curY,text:curLineItems.map(i=>i.text).join(' ')});
                        let fullText=lines.map(l=>l.text).join('\n');

                        let entry={type:selectedType,date:'',particulars:'',style:'',orgName:'',bearer:'',awbNo:'',remarks:'',_aiSource:'pattern'};

                        // ── PRIMARY: AI extraction ──
                        if(hasAnyKey){
                            showProgress('OpenRouter AI reading…',70,'<span class="ai-badge-openrouter"><i class="fas fa-robot mr-1"></i>OpenRouter AI</span>');
                            const ai=await aiExtractAllFields(fullText,selectedType,pageImages);
                            if(ai){
                                applyAiResult(ai,entry,selectedType);
                                entry._aiSource=ai._source||'ai';
                            }else{
                                // AI failed — already showed error modal — use pattern fallback
                                showProgress('Using pattern extraction…',85,'<span class="ai-badge-pattern"><i class="fas fa-code mr-1"></i>Pattern</span>');
                                entry=patternExtractEntry(fullText,selectedType,entry);
                                entry._aiSource='pattern';
                            }
                        }else{
                            showProgress('Extracting with patterns…',70,'<span class="ai-badge-pattern"><i class="fas fa-code mr-1"></i>Pattern</span>');
                            entry=patternExtractEntry(fullText,selectedType,entry);
                            entry._aiSource='pattern';
                        }

                        showProgress('Done!',100,'');

                        // ── Filename fallbacks ──
                        if(!entry.date)entry.date=new Date().toISOString().slice(0,10);
                        if(!entry.awbNo){
                            const fnNums=(fileName.match(/\d{8,15}/g)||[]);
                            if(fnNums.length)entry.awbNo=fnNums.reduce((a,b)=>a.length>=b.length?a:b,'');
                        }
                        if(!entry.bearer){
                            const fn=fileName.toUpperCase();
                            if(fn.includes('DHL'))entry.bearer='DHL';
                            else if(fn.includes('FEDEX'))entry.bearer='FedEx';
                            else if(fn.includes('UPS'))entry.bearer='UPS';
                            else if(fn.includes('STEADFAST'))entry.bearer='Steadfast';
                            else if(fn.includes('PATHAO'))entry.bearer='Pathao';
                            else if(fn.includes('REDX'))entry.bearer='RedX';
                            else if(fn.includes('PAPERFLY'))entry.bearer='Paperfly';
                            else if(fn.includes('ECOURIER'))entry.bearer='eCourier';
                            else if(fn.includes('MFT'))entry.bearer='MFT Courier';
                            else if(fn.includes('AWB'))entry.bearer='DHL';
                        }

                        entry._id='courier_'+Date.now()+'_'+Math.random().toString(36).substr(2,9);
                        entry._fileName=fileName;
                        pendingCourierEntries.push(entry);

                    }catch(err){
                        console.error('PDF Parse Error:',err);
                        showPdfErrorModal(files[f].name, err.message||'Unknown error while processing PDF');
                    }
                }
            }finally{
                setTimeout(()=>hideProgress(),1500);
                if(uploadBtn){uploadBtn.disabled=false;uploadBtn.innerHTML=btnOrigHtml;}
                renderCourierPreview();
                try{event.target.value='';}catch(e){}
            }
        }

        function renderCourierPreview(){
            const preview=document.getElementById('courierPreview'),list=document.getElementById('courierPreviewList'),count=document.getElementById('pendingCount');
            if(pendingCourierEntries.length===0){preview.classList.add('hidden');return;}
            preview.classList.remove('hidden');
            count.textContent=pendingCourierEntries.length+' entr'+(pendingCourierEntries.length===1?'y':'ies');
            const aiSrcLabel={openrouter:'<span class="ai-badge-openrouter"><i class="fas fa-robot mr-1"></i>OpenRouter AI</span>',pattern:'<span class="ai-badge-pattern"><i class="fas fa-code mr-1"></i>Pattern</span>'};
            list.innerHTML=pendingCourierEntries.map((entry,idx)=>`
            <div class="pending-card rounded-lg p-4 shadow-sm">
                <div class="flex justify-between items-center mb-3">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="bg-amber-300 text-amber-900 px-2.5 py-0.5 rounded text-xs font-black">#${idx+1}</span>
                        <span class="text-xs text-gray-500 italic truncate max-w-[160px]"><i class="fas fa-file-pdf mr-1 text-red-400"></i>${escapeHtml(entry._fileName||'')}</span>
                        <span class="${entry.type==='incoming'?'bg-teal-100 text-teal-800':'bg-blue-100 text-blue-800'} px-2 py-0.5 rounded text-xs font-semibold">${entry.type==='incoming'?'Incoming':'Outgoing'}</span>
