        if(sf!=='all')ms=v.status===sf;
        if(st)ms2=Object.values(v).some(function(x){return String(x).toLowerCase().includes(st);});
        if(mfVal&&mfVal!=='all')(ms3=(v.billingDate||'').startsWith(mfVal));
        return ms&&ms2&&ms3;
    }).sort(function(a,b){
        /* Sort by creation time descending — newest bill at top */
        return getCreatedAt(b)-getCreatedAt(a);
    });
    tb.innerHTML='';if(!fl.length){tb.innerHTML='<tr><td colspan="'+(isAdmin?'9':'8')+'" class="py-4 text-center text-gray-500">No vouchers found.</td></tr>';return;}
