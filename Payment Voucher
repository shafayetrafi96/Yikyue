function _rteBeforeInput(e){
    /* Silently block any edit that would affect a [data-field] span.
     * [data-dynamic] sections are NOT blocked — admin can freely edit labels
     * and structure inside them.  Only the actual live field values (payee,
     * date, amounts, description, etc.) are protected.                       */
    var sel=window.getSelection();
    if(!sel||sel.rangeCount===0)return;
    var range=sel.getRangeAt(0);
    var doc=e.currentTarget;
    function isProtected(node){
        while(node&&node!==doc){
            if(node.dataset&&node.dataset.field!==undefined)return true;
            node=node.parentNode;
        }
        return false;
    }
    if(isProtected(range.startContainer)||isProtected(range.endContainer)){e.preventDefault();return;}
    if(!range.collapsed){
        var guarded=doc.querySelectorAll('[data-field]');
        for(var i=0;i<guarded.length;i++){if(range.intersectsNode(guarded[i])){e.preventDefault();return;}}
    }
}

function makeDocEditable(docEl){
    if(!docEl)return;
    docEl.contentEditable='true';
    docEl.classList.add('rte-editable');
    docEl.removeEventListener('keydown',_rteKeyHandler,false);
    docEl.removeEventListener('keyup',_rteUpdateState,false);
    docEl.removeEventListener('mouseup',_rteUpdateState,false);
    docEl.addEventListener('keydown',_rteKeyHandler,false);
    docEl.addEventListener('keyup',_rteUpdateState,false);
    docEl.addEventListener('mouseup',_rteUpdateState,false);
    document.removeEventListener('selectionchange',_rteUpdateState,false);
    document.addEventListener('selectionchange',_rteUpdateState,false);
    /* ── Protect data-field spans and dynamic rows via beforeinput ─────────
     * We do NOT set contentEditable=false or add any CSS to [data-field]
     * spans — the cursor is fully free everywhere including inside tables.
     * beforeinput intercepts and cancels only the actual text mutations.   */
    docEl.removeEventListener('beforeinput',_rteBeforeInput,false);
    docEl.addEventListener('beforeinput',_rteBeforeInput,false);
    /* Prevent enter from creating new divs — use <br> */
    docEl.addEventListener('keydown',function(e){
        if(e.key==='Enter'&&!e.shiftKey){
            /* If cursor is inside a protected node, swallow entirely */
            var sel=window.getSelection();
            if(sel&&sel.rangeCount>0){
                var n=sel.getRangeAt(0).startContainer;
                if(n.nodeType===3)n=n.parentNode;
                while(n&&n!==docEl){
                    if(n.dataset&&n.dataset.field!==undefined){e.preventDefault();return;}
                    n=n.parentNode;
                }
            }
            e.preventDefault();
            document.execCommand('insertHTML',false,'<br><br>');
        }
    },false);
}

function _rteKeyHandler(e){
    /* Shift+Enter = single line break */
    if(e.shiftKey&&e.key==='Enter'){
        e.preventDefault();
        document.execCommand('insertHTML',false,'<br>');
        return;
    }
    /* Shift+A = select all inside doc */
    if(e.shiftKey&&!e.ctrlKey&&!e.metaKey&&e.key.toLowerCase()==='a'){
        e.preventDefault();
        var d=getRteDoc();
        if(d){var r=document.createRange();r.selectNodeContents(d);var s=window.getSelection();s.removeAllRanges();s.addRange(r);}
        return;
    }
    /* Auto-save after typing pause */
    clearTimeout(_rteKeyHandler._t);
    _rteKeyHandler._t=setTimeout(function(){autoSaveRteContent();},1800);
}

