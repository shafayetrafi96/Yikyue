function storeDynamicRowTemplates(root){
    if(!root)return;
    root.querySelectorAll('[data-dynamic]').forEach(function(el){
        var rows=[];
        el.querySelectorAll('tr').forEach(function(tr){
            var cells=[];
            Array.prototype.slice.call(tr.children).forEach(function(td,idx){
                var attrs={};
                Array.prototype.slice.call(td.attributes||[]).forEach(function(a){
                    if(a.name!=='data-field')attrs[a.name]=a.value;
                });
                cells.push({attrs:attrs,html:idx===0?td.innerHTML:''});
            });
            rows.push(cells);
        });
        el.setAttribute('data-template-rows',JSON.stringify(rows));
    });
}
function applyDynamicRowTemplates(el){
    if(!el)return;
    var rows=[];
    try{rows=JSON.parse(el.getAttribute('data-template-rows')||el.getAttribute('data-template-labels')||'[]');}catch(e){rows=[];}
    if(!rows.length)return;
    var isDriverRows=el.getAttribute('data-dynamic')==='driverRows';
    var currentRows=el.querySelectorAll('tr');
    var preserveDriverLiveLabels=isDriverRows&&currentRows.length!==rows.length;
    currentRows.forEach(function(tr,i){
        var rowTpl=rows[i]||[];
        if(typeof rowTpl==='string'){
            var first=tr.querySelector('td,th');
            var keepLiveFirst=isDriverRows&&first&&!/:$/.test(first.textContent.trim());
            if(first&&rowTpl&&!preserveDriverLiveLabels&&!keepLiveFirst)first.innerHTML=rowTpl;
            return;
        }
        Array.prototype.slice.call(tr.children).forEach(function(td,idx){
            var tpl=rowTpl[idx];if(!tpl)return;
            var keepDriverLiveFirst=idx===0&&isDriverRows&&!/:$/.test(td.textContent.trim());
            if(isDriverRows&&td.hasAttribute('rowspan'))return;
            if(tpl.attrs){
                for(var k in tpl.attrs){if(tpl.attrs.hasOwnProperty(k))td.setAttribute(k,tpl.attrs[k]);}
            }
            if(idx===0&&tpl.html&&!preserveDriverLiveLabels&&!keepDriverLiveFirst)td.innerHTML=tpl.html;
        });
    });
}
function sanitizeRteTemplate(root){
    if(!root)return;
    storeDynamicRowTemplates(root);
    root.querySelectorAll('[data-field]').forEach(function(el){el.innerHTML='';});
}
function clearRteBillOverridesForParticulars(particulars){
    if(!particulars)return;
    var targetKey=getLayoutKey(particulars);
    (vouchers||[]).forEach(function(v){
        if(!v||!v._id||getLayoutKey(v.particulars)!==targetKey)return;
        try{localStorage.removeItem('rte_bill_'+v._id);}catch(e){}
        var fbBillKey=encodeFBKey(v._id);
        if(rteBills)delete rteBills[fbBillKey];
        if(isFirebaseConnected&&isDataLoaded){
            db.ref('rteBills/'+fbBillKey).remove().catch(function(e){console.error(e);});
        }
    });
}

function autoSaveRteContent(){
    var d=getRteDoc();if(!d)return;
    var v=vouchers.find(function(x){return x._id===currentViewId;});if(!v)return;
    try{
        /* Clone and strip all live data-field values before saving so the
         * stored template never contains any specific bill's payee/amounts/
         * descriptions.  injectVoucherData() will re-populate these from the
         * voucher object every time the saved template is loaded back.      */
        var clone=d.cloneNode(true);
        sanitizeRteTemplate(clone);
        var payload={html:clone.innerHTML,zoom:currentViewZoom};
        localStorage.setItem('rte_bill_'+v._id,JSON.stringify(payload));
        if(isFirebaseConnected&&isDataLoaded){
            var fbBillKey=encodeFBKey(v._id);
            rteBills[fbBillKey]=payload;
            db.ref('rteBills/'+fbBillKey).set(encodeForFB(payload)).catch(function(e){console.error(e);});
        }
    }catch(e){}
}

function saveRteContent(){
    autoSaveRteContent();
    var d=getRteDoc();if(!d)return;
    var v=vouchers.find(function(x){return x._id===currentViewId;});if(!v)return;
    try{
        /* Save the full admin-edited layout (with data-fields stripped) as the
         * type-level default so every future bill of this particulars type gets
         * the same layout.  injectVoucherData() re-populates data-field spans
         * and data-dynamic rows from the specific bill's data on load.        */
        var clone=d.cloneNode(true);
        sanitizeRteTemplate(clone);
        var typePayload={html:clone.innerHTML,zoom:currentViewZoom};
        localStorage.setItem(getRteTypeKey(v.particulars),JSON.stringify(typePayload));
        clearRteBillOverridesForParticulars(v.particulars);
        if(isFirebaseConnected&&isDataLoaded){
            var fbTypeKey=encodeFBKey(getLayoutKey(v.particulars));
            rteDefaults[fbTypeKey]=typePayload;
            db.ref('rteDefaults/'+fbTypeKey).set(encodeForFB(typePayload)).catch(function(e){console.error(e);});
        }
    }catch(e){}
    showToast('Saved as default for "'+v.particulars+'"','success');
}

function resetRteContent(){
    /* Clear ONLY the per-voucher override — the type-level default saved via
     * "Save as Default" is intentionally preserved so that "Reset to Default"
     * restores the saved template rather than wiping everything.            */
    var key=getRteSaveKey();
    if(key)try{localStorage.removeItem(key);}catch(e){}
    var v=vouchers.find(function(x){return x._id===currentViewId;});
    if(v){
        if(isFirebaseConnected&&isDataLoaded){
            var fbBillKey=encodeFBKey(v._id);
            delete rteBills[fbBillKey];
            db.ref('rteBills/'+fbBillKey).remove().catch(function(e){console.error(e);});
        }
        var hasTypeDefault=false;
        try{
            var fbTypeKey=encodeFBKey(getLayoutKey(v.particulars));
            hasTypeDefault=(rteDefaults&&rteDefaults[fbTypeKey])||!!localStorage.getItem(getRteTypeKey(v.particulars));
        }catch(e){}
        refreshDetailView();
        showToast(hasTypeDefault?'Restored saved default for "'+v.particulars+'"'  :'Reset to original layout','success');
    }else{
        refreshDetailView();
        showToast('Reset to original layout','success');
    }
}

function loadRteSavedContent(docEl){
    var v=vouchers.find(function(x){return x._id===currentViewId;});if(!v)return false;
    /* Shared helper: apply a saved payload (html + zoom) to docEl, then
     * selectively re-inject live voucher data so [data-field] spans and
     * [data-dynamic] rows always show the current bill's values.           */
    function applyPayload(p){
        if(!p)return false;
        if(p.html){docEl.innerHTML=p.html;injectVoucherData(docEl,v);}
        if(p.zoom){currentViewZoom=parseFloat(p.zoom)||currentViewZoom;docEl.style.zoom=p.zoom;}
        return !!(p.html||p.zoom);
    }
    /* 1. Per-voucher edit — Firebase */
    try{
        var fbBillKey=encodeFBKey(v._id);
        if(rteBills&&rteBills[fbBillKey]){var p1=decodeFromFB(rteBills[fbBillKey]);if(applyPayload(p1))return true;}
    }catch(e){}
    /* 2. Per-voucher edit — localStorage fallback */
    try{
        var r1=localStorage.getItem('rte_bill_'+v._id);
        if(r1){var p1b=JSON.parse(r1);if(applyPayload(p1b))return true;}
    }catch(e){}
    /* 3. Type-level template — Firebase (html + zoom) */
    try{
        var fbTypeKey=encodeFBKey(getLayoutKey(v.particulars));
        if(rteDefaults&&rteDefaults[fbTypeKey]){var p2=decodeFromFB(rteDefaults[fbTypeKey]);if(applyPayload(p2))return true;}
    }catch(e){}
    /* 4. Type-level template — localStorage fallback */
    try{
        var r2=localStorage.getItem(getRteTypeKey(v.particulars));
        if(r2){var p2b=JSON.parse(r2);if(applyPayload(p2b))return true;}
    }catch(e){}
    return false;
}

