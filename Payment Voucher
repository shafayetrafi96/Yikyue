/* ===== Calculate Total ===== */
function calculateTotal(){
    var p=document.getElementById('entryParticulars').value.trim();
    var mainAmt=0;
    if(isConveyanceQA(p)){
        document.querySelectorAll('#qaRowsContainer .qa-row-amt').forEach(function(input){mainAmt+=parseFloat(input.value)||0;});
    }else if(isDriverConveyance(p)){
        var dates=collectDriverDates();var numDays=dates.length;
        var bodyRent=parseFloat(document.getElementById('driverBodyRent').value)||0;
        mainAmt+=bodyRent*numDays;
        collectAirportPickups().forEach(function(pk){mainAmt+=pk.amount;});
        collectAirportDrops().forEach(function(dr){mainAmt+=dr.amount;});
        collectKmRows().forEach(function(km){mainAmt+=km.kmDiff*km.kmRate;});
        collectDriverTolls().forEach(function(t){mainAmt+=t.count*t.rate;});
        collectDriverParkings().forEach(function(pk){mainAmt+=pk.count*pk.rate;});
        var lr=parseFloat(document.getElementById('driverLunchRate').value)||0;var lq=parseFloat(document.getElementById('driverLunchQty').value)||0;mainAmt+=lr*lq;
        var oh=parseFloat(document.getElementById('driverOvertimeHours').value)||0,or_=parseFloat(document.getElementById('driverOvertimeRate').value)||0;mainAmt+=oh*or_;
        collectDriverExtras().forEach(function(r){mainAmt+=r.amount;});
        updateKmPreview();
    }else if(isConveyanceBill(p)){
        mainAmt=parseFloat(document.getElementById('entryAmount').value)||0;
    }else{
        mainAmt=parseFloat(document.getElementById('entryAmountDesc').value)||0;
    }
    var extraAmt=0;document.querySelectorAll('#itemsListContainer .item-amt').forEach(function(input){extraAmt+=parseFloat(input.value)||0;});
    var total=mainAmt+extraAmt;
    document.getElementById('totalAmountDisplay').textContent=Number(total).toLocaleString('en-US',{minimumFractionDigits:2});
    return total;
}

