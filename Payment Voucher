        document.getElementById('parkingContainer').innerHTML='';parkingCounter=0;if(dd.parkings&&dd.parkings.length){dd.parkings.forEach(function(p){addDriverParking(p.name,p.count,p.rate);});}
        document.getElementById('driverLunchRate').value=dd.lunchRate||'';document.getElementById('driverLunchQty').value=dd.lunchQty||'';
        if(dd.overtime){document.getElementById('driverOvertimeHours').value=dd.overtime.hours||'';document.getElementById('driverOvertimeRate').value=dd.overtime.rate||'';}
        document.getElementById('driverExtrasContainer').innerHTML='';driverExtraCounter=0;checkExtrasHint();
        if(dd.extras&&dd.extras.length){dd.extras.forEach(function(r){addDriverExtra(r.date,r.description,r.amount);});}
        updateKmPreview();
    }else if(isConveyanceBill(v.particulars)){
        document.getElementById('entryFrom').value=v.from||'';document.getElementById('entryTo1').value=v.to1||'';document.getElementById('entryTo2').value=v.to2||'';
        if(v.tripDate===v.billingDate){document.getElementById('sameAsBilling').checked=true;}else{document.getElementById('sameAsBilling').checked=false;}
        toggleTripDate();if(v.tripDate!==v.billingDate&&v.tripDate)tripDatePicker.setDate(v.tripDate);
        var tt=document.getElementById('entryTripType');if(tt)tt.value=v.tripType||'roundTrip';
