        document.getElementById('airportDropContainer').innerHTML='';airportDropCounter=0;
        var drops=dd.airportDrops||(dd.airportDrop&&dd.airportDrop.amount>0?[dd.airportDrop]:[]);
        if(drops&&drops.length)drops.forEach(function(dr){addAirportDrop(dr.date,dr.amount);});
        document.getElementById('kmRowsContainer').innerHTML='';kmRowCounter=0;
        var _kmRows=dd.kmRows||(dd.kmStart||dd.kmEnd||dd.kmRate?[{kmStart:dd.kmStart||'',kmEnd:dd.kmEnd||'',kmRate:dd.kmRate||0,kmDiff:dd.kmDiff||0}]:[]);
