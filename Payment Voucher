    else if(field==='from'){if(v.from)vals.push(v.from);}
    else if(field==='to1'){if(v.to1)vals.push(v.to1);}
    else if(field==='to2'){if(v.to2)vals.push(v.to2);}
    else if(field==='via'){if(v.via)vals.push(v.via);}
    else if(field==='by'){if(v.by)vals.push(v.by);}
    else if(field==='fromTime'){if(v.fromTime)vals.push(v.fromTime);}
    else if(field==='toTime'){if(v.toTime)vals.push(v.toTime);}
    else if(field==='purpose'){if(v.purpose)vals.push(v.purpose);}
    else if(field==='vehicleNo'){if(v.driverData&&v.driverData.vehicleNo)vals.push(v.driverData.vehicleNo);}
    else if(field==='qaPurpose'&&v.qaRows){v.qaRows.forEach(function(r){if(r.purpose)vals.push(r.purpose);});}
    else if(field==='qaFrom'&&v.qaRows){v.qaRows.forEach(function(r){if(r.from)vals.push(r.from);});}
    else if(field==='qaTo'&&v.qaRows){v.qaRows.forEach(function(r){if(r.to)vals.push(r.to);});}
    else if(field==='qaMode'&&v.qaRows){v.qaRows.forEach(function(r){if(r.mode)vals.push(r.mode);});}
    return vals.filter(function(x){return x&&x.trim();});
}
/* Score field values by recency from vouchers matching BOTH Particulars AND Payee context
   (whichever are provided — empty string means "skip that filter").
   Returns {value: score} — higher = more recently used within that combined context. */
function _getCombinedRecentScores(cp,cy,targetField){
    if((!cp&&!cy)||!targetField)return{};
    var matched=vouchers.filter(function(v){
        if(!v)return false;
        var pm=!cp||(v.particulars||'').trim()===cp.trim();
        var ym=!cy||(v.payee||'').trim()===cy.trim();
        return pm&&ym;
    });
    matched.sort(function(a,b){return(b.billingDate||'').localeCompare(a.billingDate||'');});
    var scores={};var rank=0;
    matched.forEach(function(v){
        var vals=_getVoucherFieldValues(v,targetField);
        vals.forEach(function(val){if(!(val in scores)){scores[val]=Math.max(50,1000-rank*80);rank++;}});
    });
    return scores;
}
function _makeDropdownItem(text,dd,onSelect){
    var d=document.createElement('div');d.className='suggestion-item';d.textContent=text;
    d.onmousedown=function(e){e.preventDefault();var target=dd._inputEl||document.getElementById(dd.id.replace('dropdown-',''));if(target){target.value=text;target.dispatchEvent(new Event('input',{bubbles:true}));}dd.classList.add('hidden');if(onSelect)onSelect(text);};
    return d;
}
function populateDropdown(dd,c,f,onSelect){
    dd.innerHTML='';
    var cp=getCurrentParticularsContext(),cy=getCurrentPayeeContext();
    var a=getMergedSuggestions(c,cp,cy);
    var fl=f?a.filter(function(i){return i.toLowerCase().includes(f.toLowerCase());}):a;
    /* Build the "recent" section using a combined Particulars+Payee filter.
       For the Payee field: filter by Particulars only (Payee is what the user is still typing).
       For all other fields: filter by BOTH Particulars AND Payee (AND condition). */
    var filterCp=(c!=='particulars')?cp:'';
    var filterCy=(c!=='payee'&&c!=='particulars')?cy:'';
    var recentScores=(filterCp||filterCy)?_getCombinedRecentScores(filterCp,filterCy,c):{};
    var recentItems=fl.filter(function(i){return recentScores[i]!==undefined;});
    if(recentItems.length){
        var hdr=document.createElement('div');hdr.className='suggestion-header';hdr.textContent='★ recent';dd.appendChild(hdr);
        var seen={};
        recentItems.forEach(function(i){seen[i]=true;dd.appendChild(_makeDropdownItem(i,dd,onSelect));});
        var rest=fl.filter(function(i){return!seen[i];});
        if(rest.length){var hr=document.createElement('hr');hr.className='suggestion-divider';dd.appendChild(hr);rest.forEach(function(i){dd.appendChild(_makeDropdownItem(i,dd,onSelect));});}
    }else{
        fl.forEach(function(i){dd.appendChild(_makeDropdownItem(i,dd,onSelect));});
    }
    dd.classList.toggle('hidden',fl.length===0);
}
function setupSuggestionInput(id,c,onSelect){var i=document.getElementById(id),dd=document.getElementById('dropdown-'+id);if(!i||!dd)return;i.addEventListener('focus',function(){populateDropdown(dd,c,i.value,onSelect);});i.addEventListener('click',function(){populateDropdown(dd,c,i.value,onSelect);});i.addEventListener('input',function(){populateDropdown(dd,c,i.value,onSelect);if(onSelect)onSelect(i.value);});i.addEventListener('blur',function(){setTimeout(function(){dd.classList.add('hidden');},150);});}
function setupSuggestionElement(inputEl,dd,category,onSelect){
    if(!inputEl||!dd)return;
    dd._inputEl=inputEl;
    inputEl.addEventListener('focus',function(){populateDropdown(dd,category,inputEl.value,onSelect);});
    inputEl.addEventListener('click',function(){populateDropdown(dd,category,inputEl.value,onSelect);});
    inputEl.addEventListener('input',function(){populateDropdown(dd,category,inputEl.value,onSelect);if(onSelect)onSelect(inputEl.value);});
    inputEl.addEventListener('blur',function(){setTimeout(function(){dd.classList.add('hidden');},150);});
}
function addSuggestion(c,v){
    if(!v||!v.trim())return;
    v=v.trim();
    if(!dynamicSuggestions[c])dynamicSuggestions[c]={};
    if(!dynamicSuggestions[c][v])dynamicSuggestions[c][v]=0;
    dynamicSuggestions[c][v]++;
    if(!recentSuggestions[c])recentSuggestions[c]=[];
    recentSuggestions[c]=recentSuggestions[c].filter(function(x){return x!==v;});
    recentSuggestions[c].unshift(v);
    if(recentSuggestions[c].length>20)recentSuggestions[c]=recentSuggestions[c].slice(0,20);
    /* Also store in particularSuggestions for context-aware boosting */
    if(c!=='particulars'){
        var curPart=getCurrentParticularsContext();
        if(curPart){
            if(!particularSuggestions[curPart])particularSuggestions[curPart]={};
            if(!particularSuggestions[curPart][c])particularSuggestions[curPart][c]={};
            particularSuggestions[curPart][c][v]=(particularSuggestions[curPart][c][v]||0)+1;
        }
    }
}
function addSuggestionValue(c,v){
    if(v===null||v===undefined||v==='')return;
    if(!isNaN(Number(v))&&Number(v)===0)return;
    addSuggestion(c,String(v));
}

