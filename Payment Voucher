function saveFieldSugEdit(btn){
    var row=btn.closest('[data-orig]');
    var oldVal=row.dataset.orig;
    var inp=row.querySelector('input.sug-edit-input');
    var newVal=inp?inp.value.trim():'';if(!newVal)return;
    var cat=sugManagerFieldTab;
    if(cat==='details'){
        var p=sugManagerSelectedParticular;
        if(p&&descriptionSuggestions[p]){var cnt=descriptionSuggestions[p][oldVal]||1;delete descriptionSuggestions[p][oldVal];descriptionSuggestions[p][newVal]=cnt;saveData('descriptionSuggestions',descriptionSuggestions);}
    }else{
        var ck=getContextKey(sugManagerSelectedParticular,cat);
        if(!contextualSuggestions[ck])contextualSuggestions[ck]={};
        var cnt2=contextualSuggestions[ck][oldVal]||1;
        delete contextualSuggestions[ck][oldVal];
        contextualSuggestions[ck][newVal]=(contextualSuggestions[ck][newVal]||0)+cnt2;
        saveData('contextualSuggestions',contextualSuggestions);
        /* Also update particularSuggestions if present */
        if(particularSuggestions[sugManagerSelectedParticular]&&particularSuggestions[sugManagerSelectedParticular][cat]&&particularSuggestions[sugManagerSelectedParticular][cat][oldVal]){
            var pc=particularSuggestions[sugManagerSelectedParticular][cat][oldVal];
            delete particularSuggestions[sugManagerSelectedParticular][cat][oldVal];
            particularSuggestions[sugManagerSelectedParticular][cat][newVal]=(particularSuggestions[sugManagerSelectedParticular][cat][newVal]||0)+pc;
            saveData('particularSuggestions',particularSuggestions);
        }
    }
    row.dataset.orig=newVal;
    var listEl=document.getElementById('sugFieldListEl');if(listEl)listEl.innerHTML=_renderFieldSugItems();showToast('Updated!','success');
}
function deleteFieldSug(item){
    var cat=sugManagerFieldTab;
    if(cat==='details'){
        var p=sugManagerSelectedParticular;
        if(p&&descriptionSuggestions[p]){delete descriptionSuggestions[p][item];saveData('descriptionSuggestions',descriptionSuggestions);}
    }else{
        /* Permanently delete: add to blocklist + remove from contextual/particular */
        if(!deletedSuggestions[cat])deletedSuggestions[cat]={};
        deletedSuggestions[cat][item]=true;
        if(!dynamicSuggestions[cat])dynamicSuggestions[cat]={};
        dynamicSuggestions[cat][item]=-9999;
        if(baseSuggestions[cat])delete baseSuggestions[cat][item];
        var ck=getContextKey(sugManagerSelectedParticular,cat);
        if(contextualSuggestions[ck])delete contextualSuggestions[ck][item];
        for(var pp in particularSuggestions){if(particularSuggestions[pp]&&particularSuggestions[pp][cat])delete particularSuggestions[pp][cat][item];}
        saveData('deletedSuggestions',deletedSuggestions);saveData('dynamicSuggestions',dynamicSuggestions);
        saveData('contextualSuggestions',contextualSuggestions);saveData('particularSuggestions',particularSuggestions);
    }
    var listEl=document.getElementById('sugFieldListEl');if(listEl)listEl.innerHTML=_renderFieldSugItems();showToast('Removed!','success');
}
function addNewFieldSuggestion(){
    var inp=document.getElementById('newSugFieldInput');var val=inp?inp.value.trim():'';if(!val)return;
    var cat=sugManagerFieldTab;
    if(cat==='details'){
        var p=sugManagerSelectedParticular;if(!p){showToast('No particular selected','error');return;}
        if(!descriptionSuggestions[p])descriptionSuggestions[p]={};
        descriptionSuggestions[p][val]=(descriptionSuggestions[p][val]||0)+1;saveData('descriptionSuggestions',descriptionSuggestions);
    }else{
        var ck=getContextKey(sugManagerSelectedParticular,cat);
        if(!contextualSuggestions[ck])contextualSuggestions[ck]={};
        contextualSuggestions[ck][val]=(contextualSuggestions[ck][val]||0)+1;
        /* Also store in particularSuggestions */
        var p2=sugManagerSelectedParticular;
        if(p2){if(!particularSuggestions[p2])particularSuggestions[p2]={};if(!particularSuggestions[p2][cat])particularSuggestions[p2][cat]={};particularSuggestions[p2][cat][val]=(particularSuggestions[p2][cat][val]||0)+1;saveData('particularSuggestions',particularSuggestions);}
        /* Remove from deleted if re-adding */
        if(deletedSuggestions[cat]&&deletedSuggestions[cat][val]){delete deletedSuggestions[cat][val];saveData('deletedSuggestions',deletedSuggestions);}
        saveData('contextualSuggestions',contextualSuggestions);
    }
    if(inp)inp.value='';
    var listEl=document.getElementById('sugFieldListEl');if(listEl)listEl.innerHTML=_renderFieldSugItems();showToast('Added!','success');
}
function clearAllFieldSuggestions(){
    if(!confirm('Clear all suggestions for this field?'))return;
    var cat=sugManagerFieldTab;
    if(cat==='details'){
        var p=sugManagerSelectedParticular;if(p&&descriptionSuggestions[p]){descriptionSuggestions[p]={};saveData('descriptionSuggestions',descriptionSuggestions);}
    }else{
        var ck=getContextKey(sugManagerSelectedParticular,cat);
        if(contextualSuggestions[ck]){contextualSuggestions[ck]={};saveData('contextualSuggestions',contextualSuggestions);}
        if(particularSuggestions[sugManagerSelectedParticular]&&particularSuggestions[sugManagerSelectedParticular][cat]){
            particularSuggestions[sugManagerSelectedParticular][cat]={};saveData('particularSuggestions',particularSuggestions);
        }
    }
    var listEl=document.getElementById('sugFieldListEl');if(listEl)listEl.innerHTML=_renderFieldSugItems();showToast('Cleared!','success');
}

