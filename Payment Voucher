function formatDateAny(ds){if(!ds)return'';var mn=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];var m=ds.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);if(m){var d=new Date(parseInt(m[3]),parseInt(m[2])-1,parseInt(m[1]));if(!isNaN(d.getTime()))return d.getDate()+'-'+mn[d.getMonth()]+'-'+d.getFullYear();}var m2=ds.match(/^(\d{4})-(\d{2})-(\d{2})$/);if(m2){var d2=new Date(parseInt(m2[1]),parseInt(m2[2])-1,parseInt(m2[3]));if(!isNaN(d2.getTime()))return d2.getDate()+'-'+mn[d2.getMonth()]+'-'+d2.getFullYear();}return ds;}
