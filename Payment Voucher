/* Ensure every suggestion category always has an entry in dynamicSuggestions.
 * Must be called after any Firebase/localStorage load that may have replaced the
 * object with an older version that doesn't know about newer categories. */
function ensureSuggestionCategories(){
    SUGGESTION_CATEGORIES.forEach(function(c){if(!dynamicSuggestions[c])dynamicSuggestions[c]={};});
}

/* Seed suggestion categories from already-saved vouchers.
 * Safe to call multiple times — only fills in missing entries, never
 * overwrites counts that were already saved by real user submissions. */
function seedSuggestionsFromVouchers(){
    ensureSuggestionCategories();  /* guarantee all keys exist before writing */
    vouchers.forEach(function(v){
        if(!v)return;
        var isQA=isConveyanceQA(v.particulars);
        var isDriver=isDriverConveyance(v.particulars);
        /* Seed QA row fields */
        if(isQA&&v.qaRows){
            v.qaRows.forEach(function(r){
                if(r.purpose&&r.purpose.trim()&&!dynamicSuggestions.qaPurpose[r.purpose.trim()])dynamicSuggestions.qaPurpose[r.purpose.trim()]=1;
                if(r.from&&r.from.trim()&&!dynamicSuggestions.qaFrom[r.from.trim()])dynamicSuggestions.qaFrom[r.from.trim()]=1;
                if(r.to&&r.to.trim()&&!dynamicSuggestions.qaTo[r.to.trim()])dynamicSuggestions.qaTo[r.to.trim()]=1;
                if(r.mode&&r.mode.trim()&&!dynamicSuggestions.qaMode[r.mode.trim()])dynamicSuggestions.qaMode[r.mode.trim()]=1;
            });
        }
        /* Seed driver fields */
        if(isDriver&&v.driverData){
            var dd=v.driverData;
            if(dd.vehicleNo&&dd.vehicleNo.trim()&&!dynamicSuggestions.vehicleNo[dd.vehicleNo.trim()])dynamicSuggestions.vehicleNo[dd.vehicleNo.trim()]=1;
            if(dd.bodyRent&&!dynamicSuggestions.driverBodyRent[String(dd.bodyRent)])dynamicSuggestions.driverBodyRent[String(dd.bodyRent)]=1;
            var _seedKmRows=dd.kmRows||(dd.kmRate?[{kmRate:dd.kmRate}]:[]);_seedKmRows.forEach(function(km){if(km.kmRate&&!dynamicSuggestions.driverKmRate[String(km.kmRate)])dynamicSuggestions.driverKmRate[String(km.kmRate)]=1;});
            if(dd.lunchRate&&!dynamicSuggestions.driverLunchRate[String(dd.lunchRate)])dynamicSuggestions.driverLunchRate[String(dd.lunchRate)]=1;
            if(dd.overtime){
                if(dd.overtime.hours&&!dynamicSuggestions.driverOvertimeHours[String(dd.overtime.hours)])dynamicSuggestions.driverOvertimeHours[String(dd.overtime.hours)]=1;
                if(dd.overtime.rate&&!dynamicSuggestions.driverOvertimeRate[String(dd.overtime.rate)])dynamicSuggestions.driverOvertimeRate[String(dd.overtime.rate)]=1;
            }
            var aps=dd.airportPickups||(dd.airportPickup&&dd.airportPickup.amount>0?[dd.airportPickup]:[]);
            if(aps)aps.forEach(function(a){if(a.amount&&!dynamicSuggestions.driverAirportPickupAmount[String(a.amount)])dynamicSuggestions.driverAirportPickupAmount[String(a.amount)]=1;});
            var ads=dd.airportDrops||(dd.airportDrop&&dd.airportDrop.amount>0?[dd.airportDrop]:[]);
            if(ads)ads.forEach(function(a){if(a.amount&&!dynamicSuggestions.driverAirportDropAmount[String(a.amount)])dynamicSuggestions.driverAirportDropAmount[String(a.amount)]=1;});
            if(dd.tolls)dd.tolls.forEach(function(t){
                if(t.name&&t.name.trim()&&!dynamicSuggestions.driverTollName[t.name.trim()])dynamicSuggestions.driverTollName[t.name.trim()]=1;
                if(t.count&&!dynamicSuggestions.driverTollCount[String(t.count)])dynamicSuggestions.driverTollCount[String(t.count)]=1;
                if(t.rate&&!dynamicSuggestions.driverTollRate[String(t.rate)])dynamicSuggestions.driverTollRate[String(t.rate)]=1;
            });
            if(dd.parkings)dd.parkings.forEach(function(p){
                if(p.name&&p.name.trim()&&!dynamicSuggestions.driverParkingName[p.name.trim()])dynamicSuggestions.driverParkingName[p.name.trim()]=1;
                if(p.count&&!dynamicSuggestions.driverParkingCount[String(p.count)])dynamicSuggestions.driverParkingCount[String(p.count)]=1;
                if(p.rate&&!dynamicSuggestions.driverParkingRate[String(p.rate)])dynamicSuggestions.driverParkingRate[String(p.rate)]=1;
            });
            if(dd.extras){
                dd.extras.forEach(function(e){
                    if(e.description&&e.description.trim()&&!dynamicSuggestions.driverExtraDesc[e.description.trim()])dynamicSuggestions.driverExtraDesc[e.description.trim()]=1;
                });
            }
        }
        /* Seed particulars from every bill type (so any custom particulars is remembered) */
        if(v.particulars&&v.particulars.trim()&&!dynamicSuggestions.particulars[v.particulars.trim()])dynamicSuggestions.particulars[v.particulars.trim()]=1;
        /* Seed payee */
        if(v.payee&&v.payee.trim()&&!dynamicSuggestions.payee[v.payee.trim()])dynamicSuggestions.payee[v.payee.trim()]=1;
        /* Seed paymentMethod */
        if(v.paymentMethod&&v.paymentMethod.trim()&&!dynamicSuggestions.paymentMethod[v.paymentMethod.trim()])dynamicSuggestions.paymentMethod[v.paymentMethod.trim()]=1;
        /* Seed regular conveyance fields */
        var isConv=isConveyanceBill(v.particulars);
        if(isConv){
            ['from','to1','to2','via','by','fromTime','toTime','purpose'].forEach(function(k){
                var val=v[k];if(val&&val.trim()&&!dynamicSuggestions[k][val.trim()])dynamicSuggestions[k][val.trim()]=1;
            });
        }
    });
}

function saveVoucherData(fd){
    var isConveyance=isConveyanceBill(fd.particulars);
    var isQA=isConveyanceQA(fd.particulars);
    var isDriver=isDriverConveyance(fd.particulars);
    addSuggestion('particulars',fd.particulars);addSuggestion('payee',fd.payee);addSuggestion('paymentMethod',fd.paymentMethod);
    /* Store contextual associations for smart suggestions */
    if(fd.particulars){
        ['payee','paymentMethod'].forEach(function(field){if(fd[field])addContextualSuggestion(fd.particulars,field,fd[field]);});
        if(fd.payee){['particulars','paymentMethod','from','to1','purpose'].forEach(function(field){if(fd[field])addContextualSuggestion(fd.payee,field,fd[field]);});}
    }
    if(isConveyance){['from','to1','to2','via','by','fromTime','toTime','purpose'].forEach(function(k){addSuggestion(k,fd[k]);if(fd.particulars&&fd[k])addContextualSuggestion(fd.particulars,k,fd[k]);});}
    /* Save QA row field values as suggestions, also contextually keyed to this particulars */
    if(isQA&&fd.qaRows){
        fd.qaRows.forEach(function(r){
            addSuggestion('qaPurpose',r.purpose);
            addSuggestion('qaFrom',r.from);
            addSuggestion('qaTo',r.to);
            addSuggestion('qaMode',r.mode);
            /* Contextual boost: when user is on this particulars, show these values higher */
            if(fd.particulars){
                if(r.purpose)addContextualSuggestion(fd.particulars,'qaPurpose',r.purpose);
                if(r.from)addContextualSuggestion(fd.particulars,'qaFrom',r.from);
                if(r.to)addContextualSuggestion(fd.particulars,'qaTo',r.to);
                if(r.mode)addContextualSuggestion(fd.particulars,'qaMode',r.mode);
            }
        });
    }
    /* Save driver vehicle number, rates, amounts, tolls, parking, and extra row descriptions as suggestions */
    if(isDriver&&fd.driverData){
        addSuggestion('vehicleNo',fd.driverData.vehicleNo);
        if(fd.particulars&&fd.driverData.vehicleNo)addContextualSuggestion(fd.particulars,'vehicleNo',fd.driverData.vehicleNo);
        addSuggestionValue('driverBodyRent',fd.driverData.bodyRent);
        if(fd.driverData.kmRows)fd.driverData.kmRows.forEach(function(km){addSuggestionValue('driverKmRate',km.kmRate);});
        addSuggestionValue('driverLunchRate',fd.driverData.lunchRate);
        if(fd.driverData.overtime){
            addSuggestionValue('driverOvertimeHours',fd.driverData.overtime.hours);
            addSuggestionValue('driverOvertimeRate',fd.driverData.overtime.rate);
        }
        if(fd.driverData.airportPickups){
            fd.driverData.airportPickups.forEach(function(p){addSuggestionValue('driverAirportPickupAmount',p.amount);if(fd.particulars&&p.amount)addContextualSuggestion(fd.particulars,'driverAirportPickupAmount',String(p.amount));});
        }
        if(fd.driverData.airportDrops){
            fd.driverData.airportDrops.forEach(function(d){addSuggestionValue('driverAirportDropAmount',d.amount);if(fd.particulars&&d.amount)addContextualSuggestion(fd.particulars,'driverAirportDropAmount',String(d.amount));});
        }
        if(fd.driverData.tolls){
            fd.driverData.tolls.forEach(function(t){
                addSuggestion('driverTollName',t.name);
                addSuggestionValue('driverTollCount',t.count);
                addSuggestionValue('driverTollRate',t.rate);
                if(fd.particulars&&t.name)addContextualSuggestion(fd.particulars,'driverTollName',t.name);
                if(fd.particulars&&t.count)addContextualSuggestion(fd.particulars,'driverTollCount',String(t.count));
                if(fd.particulars&&t.rate)addContextualSuggestion(fd.particulars,'driverTollRate',String(t.rate));
            });
        }
        if(fd.driverData.parkings){
            fd.driverData.parkings.forEach(function(p){
                addSuggestion('driverParkingName',p.name);
                addSuggestionValue('driverParkingCount',p.count);
                addSuggestionValue('driverParkingRate',p.rate);
                if(fd.particulars&&p.name)addContextualSuggestion(fd.particulars,'driverParkingName',p.name);
                if(fd.particulars&&p.count)addContextualSuggestion(fd.particulars,'driverParkingCount',String(p.count));
                if(fd.particulars&&p.rate)addContextualSuggestion(fd.particulars,'driverParkingRate',String(p.rate));
            });
        }
        ['driverBodyRent','driverLunchRate','driverOvertimeHours','driverOvertimeRate'].forEach(function(cat){
            var val='';
            if(cat==='driverBodyRent')val=fd.driverData.bodyRent;
            if(cat==='driverLunchRate')val=fd.driverData.lunchRate;
            if(cat==='driverOvertimeHours'&&fd.driverData.overtime)val=fd.driverData.overtime.hours;
            if(cat==='driverOvertimeRate'&&fd.driverData.overtime)val=fd.driverData.overtime.rate;
            if(fd.particulars&&val)addContextualSuggestion(fd.particulars,cat,String(val));
        });
        if(fd.driverData.kmRows)fd.driverData.kmRows.forEach(function(km){if(fd.particulars&&km.kmRate)addContextualSuggestion(fd.particulars,'driverKmRate',String(km.kmRate));});
        if(fd.driverData.extras){
            fd.driverData.extras.forEach(function(e){
                addSuggestion('driverExtraDesc',e.description);
                if(fd.particulars&&e.description)addContextualSuggestion(fd.particulars,'driverExtraDesc',e.description);
            });
        }
    }
    var descToSave=isConveyance?fd.purpose:fd.description;
    if(descToSave){if(!descriptionSuggestions[fd.particulars])descriptionSuggestions[fd.particulars]={};if(!descriptionSuggestions[fd.particulars][descToSave])descriptionSuggestions[fd.particulars][descToSave]=0;descriptionSuggestions[fd.particulars][descToSave]++;}
    if(fd.items)fd.items.forEach(function(item){if(item.description){if(!descriptionSuggestions[fd.particulars])descriptionSuggestions[fd.particulars]={};if(!descriptionSuggestions[fd.particulars][item.description])descriptionSuggestions[fd.particulars][item.description]=0;descriptionSuggestions[fd.particulars][item.description]++;}});
    saveData('descriptionSuggestions',descriptionSuggestions);
    saveData('recentSuggestions',recentSuggestions);
    saveData('contextualSuggestions',contextualSuggestions);
    saveData('dynamicSuggestions',dynamicSuggestions);
    saveData('particularSuggestions',particularSuggestions);
}

