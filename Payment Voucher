function rteExec(cmd,val){
    var d=getRteDoc();if(!d)return;
    /* Save the current selection before calling d.focus() — otherwise the
     * focus call moves the caret to the start of the div and the toolbar
     * command has no text to apply to (especially inside table cells).   */
    var sel=window.getSelection();
    var savedRange=(sel&&sel.rangeCount>0)?sel.getRangeAt(0).cloneRange():null;
    d.focus();
    if(savedRange){try{sel.removeAllRanges();sel.addRange(savedRange);}catch(e){}}
