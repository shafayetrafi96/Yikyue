    function getCreatedAt(v){var id=v._id||'';var m=id.match(/pv_(\d+)_/);if(m)return parseInt(m[1]);var m2=id.match(/^V(\d+)$/);if(m2)return parseInt(m2[1]);var m3=id.match(/(\d{10,})/);if(m3)return parseInt(m3[1]);return 0;}
    /* Month filter (YYYY-MM) applied on billingDate */
    var mf=document.getElementById('monthFilter');var mfVal=mf?mf.value:'';
    var fl=vouchers.filter(function(v){
        if(!isAdmin&&(v.deviceId||'')!==currentDeviceId)return false;
