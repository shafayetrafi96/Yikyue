<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YIK YUE (H.K.) COMMERCIAL LIMITED - Payment Voucher</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect x='18' y='3' width='64' height='94' rx='6' fill='%230A4038'/%3E%3Crect x='24' y='9' width='52' height='82' rx='3' fill='white'/%3E%3Cline x1='32' y1='30' x2='68' y2='30' stroke='%230A4038' stroke-width='3'/%3E%3Cline x1='32' y1='44' x2='68' y2='44' stroke='%230A4038' stroke-width='3'/%3E%3Cline x1='32' y1='58' x2='54' y2='58' stroke='%230A4038' stroke-width='3'/%3E%3C/svg%3E">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>tailwind.config={theme:{extend:{colors:{brand:'#0A4038','brand-dark':'#072e27','brand-light':'#e0efed'}}}}</script>
    <style>
        body{background-color:#f4f6f9;background-image:url('https://www.transparenttextures.com/patterns/cubes.png');background-attachment:fixed}
        ::selection{background-color:#0A4038;color:white}
        .suggestion-dropdown{position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid #cbd5e0;border-top:none;max-height:150px;overflow-y:auto;z-index:50;box-shadow:0 4px 6px -1px rgba(0,0,0,.1);border-radius:0 0 .25rem .25rem}
        .suggestion-item{padding:8px 12px;cursor:pointer;font-size:.875rem;color:#4a5568;white-space:pre-wrap;overflow:hidden;text-overflow:ellipsis}
        .suggestion-item:hover,.suggestion-item:active{background-color:#e0efed;color:#0A4038}
        .suggestion-header{padding:4px 12px 2px;font-size:.7rem;font-weight:700;color:#0A4038;text-transform:uppercase;letter-spacing:.05em;background:#e0efed;border-bottom:1px solid #c2dbd7;cursor:default;}
        .suggestion-divider{border:none;border-top:1px dashed #b2ccc8;margin:2px 0;}
        .toast{position:fixed;bottom:30px;left:50%;transform:translateX(-50%);padding:14px 28px;border-radius:12px;color:#fff;font-weight:600;font-size:14px;z-index:9999;opacity:0;transition:opacity .3s;box-shadow:0 8px 30px rgba(0,0,0,.2);pointer-events:none}
        .toast.show{opacity:1}.toast-success{background:#059669}.toast-error{background:#dc2626}
        input:-webkit-autofill,input:-webkit-autofill:hover,input:-webkit-autofill:focus,input:-webkit-autofill:active{-webkit-box-shadow:0 0 0 30px #fff inset!important;-webkit-text-fill-color:#2d3748!important;transition:background-color 5000s ease-in-out 0s}
        .voucher-doc{font-family:'Calibri',sans-serif;color:#000;width:210mm;margin:0 auto;padding:5mm 10mm;line-height:1.4;position:relative;background-color:#fff;zoom:.56}
        .voucher-header{text-align:center;margin-bottom:4mm}
        .voucher-header .company-name{font-size:20px;font-weight:bold;letter-spacing:1px;margin:0;line-height:1}
        .voucher-header .company-addr{font-size:9px;color:#444;margin:0}
        .voucher-header .header-line{border:none;border-top:2px solid #000;margin:4px 0 0}
        .voucher-body{padding:4mm 5mm}
        .voucher-body .title-row{text-align:center;font-size:16px;font-weight:bold;letter-spacing:2px;margin-bottom:4mm;text-transform:uppercase}
        .voucher-body table{width:100%;border-collapse:collapse;font-size:11px}
        .voucher-body table td{padding:3px 4px;vertical-align:top}
        .voucher-body .sign-table{width:100%;margin-top:12mm;border-collapse:collapse;font-size:10px;table-layout:fixed;}
        .voucher-body .sign-table td{text-align:center;vertical-align:bottom;padding:0 2mm}
        .voucher-body .sign-table .sign-img{display:block;margin:0 auto 3mm auto;object-fit:contain;background:transparent}
        .voucher-body .sign-table .sign-line{border-top:1px solid #000;padding-top:2px;font-weight:bold}
        .pos-dragging{user-select:none!important;-webkit-user-select:none!important}
        .desc-suggestion-dropdown{position:absolute;bottom:100%;top:auto;left:0;right:0;background:#fff;border:1px solid #cbd5e0;border-bottom:none;border-top:1px solid #cbd5e0;max-height:150px;overflow-y:auto;z-index:50;box-shadow:0 -4px 6px -1px rgba(0,0,0,.1);border-radius:.25rem .25rem 0 0}
        .sug-edit-input{border:1px solid #0A4038;border-radius:4px;padding:2px 6px;font-size:13px;outline:none;width:100%}
        .sig-panel{display:none}.sig-panel.active{display:block}
        .sig-main-tab{cursor:pointer;padding:10px 20px;font-weight:600;font-size:14px;border-bottom:3px solid transparent;color:#6b7280;transition:all .2s}
        .sig-main-tab.active{border-bottom-color:#0A4038;color:#0A4038}
        input[type=range]{accent-color:#0A4038}
        input[type=number]::-webkit-inner-spin-button,input[type=number]::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}
        input[type=number]{-moz-appearance:textfield}
        .btn-approve{background:#059669;color:#fff;border:none;padding:3px 10px;border-radius:4px;font-size:11px;font-weight:700;cursor:pointer;transition:.15s}
        .btn-approve:hover{background:#047857}
        .btn-undo{background:#d97706;color:#fff;border:none;padding:3px 10px;border-radius:4px;font-size:11px;font-weight:700;cursor:pointer;transition:.15s}
        .btn-undo:hover{background:#b45309}
        .qa-table-input{width:100%;border:1px solid #d1d5db;border-radius:4px;padding:4px 6px;font-size:12px;outline:none;background:#fff;}
        .qa-table-input:focus{border-color:#0A4038;box-shadow:0 0 0 2px rgba(10,64,56,0.15);}
        .col-resize-handle{position:absolute;top:0;right:0;width:5px;height:100%;cursor:col-resize;background:transparent;z-index:10;transition:background .15s;}
        .col-resize-handle:hover,.col-resize-handle.is-resizing{background:rgba(10,64,56,0.45);}
        .resizable-th{position:relative!important;white-space:nowrap;overflow:visible!important;}
        .resize-info-badge{position:fixed;bottom:70px;left:50%;transform:translateX(-50%);background:#0A4038;color:#fff;padding:5px 14px;border-radius:8px;font-size:12px;font-weight:600;z-index:9998;opacity:0;transition:opacity .3s;pointer-events:none;}
        .resize-info-badge.show{opacity:1;}
        .driver-section-card{background:#f8fffe;border:1px solid #c2deda;border-radius:8px;padding:12px 14px;margin-bottom:12px;}
        .driver-section-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:#0A4038;margin-bottom:8px;}
        .driver-mini-input{width:100%;border:1px solid #d1d5db;border-radius:5px;padding:5px 8px;font-size:13px;outline:none;background:#fff;}
        .driver-mini-input:focus{border-color:#0A4038;box-shadow:0 0 0 2px rgba(10,64,56,0.12);}
        .date-chip{display:inline-flex;align-items:center;background:#e0efed;color:#0A4038;border-radius:20px;padding:2px 8px 2px 10px;font-size:12px;font-weight:600;gap:4px;border:1px solid #b2d6d1;}
        .date-chip button{background:none;border:none;color:#0A4038;cursor:pointer;font-size:10px;padding:0;line-height:1;opacity:.7;}
        .date-chip button:hover{opacity:1;}
        #tollContainer,#parkingContainer,#airportPickupContainer,#airportDropContainer{display:flex;flex-wrap:wrap;align-items:center;gap:4px 2px;}
        .toll-entry,.parking-entry,.airport-pickup-entry,.airport-drop-entry{display:inline-flex;align-items:center;gap:2px;white-space:nowrap;}
        .toll-entry+.toll-entry::before,.parking-entry+.parking-entry::before,.airport-pickup-entry+.airport-pickup-entry::before,.airport-drop-entry+.airport-drop-entry::before{content:', ';display:inline;color:#9ca3af;font-size:12px;margin-right:2px;}
        /* admin-view-mode header/sign hiding removed — full voucher visible for all */
        /* ===== Word-like Editing Toolbar ===== */
        .word-toolbar{background:#f0f4f8;border:1px solid #cbd5e0;border-radius:6px;padding:6px 10px;margin-bottom:8px;display:flex;flex-wrap:wrap;gap:4px;align-items:center;}
        .word-toolbar-btn{border:1px solid #cbd5e0;background:#fff;border-radius:4px;padding:3px 8px;font-size:12px;cursor:pointer;color:#374151;transition:all .15s;display:inline-flex;align-items:center;gap:3px;}
        .word-toolbar-btn:hover{background:#e0efed;border-color:#0A4038;color:#0A4038;}
        .word-toolbar-btn.active{background:#0A4038;color:#fff;border-color:#0A4038;}
        .word-toolbar-sep{width:1px;height:20px;background:#cbd5e0;margin:0 2px;}
        .rte-editable{outline:none;cursor:text;}
        .rte-editable:focus-within{outline:2px solid rgba(10,64,56,0.15);border-radius:2px;}
        #wordToolbarInner{user-select:none;-webkit-user-select:none;}
        kbd{font-family:monospace;font-size:10px;background:#e5e7eb;border:1px solid #d1d5db;border-radius:3px;padding:1px 5px;}
        /* Suggestion context badge */
        .sug-context-badge{display:inline-block;background:#e0efed;color:#0A4038;border-radius:10px;padding:1px 7px;font-size:10px;font-weight:600;margin-left:4px;}
        @keyframes rowFlash{0%{background-color:#fef9c3;}100%{background-color:transparent;}}
        .row-flash{animation:rowFlash 10s ease-out forwards;}
        /* ===== Detail Modal: offset for Google Sites nav bar ===== */
        /* ===== Detail Modal Fullscreen Mode ===== */
        #detailModalInner.detail-fullscreen{position:fixed!important;inset:0!important;z-index:300!important;max-width:none!important;width:100%!important;height:100%!important;margin:0!important;overflow:hidden!important;border-radius:0!important;}
        #detailModalInner.detail-fullscreen #detailContent{max-height:none!important;overflow-y:auto!important;}
        #detailModalInner.detail-fullscreen .voucher-doc{zoom:1!important;}
        #detailViewFullscreenBtn{display:none;}
        #detailModal{padding-top:8px;padding-bottom:18px;}
        /* Modal fits viewport; only detailContent scrolls */
        #detailModalInner{max-height:calc(100vh - 38px);display:flex;flex-direction:column;}
        #detailModalInner>.flex{overflow:hidden;min-height:0;}
        #detailContent{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;}
        /* Fullscreen overrides */
        #detailModalInner.detail-fullscreen{max-height:100vh!important;}
        #detailModalInner.detail-fullscreen #detailContent{flex:1!important;min-height:0!important;overflow-y:auto!important;overflow-x:hidden!important;}
        #detailModalInner.detail-fullscreen #detailTitleBar{border-radius:0;}
        /* ===== Form Fullscreen Mode ===== */
        #formSection.form-fullscreen{position:fixed!important;inset:0!important;z-index:200!important;overflow-y:auto!important;background:#fff!important;padding:28px 36px!important;margin:0!important;border-radius:0!important;zoom:1.25!important;max-width:none!important;width:100%!important;height:100%!important;box-sizing:border-box!important;}
        #formFullscreenBtn{display:none;}
    </style>
</head>
<body class="text-gray-800 font-sans">
    <div id="toastContainer" class="toast"></div>
    <div id="resizeBadge" class="resize-info-badge"></div>
    <!-- Admin Modal -->
    <div id="adminModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-[100] flex justify-center items-center">
        <div class="bg-white p-6 rounded-lg shadow-xl w-80 z-[101]">
            <h3 class="text-lg font-bold mb-4 text-brand-dark">Admin Login</h3>
            <input type="password" id="adminPassInput" autocomplete="off" class="w-full border border-gray-300 rounded p-2 mb-2" placeholder="Enter Password" onkeypress="if(event.key==='Enter')submitAdminLogin()">
            <p id="adminError" class="text-red-500 text-sm mb-4 hidden">Incorrect Password!</p>
            <div class="flex justify-end space-x-2">
                <button onclick="closeAdminModal()" class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400 font-medium">Cancel</button>
                <button onclick="submitAdminLogin()" class="px-4 py-2 bg-brand text-white rounded hover:bg-brand-dark font-medium">Login</button>
            </div>
        </div>
    </div>

    <input type="file" id="signUploadInput" accept="image/*" class="hidden" onchange="handleSignUpload(event)">

    <!-- Signature Manager Modal -->
    <div id="signatureModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-[100] flex justify-center items-center p-4">
        <div class="bg-white rounded-lg shadow-2xl w-full max-w-4xl max-h-[90vh] flex flex-col z-[101]">
            <div class="p-4 border-b flex justify-between items-center bg-brand text-white rounded-t-lg shrink-0">
                <h3 class="text-lg font-bold"><i class="fas fa-signature mr-2"></i>Upload Signatures</h3>
                <button onclick="closeSignatureManager()" class="text-white hover:text-gray-300 text-xl"><i class="fas fa-times"></i></button>
            </div>
            <div class="flex border-b bg-gray-50 px-4 pt-2 overflow-x-auto shrink-0">
                <button onclick="switchSignTab('preparedBy')" class="sig-tab-btn px-4 py-2 font-medium text-sm border-b-2 border-brand text-brand" data-tab="preparedBy">Prepared By</button>
                <button onclick="switchSignTab('adminOfficer')" class="sig-tab-btn px-4 py-2 font-medium text-sm border-b-2 border-transparent text-gray-500" data-tab="adminOfficer">Accounts/Admin</button>
                <button onclick="switchSignTab('approvedBy')" class="sig-tab-btn px-4 py-2 font-medium text-sm border-b-2 border-transparent text-gray-500" data-tab="approvedBy">Approved By</button>
                <button onclick="switchSignTab('receivedBy')" class="sig-tab-btn px-4 py-2 font-medium text-sm border-b-2 border-transparent text-gray-500" data-tab="receivedBy">Received By</button>
            </div>
            <div class="p-6 overflow-y-auto flex-1 bg-white">
                <div class="flex mb-6 gap-2">
                    <input type="text" id="newSignNameInput" autocomplete="off" class="flex-1 border border-gray-300 rounded p-2" placeholder="Signatory Name...">
                    <button onclick="document.getElementById('signUploadInput').click()" class="bg-brand text-white px-4 py-2 rounded hover:bg-brand-dark font-medium"><i class="fas fa-upload mr-1"></i>Upload Image</button>
                </div>
                <div id="signList" class="grid grid-cols-2 md:grid-cols-3 gap-4"></div>
            </div>
        </div>
    </div>

    <!-- Position & Size Modal -->
    <div id="positionModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-[100] flex justify-center items-center p-4">
        <div class="bg-white rounded-lg shadow-2xl w-full max-w-5xl max-h-[90vh] flex flex-col z-[101]">
            <div class="p-4 border-b flex justify-between items-center bg-brand text-white rounded-t-lg shrink-0">
                <h3 class="text-lg font-bold"><i class="fas fa-arrows-alt mr-2"></i>Position &amp; Size Signatures</h3>
                <button onclick="closePositionModal()" class="text-white hover:text-gray-300 text-xl"><i class="fas fa-times"></i></button>
            </div>
            <div class="p-4 overflow-y-auto flex-1 bg-gray-100">
                <p class="text-sm text-gray-500 mb-3"><i class="fas fa-info-circle mr-1 text-brand"></i>Drag signatures to adjust position.</p>
                <div id="positionContent" class="flex justify-center"></div>
                <div id="positionControls" class="mt-4 max-w-5xl mx-auto"></div>
            </div>
        </div>
    </div>

    <!-- Signature Selection Modal -->
    <div id="signSelectionModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-[100] flex justify-center items-center p-4">
        <div class="bg-white rounded-lg shadow-2xl w-full max-w-2xl max-h-[90vh] flex flex-col z-[101]">
            <div class="p-4 border-b flex justify-between items-center bg-brand text-white rounded-t-lg shrink-0">
                <h3 class="text-lg font-bold"><i class="fas fa-pen-nib mr-2"></i>Signature Selection</h3>
                <button onclick="closeSignSelectionModal()" class="text-white hover:text-gray-300 text-xl"><i class="fas fa-times"></i></button>
            </div>
            <div class="p-6 overflow-y-auto flex-1 bg-white">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="signSelectionGrid"></div>
            </div>
            <div class="p-4 border-t bg-gray-50 flex justify-end rounded-b-lg">
                <button onclick="closeSignSelectionModal()" class="px-5 py-2 bg-brand text-white rounded hover:bg-brand-dark font-bold">Done</button>
            </div>
        </div>
    </div>

    <!-- Suggestions Modal -->
    <div id="suggestionsModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-[100] flex justify-center items-center p-4">
        <div class="bg-white rounded-lg shadow-2xl w-full max-w-2xl max-h-[90vh] flex flex-col z-[101]">
            <div class="p-4 border-b flex justify-between items-center bg-brand text-white rounded-t-lg shrink-0">
                <h3 class="text-lg font-bold" id="sugModalTitle"><i class="fas fa-list-alt mr-2"></i>Manage Suggestions</h3>
                <button onclick="closeSuggestionsManager()" class="text-white hover:text-gray-300 text-xl"><i class="fas fa-times"></i></button>
            </div>
            <div id="sugModalBody" class="flex-1 overflow-y-auto bg-white p-6"></div>
        </div>
    </div>


    <!-- ===== Name & Address Modal ===== -->
    <div id="nameAddressModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-[100] flex justify-center items-center p-4" onclick="closeNameAddressModal()">
        <div class="bg-white rounded-lg shadow-2xl w-full max-w-lg z-[101]" onclick="event.stopPropagation()">
            <div class="p-4 border-b flex justify-between items-center bg-brand text-white rounded-t-lg">
                <h3 class="text-lg font-bold"><i class="fas fa-building mr-2"></i>Name &amp; Address</h3>
                <button onclick="closeNameAddressModal()" class="text-white hover:text-gray-300 text-xl"><i class="fas fa-times"></i></button>
            </div>
            <div class="p-6">
                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Company Name</label>
                    <input type="text" id="naNameInput" class="w-full border border-gray-300 rounded p-2 text-sm focus:ring-2 focus:ring-brand focus:border-brand outline-none" placeholder="Company Name">
                </div>
                <div class="mb-6">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Address</label>
                    <textarea id="naAddressInput" rows="3" class="w-full border border-gray-300 rounded p-2 text-sm focus:ring-2 focus:ring-brand focus:border-brand outline-none resize-none" placeholder="Full Address"></textarea>
                </div>
                <div id="naPrevInfo" class="mb-4 p-3 bg-gray-50 border border-gray-200 rounded text-xs text-gray-500 hidden">
                    <p class="font-semibold text-gray-600 mb-1"><i class="fas fa-history mr-1"></i>Previous Version:</p>
                    <p id="naPrevName" class="truncate"></p>
                    <p id="naPrevAddr" class="truncate"></p>
                </div>
                <div class="flex justify-between items-center gap-2">
                    <button id="naRestoreBtn" onclick="restoreNameAddress()" class="px-4 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600 font-medium text-sm"><i class="fas fa-undo mr-1"></i>Restore Previous</button>
                    <div class="flex gap-2 ml-auto">
                        <button onclick="closeNameAddressModal()" class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400 font-medium text-sm">Cancel</button>
                        <button onclick="saveNameAddress()" class="px-4 py-2 bg-brand text-white rounded hover:bg-brand-dark font-medium text-sm"><i class="fas fa-save mr-1"></i>Save</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== Server Settings Modal ===== -->
    <div id="serverModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-[100] flex justify-center items-center p-4" onclick="closeServerModal()">
        <div class="bg-white rounded-lg shadow-2xl w-full max-w-xl z-[101]" onclick="event.stopPropagation()">
            <div class="p-4 border-b flex justify-between items-center bg-brand text-white rounded-t-lg">
                <h3 class="text-lg font-bold"><i class="fas fa-server mr-2"></i>Server Settings</h3>
                <button onclick="closeServerModal()" class="text-white hover:text-gray-300 text-xl"><i class="fas fa-times"></i></button>
            </div>
            <div class="p-6">
                <p class="text-xs text-gray-500 mb-4 bg-yellow-50 border border-yellow-200 rounded p-2"><i class="fas fa-info-circle mr-1 text-yellow-600"></i>Changes take effect after saving and reloading the page.</p>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Firebase Config (JSON)</label>
                    <textarea id="srv_configJson" rows="10" spellcheck="false" class="w-full border border-gray-300 rounded p-2 text-xs font-mono focus:ring-2 focus:ring-brand outline-none resize-none"></textarea>
                </div>
                <div id="srvPrevInfo" class="mt-4 p-3 bg-gray-50 border border-gray-200 rounded text-xs text-gray-500 hidden">
                    <p class="font-semibold text-gray-600 mb-1"><i class="fas fa-history mr-1"></i>Previous Version saved &mdash; restore available.</p>
                </div>
                <div class="flex justify-between items-center gap-2 mt-4">
                    <button id="srvRestoreBtn" onclick="restoreServerConfig()" class="px-4 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600 font-medium text-sm disabled:opacity-40 disabled:cursor-not-allowed"><i class="fas fa-undo mr-1"></i>Restore to Previous Version</button>
                    <div class="flex gap-2 ml-auto">
                        <button onclick="closeServerModal()" class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400 font-medium text-sm">Cancel</button>
                        <button onclick="saveServerConfig()" class="px-4 py-2 bg-brand text-white rounded hover:bg-brand-dark font-medium text-sm"><i class="fas fa-save mr-1"></i>Save &amp; Reload</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Detail / View Modal -->
    <div id="detailModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-[100] flex justify-center items-center p-1 overflow-hidden">
        <div id="detailModalInner" class="bg-white rounded-lg shadow-2xl w-full max-w-5xl my-1 z-[101] flex flex-col" onclick="event.stopPropagation()">
            <!-- ── Windows-style Title Bar ── -->
            <div id="detailTitleBar" style="background:#0A4038;color:#fff;display:flex;align-items:stretch;justify-content:space-between;padding-left:14px;border-radius:8px 8px 0 0;flex-shrink:0;height:38px;">
