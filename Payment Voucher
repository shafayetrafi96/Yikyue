        if(v.status==='Pending'||isAdmin)ah+='<button onclick="event.stopPropagation();editVoucherDirect(\''+v._id+'\')" class="text-yellow-500 hover:text-yellow-700 mr-1"><i class="fas fa-pen"></i></button>';
        if(isAdmin){if(v.status==='Pending')ah+='<button onclick="event.stopPropagation();quickApprove(\''+v._id+'\')" class="btn-approve mr-1"><i class="fas fa-check mr-1"></i>Approve</button>';else ah+='<button onclick="event.stopPropagation();quickUndo(\''+v._id+'\')" class="btn-undo mr-1"><i class="fas fa-undo mr-1"></i>Undo</button>';ah+='<button onclick="event.stopPropagation();copyVoucher(\''+v._id+'\')" class="text-blue-400 hover:text-blue-600 mr-1"><i class="fas fa-copy"></i></button>';ah+='<button onclick="event.stopPropagation();deleteVoucher(\''+v._id+'\',event)" class="text-red-500 hover:text-red-700"><i class="fas fa-trash"></i></button>';}
        var sc=v.status==='Approved'?'bg-green-100 text-green-800':'bg-yellow-100 text-yellow-800';
        var detailsText='';
        if(isConveyanceQA(v.particulars)){detailsText=v.qaRows&&v.qaRows.length?v.qaRows.length+' row(s)':'';}
        else if(isDriverConveyance(v.particulars)){var dd=v.driverData;if(dd){detailsText=(dd.dates&&dd.dates.length?dd.dates.length+' day(s)':'')+(dd.vehicleNo?' · '+dd.vehicleNo:'');}}
        else if(isConveyanceBill(v.particulars)){detailsText=escapeHtml(v.purpose||'');}
        else{detailsText=escapeHtml(v.description||'');}
        var _cbTd=isAdmin?'<td class="py-3 px-4"><input type="checkbox" class="row-check" data-id="'+v._id+'"></td>':'';tr.innerHTML=_cbTd+'<td class="py-3 px-4">'+(idx+1)+'</td><td class="py-3 px-4 whitespace-nowrap">'+formatDateDisplay(v.billingDate)+'</td><td class="py-3 px-4 font-medium">'+escapeHtml(v.payee)+'</td><td class="py-3 px-4 text-xs truncate max-w-xs">'+escapeHtml(v.particulars)+'</td><td class="py-3 px-4 text-xs truncate max-w-xs">'+detailsText+'</td><td class="py-3 px-4 font-medium">BDT '+Number(v.amount).toLocaleString('en-US',{minimumFractionDigits:2})+'</td><td class="py-3 px-4"><span class="px-2 py-1 rounded text-xs font-bold '+sc+'">'+v.status+'</span></td><td class="py-3 px-4 whitespace-nowrap">'+ah+'</td>';
        tb.appendChild(tr);
    });
