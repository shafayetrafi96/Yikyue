function _getFieldItems(fieldKey){
    if(fieldKey==='details'){
        var p=sugManagerSelectedParticular;
        if(!p||!descriptionSuggestions[p])return[];
        return Object.entries(descriptionSuggestions[p]).filter(function(i){return i[1]>0;}).sort(function(a,b){return b[1]-a[1];}).map(function(i){return i[0];});
    }
    var ck=getContextKey(sugManagerSelectedParticular,fieldKey);
    var cs=contextualSuggestions[ck]||{};
    /* Also merge in particularSuggestions for this particular+field */
    var ps=(particularSuggestions[sugManagerSelectedParticular]&&particularSuggestions[sugManagerSelectedParticular][fieldKey])||{};
    var merged={};
    for(var k in cs)if((cs[k]||0)>0)merged[k]=(merged[k]||0)+cs[k];
    for(var k in ps)if((ps[k]||0)>0)merged[k]=(merged[k]||0)+ps[k];
    var delG=deletedSuggestions[fieldKey]||{};
    var items=Object.keys(merged).filter(function(k){return(merged[k]||0)>0&&!delG[k];});
    items.sort(function(a,b){return(merged[b]||0)-(merged[a]||0);});
    return items;
}
function _renderFieldSugItems(){
    var items=_getFieldItems(sugManagerFieldTab);
