/* ===== Quick Approve / Undo ===== */
function quickApprove(id){
    var v=vouchers.find(function(x){return x._id===id;});if(!v)return;
    v.status='Approved';
    /*
     * Signature resolution on approve (no auto-fallback):
     *   ''  / undefined / '__none__' = no signature → leave blank
     *   'SomeName'                   = admin explicitly chose that sig → use it
     * Only a signature that was explicitly selected via the Selection modal will appear.
     * Unconfigured fields (empty string) are treated the same as None — blank.
     */
    var roles=['preparedBy','adminOfficer','approvedBy','receivedBy'];
    var sigs={};
    roles.forEach(function(r){
        var sel=signatureSelection[r];
        if(sel && sel!=='__none__'){
            sigs[r]=sel;   /* explicitly chosen sig → use it */
        }else{
            sigs[r]='';    /* None, unconfigured, or blank → no signature */
        }
    });
    v.signatures=sigs;
    commitAction();
    showToast('Approved!','success');
    viewVoucher(id);
}
function quickUndo(id){var v=vouchers.find(function(x){return x._id===id;});if(!v)return;v.status='Pending';v.signatures={preparedBy:'',adminOfficer:'',approvedBy:'',receivedBy:''};commitAction();showToast('Reverted!','success');if(currentViewId===id)viewVoucher(id);}

