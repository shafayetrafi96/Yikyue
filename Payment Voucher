    try{
        var sel2=window.getSelection();
        if(sel2&&sel2.rangeCount>0){
            var _node=sel2.getRangeAt(0).startContainer;
            while(_node&&_node.nodeType===3)_node=_node.parentNode;
            var _d=getRteDoc();
            if(_node&&_d&&_d.contains(_node)){
                var _pxRaw=parseInt(window.getComputedStyle(_node).fontSize);
                if(_pxRaw){
                    var szSel=document.getElementById('rteFontSize');
                    if(szSel){
                        /* Try exact match first, then closest */
                        var _matched=false;
                        for(var _i=0;_i<szSel.options.length;_i++){if(parseInt(szSel.options[_i].value)===_pxRaw){szSel.selectedIndex=_i;_matched=true;break;}}
                        if(!_matched)szSel.value=_closestFontSizeOption(_pxRaw);
                    }
