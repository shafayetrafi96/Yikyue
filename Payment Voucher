/* ===== Month Filter Populate ===== */
function populateMonthFilter(){
    var select=document.getElementById('monthFilter');if(!select)return;
    var months=new Set();var now=new Date();
    var currentMonthKey=now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0');
    months.add(currentMonthKey);
    vouchers.forEach(function(v){
        if(v.billingDate&&typeof v.billingDate==='string'&&v.billingDate.length>=7){
            var parts=v.billingDate.split('-');
            if(parts.length>=2){var key=parts[0]+'-'+parts[1];if(parseInt(parts[0])>2000)months.add(key);}
        }
    });
    var sorted=Array.from(months).sort().reverse();
    var cur=select.value;
    select.innerHTML='<option value="all">All Months</option>';
    sorted.forEach(function(m){
        var opt=document.createElement('option');opt.value=m;
        opt.textContent=new Date(m+'-02').toLocaleDateString('en-US',{year:'numeric',month:'long'});
        select.appendChild(opt);
    });
    if(select.querySelector('option[value="'+currentMonthKey+'"]'))select.value=currentMonthKey;
    else if(cur&&select.querySelector('option[value="'+cur+'"]'))select.value=cur;
    else select.value='all';
}
