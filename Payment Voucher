function startSigDrag(e,role){
    e.preventDefault();e.stopPropagation();
    currentDragRole=role;dragStartX=e.clientX;dragStartY=e.clientY;
    dragOrigX=(signaturePositions[role]||{x:0}).x;dragOrigY=(signaturePositions[role]||{y:0}).y;
    document.body.classList.add('pos-dragging');
    document.addEventListener('mousemove',onSigDrag,{passive:false});
    document.addEventListener('mouseup',endSigDrag);
}
function onSigDrag(e){
    if(!currentDragRole)return;
    var dx=(e.clientX-dragStartX)/POSITION_SCALE,dy=(e.clientY-dragStartY)/POSITION_SCALE;
    var nx=Math.round(dragOrigX+dx),ny=Math.round(dragOrigY+dy);
    if(!signaturePositions[currentDragRole])signaturePositions[currentDragRole]={x:0,y:0};
    signaturePositions[currentDragRole].x=nx;signaturePositions[currentDragRole].y=ny;
    var img=document.getElementById('posImg_'+currentDragRole);
    if(img){img.style.transform='translate('+nx+'px,'+ny+'px)';img.style.transition='none';}
    var xi=document.getElementById('posX_'+currentDragRole);if(xi)xi.value=nx;
    var yi=document.getElementById('posY_'+currentDragRole);if(yi)yi.value=ny;
}
function endSigDrag(){
    if(currentDragRole){saveData('signaturePositions',signaturePositions);showToast('Position saved','success');}
    currentDragRole=null;document.body.classList.remove('pos-dragging');
    document.removeEventListener('mousemove',onSigDrag);document.removeEventListener('mouseup',endSigDrag);
}
