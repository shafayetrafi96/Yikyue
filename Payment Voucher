    document.getElementById('entryPaymentMethod').value=v.paymentMethod;
    document.getElementById('itemsListContainer').innerHTML='';itemCounter=0;
    document.getElementById('qaRowsContainer').innerHTML='';qaRowCounter=0;
    if(isConveyanceQA(v.particulars)){if(v.qaRows&&v.qaRows.length>0){v.qaRows.forEach(function(r){addQARow(r.date,r.purpose,r.from,r.to,r.mode,r.amount);});}else{for(var i=0;i<7;i++){addQARow();}}}
