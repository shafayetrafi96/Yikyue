function getSignImg(role,name){
    if(!name)return'';
    /* Firebase round-trip converts arrays to numeric-keyed objects — normalise back */
    var raw=signatures[role];
    var list=Array.isArray(raw)?raw:(raw?Object.values(raw).filter(Boolean):[]);
    var sig=list.find(function(s){return s.name===name;});
    if(!sig||!sig.data)return'';
    var sz=signatureSizes[role]||12;
    var pos=signaturePositions[role]||{x:0,y:0};
    var ts=(pos.x!==0||pos.y!==0)?'transform:translate('+pos.x+'px,'+pos.y+'px);':'';
    return '<img src="'+sig.data+'" class="sign-img" alt="" style="max-height:'+sz+'mm;max-width:90%;display:block;margin:0 auto 3mm auto;object-fit:contain;background:transparent;'+ts+'">';
}

/* Re-inject the live payee name — safety net for legacy per-voucher PDF saves. */
function injectPayee(docEl,v){
    var tds=docEl.querySelectorAll('td');
    for(var i=0;i<tds.length;i++){
        if(tds[i].textContent.trim()==='Payee:'){
            var next=tds[i].nextElementSibling;
            if(next){next.textContent=v.payee||'';}
            break;
        }
    }
}

/* Selective data injection — only updates [data-field] spans and [data-dynamic]
 * tbody sections, leaving ALL other admin-edited content (table headers, label
 * text, spacing, fonts, TOTAL text, sign labels, etc.) exactly as-is. */
function injectVoucherData(docEl,v){
    /* ── Legacy-template detection ─────────────────────────────────────────
     * Templates saved before the current format may have no [data-field]
     * spans at all, or may use old [data-dynamic] names that no longer exist
     * in generatePrintHTML (e.g. "conveyanceRows", "descRows" that once
     * wrapped the entire body including static labels).  When detected, fall
     * back to a full fresh-generate so the bill always shows correct data.
     * The admin's structural edits from old-format saves are lost, but those
     * saves were based on broken templates anyway.  New saves will use the
     * correct format going forward.                                         */
    var hasDataFields=docEl.querySelectorAll('[data-field]').length>0;
    var hasLegacyDynamic=!!(docEl.querySelector('[data-dynamic="conveyanceRows"],[data-dynamic="descRows"]'));
    if(!hasDataFields||hasLegacyDynamic){
        var freshDiv=document.createElement('div');
        freshDiv.innerHTML=generatePrintHTML(v);
        var freshDoc=freshDiv.querySelector('.voucher-doc');
        if(freshDoc)docEl.innerHTML=freshDoc.innerHTML;
        return;
    }
    /* ── Step 1: re-populate [data-field] spans from current voucher ─────── */
    var af='BDT '+Number(v.amount).toLocaleString('en-US',{minimumFractionDigits:2});
    var aw=v.amount>0?numberToWords(v.amount)+' taka only.':'Zero taka only.';
    var itemsTotal=(v.items||[]).reduce(function(s,i){return s+(i.amount||0);},0);
    var mainAmt=v.amount-itemsTotal;
    var mainAmtStr=mainAmt>0?'BDT '+Number(mainAmt).toLocaleString('en-US',{minimumFractionDigits:2}):'';
    var fieldMap={
        payee:escapeHtml(v.payee||''),
        date:formatDateDisplay(v.billingDate),
        total:af,
        amtWords:escapeHtml(aw),
        payMethod:escapeHtml(v.paymentMethod||''),
        particulars:escapeHtml(v.particulars||''),
        vehicleNo:escapeHtml((v.driverData&&v.driverData.vehicleNo)||''),
        purpose:escapeHtml(v.purpose||''),
        description:escapeHtml(v.description||''),
        tripDesc:escapeHtml(buildDescriptionText(v)),
        mainAmount:mainAmtStr
    };
    docEl.querySelectorAll('[data-field]').forEach(function(el){
        var key=el.getAttribute('data-field');
        if(key in fieldMap)el.innerHTML=fieldMap[key];
    });
    /* ── Step 2: regenerate [data-dynamic] tbodies from current voucher ─── */
    var tmp=document.createElement('div');
    tmp.innerHTML=generatePrintHTML(v);
    docEl.querySelectorAll('[data-dynamic]').forEach(function(dyEl){
        var type=dyEl.getAttribute('data-dynamic');
        var freshDy=tmp.querySelector('[data-dynamic="'+type+'"]');
        if(freshDy){dyEl.innerHTML=freshDy.innerHTML;applyDynamicRowTemplates(dyEl);}
    });
}

/* Re-inject signatures into a rendered voucher-doc element.
 * Called after loadRteSavedContent overwrites the DOM with old HTML.
 * Gated on v.status so Pending bills always show blank sign lines. */
function injectSignatures(docEl,v){
    var st=docEl.querySelector('.sign-table');if(!st)return;
    var pf=printFontSizes;var bf=voucherBoldFields;
    var vsigs=(v.status==='Approved')?(v.signatures||{}):{};  /* status-gated */
    var showReceived=v.includeReceivedBy!==false;
    var w=showReceived?'25%':'33.33%';
    var h='<tr>';
    h+='<td style="width:'+w+'">'+getSignImg('preparedBy',vsigs.preparedBy||'')+'<div class="sign-line" style="font-size:'+pf.signLabel+'px;font-weight:'+fw(bf.signLabel)+'">Prepared by</div></td>';
    h+='<td style="width:'+w+'">'+getSignImg('adminOfficer',vsigs.adminOfficer||'')+'<div class="sign-line" style="font-size:'+pf.signLabel+'px;font-weight:'+fw(bf.signLabel)+'">Accounts/Admin Officer</div></td>';
    h+='<td style="width:'+w+'">'+getSignImg('approvedBy',vsigs.approvedBy||'')+'<div class="sign-line" style="font-size:'+pf.signLabel+'px;font-weight:'+fw(bf.signLabel)+'">Approved by</div></td>';
    if(showReceived)h+='<td style="width:'+w+'">'+getSignImg('receivedBy',vsigs.receivedBy||'')+'<div class="sign-line" style="font-size:'+pf.signLabel+'px;font-weight:'+fw(bf.signLabel)+'">Received by</div></td>';
    h+='</tr>';
    st.innerHTML=h;
}

