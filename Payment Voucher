/* Return saved RTE html for a voucher (if admin edited it), otherwise null */
function getRteSavedHTML(v){
    try{var fbTypeKey=encodeFBKey(getLayoutKey(v.particulars));if(rteDefaults&&rteDefaults[fbTypeKey]){var pt1=decodeFromFB(rteDefaults[fbTypeKey]);if(pt1&&pt1.html)return pt1.html;}}catch(e){}
    try{var rt1=localStorage.getItem(getRteTypeKey(v.particulars));if(rt1){var pt2=JSON.parse(rt1);if(pt2&&pt2.html)return pt2.html;}}catch(e){}
    /* Only per-voucher explicit saves are used for PDF/print — these are the admin's
     * intentional layout edits for this specific bill.
     * Type-level defaults are never used as a data source for PDF. */
    /* 1. Per-voucher Firebase */
    try{var fbBillKey=encodeFBKey(v._id);if(rteBills&&rteBills[fbBillKey]){var pf1=decodeFromFB(rteBills[fbBillKey]);if(pf1&&pf1.html)return pf1.html;}}catch(e){}
    /* 2. Per-voucher localStorage */
    try{var r1=localStorage.getItem('rte_bill_'+v._id);if(r1){var p1=JSON.parse(r1);if(p1&&p1.html)return p1.html;}}catch(e){}
    return null;
}

